@page "/backups"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Backups – backdafuckup</PageTitle>
<PageHeader Title="Backups &amp; Restore" Description="The restore points of each VM. Restore the whole VM, single files or SQL Server databases from any of them." />

@if (_points is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_points.Count == 0)
{
    <MudAlert Severity="Severity.Info">No restore points yet.</MudAlert>
}
else
{
    <MudTextField @bind-Value="_filter" Placeholder="Filter by VM or job" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Style="max-width:400px" />
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var vm in _points.Where(Matches).GroupBy(p => (p.VmNativeId, p.VmName)).OrderBy(g => g.Key.VmName))
        {
            var latest = vm.OrderByDescending(p => p.CreatedUtc).First();
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center flex-wrap" style="gap:4px 12px">
                        <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600">@vm.Key.VmName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@vm.Count() restore point(s) · latest @Fmt.Time(latest.CreatedUtc) · job @latest.JobName</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="cq">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead><tr><th>Created</th><th class="c-560">Type</th><th class="c-420">Consistency</th><th class="c-760 num">Disks</th><th class="c-560 num">New data</th><th class="c-950">Job</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in vm.OrderByDescending(p => p.CreatedUtc))
                            {
                                <tr>
                                    <td class="nowrap-wide">@Fmt.Time(p.CreatedUtc)</td>
                                    <td class="c-560">@p.Kind</td>
                                    <td class="c-420">
                                        @if (p.Consistency == "application")
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Icon="@Icons.Material.Filled.VerifiedUser">application</MudChip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@(p.ConsistencyReason ?? "Without guest processing: like a power failure; most applications recover by themselves.")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(p.ConsistencyReason is null ? Color.Default : Color.Warning)">crash</MudChip>
                                            </MudTooltip>
                                        }
                                        @if (p.SqlDatabaseCount > 0)
                                        {
                                            <MudTooltip Text="@($"{p.SqlDatabaseCount} SQL Server database(s) in this restore point")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Material.Filled.TableChart">SQL @p.SqlDatabaseCount</MudChip>
                                            </MudTooltip>
                                        }
                                    </td>
                                    <td class="c-760 num">@p.Disks.Count (@Fmt.Bytes(p.LogicalBytes))</td>
                                    <td class="c-560 num">@Fmt.Bytes(p.NewStoredBytes)</td>
                                    <td class="c-950">@p.JobName</td>
                                    <td style="text-align:right;white-space:nowrap">
                                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                                            <ActivatorContent>
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Restore" EndIcon="@Icons.Material.Filled.ArrowDropDown">Restore</MudButton>
                                            </ActivatorContent>
                                            <ChildContent>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Computer" Href="@($"/restore/{p.Id}")">Entire VM</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen" Href="@($"/files/{p.Id}")">Files and folders</MudMenuItem>
                                                @if (p.SqlDatabaseCount > 0)
                                                {
                                                    <MudMenuItem Icon="@Icons.Material.Filled.TableChart" Href="@($"/sql/{p.Id}")">SQL Server databases</MudMenuItem>
                                                }
                                            </ChildContent>
                                        </MudMenu>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" aria-label="More actions">
                                            <MudMenuItem Icon="@Icons.Material.Filled.FactCheck" OnClick="@(() => VerifyAsync(p))">Verify all data</MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => DeleteAsync(p))">Delete restore point</MudMenuItem>
                                        </MudMenu>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private List<RestorePointDto>? _points;
    private string _filter = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _points = await Api.GetAsync<List<RestorePointDto>>("api/restore-points");

    private bool Matches(RestorePointDto p) => string.IsNullOrWhiteSpace(_filter)
        || p.VmName.Contains(_filter, StringComparison.OrdinalIgnoreCase) || p.JobName.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    private async Task VerifyAsync(RestorePointDto point)
    {
        Snackbar.Add($"Verifying restore point of {point.VmName}…", Severity.Info);
        try
        {
            var result = await Api.PostAsync<VerifyResultDto>($"api/restore-points/{point.Id}/verify?full=true");
            Snackbar.Add(result.Ok ? $"All {result.CheckedChunks} blocks are intact." : $"{result.Problems.Count} problem(s): {string.Join("; ", result.Problems.Take(3))}", result.Ok ? Severity.Success : Severity.Error);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(RestorePointDto point)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete restore point", $"Delete the restore point of {point.VmName} from {Fmt.Time(point.CreatedUtc)}? This cannot be undone.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/restore-points/{point.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
