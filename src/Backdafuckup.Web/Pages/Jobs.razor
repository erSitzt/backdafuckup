@page "/jobs"
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject LiveConnection Live

<PageTitle>Backup jobs – backdafuckup</PageTitle>
<PageHeader Title="Backup Jobs" Description="What is backed up, where to and when. Run a job now, or pause it.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/jobs/new">New job</MudButton></Actions>
</PageHeader>

@if (_jobs is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="cq">
    <MudTable Items="_jobs" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Name</MudTh><MudTh Class="c-760">Backs up</MudTh><MudTh Class="c-950">Repository</MudTh><MudTh Class="c-560">Schedule</MudTh><MudTh>Last result</MudTh><MudTh Class="c-760">Last run</MudTh><MudTh Class="c-560">Next run</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <span class="kind-icon @(IsCluster(context) ? ObjectKindUi.KubernetesCss : ObjectKindUi.VmCss)" title="@(IsCluster(context) ? "Kubernetes namespaces" : "VMs")">
                    <MudIcon Icon="@(IsCluster(context) ? AppIcons.Kubernetes : AppIcons.Vm)" Size="Size.Small" Style="vertical-align: middle" />
                </span>
                <MudLink Href="@($"/jobs/{context.Id}")">@context.Name</MudLink>
                @if (!context.Enabled) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.PauseCircle">disabled</MudChip> }
                <span class="cell-sub n-560">@Describe(context.Schedule) · next @Fmt.Time(context.NextRunUtc)@(SqlLine(context) is { } sql ? $" · {sql}" : "")</span>
            </MudTd>
            <MudTd Class="c-760">@BacksUp(context)<span class="cell-sub">@(IsCluster(context) ? "cluster" : _vcenters.Contains(context.ConnectionId) ? "vCenter" : "pool") @context.ConnectionName</span></MudTd>
            <MudTd Class="c-950">@context.RepositoryName</MudTd>
            <MudTd Class="c-560 nowrap">
                @Describe(context.Schedule)
                @if (context.SqlBackup is { Enabled: true } sqlSettings)
                {
                    <span class="cell-sub">SQL log every @Interval(sqlSettings.LogIntervalMinutes)</span>
                }
            </MudTd>
            <MudTd>
                @if (context.IsRunning)
                {
                    <StateChip State="Running" />
                }
                else if (context.LastResult is not null)
                {
                    <StateChip State="@context.LastResult" />
                }
            </MudTd>
            <MudTd Class="c-760 nowrap">@Fmt.Time(context.LastRunUtc)</MudTd>
            <MudTd Class="c-560 nowrap">
                @Fmt.Time(context.NextRunUtc)
                @if (context.SqlNextRunUtc is { } sqlNext)
                {
                    <span class="cell-sub">SQL @Fmt.Time(sqlNext)</span>
                }
            </MudTd>
            <MudTd Style="white-space:nowrap">
                <div class="d-flex align-center justify-end">
                @if (context.IsRunning)
                {
                    <MudTooltip Text="Open running session"><MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenRunningAsync(context))" /></MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Run now (incremental)"><MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" OnClick="@(() => RunAsync(context, false))" aria-label="@($"Run {context.Name} now")" /></MudTooltip>
                }
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" AriaLabel="@($"Actions for {context.Name}")">
                    <MudMenuItem Icon="@Icons.Material.Filled.FastForward" Disabled="context.IsRunning" OnClick="@(() => RunAsync(context, true))">Run an active full</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"/jobs/{context.Id}")">Edit</MudMenuItem>
                    <MudMenuItem Icon="@(context.Enabled ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)" OnClick="@(() => ToggleAsync(context))">@(context.Enabled ? "Disable" : "Enable")</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="context.IsRunning" OnClick="@(() => DeleteAsync(context))">Delete</MudMenuItem>
                </MudMenu>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No backup job yet.</MudText></NoRecordsContent>
    </MudTable>
    </div>

    @if (_sqlSchedules is { Count: > 0 })
    {
        <div class="d-flex align-center mt-6 mb-2">
            <MudText Typo="Typo.h6">SQL Server backups</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Storage" Href="/sql/databases">SQL Server</MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="mb-2">Log backups run on their interval inside the jobs' VMs, independent of the job schedule; native and system full backups on their own schedules.</MudText>
        <div class="cq">
        <MudTable Items="_sqlSchedules" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh>VM</MudTh><MudTh Class="c-760">Job</MudTh><MudTh Class="c-560">Log backups</MudTh><MudTh>Next log</MudTh><MudTh Class="c-760">Next full</MudTh><MudTh Class="c-950">Next system</MudTh><MudTh>Last run</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.VmName
                    <span class="cell-sub n-760">@context.JobName@(context.JobEnabled ? "" : " (disabled)")</span>
                </MudTd>
                <MudTd Class="c-760"><MudLink Href="@($"/jobs/{context.JobId}")">@context.JobName</MudLink>@if (!context.JobEnabled) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.PauseCircle">disabled</MudChip> }</MudTd>
                <MudTd Class="c-560 nowrap">every @Interval(context.LogIntervalMinutes)</MudTd>
                <MudTd Class="nowrap">@Fmt.Time(context.NextLogUtc)</MudTd>
                <MudTd Class="c-760 nowrap">@Fmt.Time(context.NextFullUtc)</MudTd>
                <MudTd Class="c-950 nowrap">@Fmt.Time(context.NextSystemUtc)</MudTd>
                <MudTd Class="nowrap">
                    @if (context.LastResult is not null)
                    {
                        <span title="@context.LastMessage"><StateChip State="@context.LastResult" /></span>
                    }
                    @if (context.DaySessionId is { } day)
                    {
                        <MudLink Href="@($"/sessions/{day}")" Typo="Typo.body2">@Fmt.Time(context.LastRunUtc)</MudLink>
                    }
                    else
                    {
                        @Fmt.Time(context.LastRunUtc)
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        </div>
    }

    @if (_tapeJobs is { Count: > 0 })
    {
        <div class="d-flex align-center mt-6 mb-2">
            <MudText Typo="Typo.h6">Tape jobs</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@AppIcons.Tape" Href="/infrastructure/tape">Tape</MudButton>
        </div>
        <div class="cq">
        <MudTable Items="_tapeJobs" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh>Name</MudTh><MudTh Class="c-760">Copies</MudTh><MudTh Class="c-560">Runs</MudTh><MudTh>Last result</MudTh><MudTh Class="c-760">Last run</MudTh><MudTh Class="c-560">Next run</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIcon Icon="@AppIcons.Tape" Size="Size.Small" Style="vertical-align: middle" />
                    <MudLink Href="/infrastructure/tape">@context.Name</MudLink>
                    @if (!context.Enabled) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.PauseCircle">disabled</MudChip> }
                    <span class="cell-sub n-560">@TapeRuns(context)</span>
                </MudTd>
                <MudTd Class="c-760">@string.Join(", ", context.SourceJobs)<span class="cell-sub">to pool @context.Pool</span></MudTd>
                <MudTd Class="c-560">@TapeRuns(context)</MudTd>
                <MudTd>@if (context.LastResult is not null) { <StateChip State="@context.LastResult" /> }</MudTd>
                <MudTd Class="c-760 nowrap">@Fmt.Time(context.LastRunUtc)</MudTd>
                <MudTd Class="c-560 nowrap">@Fmt.Time(context.NextRunUtc)</MudTd>
                <MudTd Style="white-space:nowrap; text-align:right">
                    <MudTooltip Text="Run now"><MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" OnClick="@(() => RunTapeAsync(context))" aria-label="@($"Run {context.Name} now")" /></MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
        </div>
    }
}

@code {
    private List<JobDto>? _jobs;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Live.SessionUpdated += OnSessionUpdated;
        try
        {
            await Live.EnsureStartedAsync();
        }
        catch (Exception)
        {
        }
    }

    private HashSet<Guid> _clusters = [];

    private bool IsCluster(JobDto job) => _clusters.Contains(job.ConnectionId);

    /// <summary>What a job backs up: the whole cluster, its namespaces (and those chosen by labels), or its VMs.</summary>
    private string BacksUp(JobDto job)
    {
        if (!IsCluster(job))
        {
            return $"{job.Objects.Count} {(job.Objects.Count == 1 ? "VM" : "VMs")}";
        }

        if (job.Objects.Any(o => KubernetesClusterScope.IsJobObject(o.NativeId)))
        {
            return "Whole cluster";
        }

        var named = job.Objects.Count(o => !KubernetesLabelSelector.IsJobObject(o.NativeId));
        var byLabels = job.Objects.Any(o => KubernetesLabelSelector.IsJobObject(o.NativeId)) ? " + by labels" : string.Empty;
        return $"{named} {(named == 1 ? "namespace" : "namespaces")}{byLabels}";
    }

    private List<TapeJobDto>? _tapeJobs;

    private List<SqlScheduleDto>? _sqlSchedules;

    private HashSet<Guid> _vcenters = [];

    private async Task LoadAsync()
    {
        _tapeJobs = await Api.GetAsync<List<TapeJobDto>>("api/tape/jobs");
        _jobs = await Api.GetAsync<List<JobDto>>("api/jobs");
        _sqlSchedules = await Api.GetAsync<List<SqlScheduleDto>>("api/sql/schedules");
        var connections = await Api.GetAsync<List<ConnectionDto>>("api/connections?kind=Kubernetes,VSphere");
        _clusters = [.. connections.Where(c => c.Kind == "Kubernetes").Select(c => c.Id)];
        _vcenters = [.. connections.Where(c => c.Kind == "VSphere").Select(c => c.Id)];
    }

    /// <summary>"SQL log every 15 min" for a job with SQL Server backups, else null.</summary>
    private static string? SqlLine(JobDto job) => job.SqlBackup is { Enabled: true } sql ? $"SQL log every {Interval(sql.LogIntervalMinutes)}" : null;

    private static string Interval(int minutes) => minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes} min";

    /// <summary>When a tape job runs: its schedule, after a backup job, or only on demand.</summary>
    private string TapeRuns(TapeJobDto job)
    {
        var after = job.AfterJobId is { } id ? $"after {_jobs?.FirstOrDefault(j => j.Id == id)?.Name ?? "a backup job"}" : null;
        var scheduled = job.Schedule.Kind is "Daily" or "Weekly" ? Describe(job.Schedule) : null;
        return string.Join(", ", new[] { scheduled, after }.Where(s => s is not null)) is { Length: > 0 } text ? text : "On demand";
    }

    private async Task RunTapeAsync(TapeJobDto job)
    {
        try
        {
            var started = await Api.PostAsync<StartedDto>($"api/tape/jobs/{job.Id}/run");
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnSessionUpdated(SessionSummaryDto session)
    {
        if (session.Kind == "TapeBackup" && session.State is not "Running")
        {
            _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
            return;
        }

        if (session.JobId is not null && (session.State is not "Running" || _jobs?.Any(j => j.Id == session.JobId && !j.IsRunning) == true))
        {
            _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
    }

    public static string Describe(ScheduleDto schedule) => schedule.Kind switch
    {
        "Daily" => $"Daily at {schedule.TimeOfDay}",
        "Weekly" => $"{string.Join(", ", schedule.Days.Select(d => d.ToString()[..3]))} at {schedule.TimeOfDay}",
        _ => "Not scheduled",
    };

    private async Task RunAsync(JobDto job, bool activeFull)
    {
        try
        {
            var started = await Api.PostAsync<StartedDto>($"api/jobs/{job.Id}/run", new RunJobDto(activeFull));
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenRunningAsync(JobDto job)
    {
        var sessions = await Api.GetAsync<List<SessionSummaryDto>>($"api/sessions?jobId={job.Id}&limit=1");
        if (sessions.Count > 0)
        {
            Navigation.NavigateTo($"/sessions/{sessions[0].Id}");
        }
    }

    private async Task ToggleAsync(JobDto job)
    {
        await Api.PostAsync($"api/jobs/{job.Id}/enabled/{(!job.Enabled).ToString().ToLowerInvariant()}");
        await LoadAsync();
    }

    private async Task DeleteAsync(JobDto job)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete job", $"Delete {job.Name}? Its restore points stay available for restores.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/jobs/{job.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public void Dispose() => Live.SessionUpdated -= OnSessionUpdated;
}
