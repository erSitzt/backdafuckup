@* The head of a page: its title, an optional sentence about it, and its actions on the right (wrapping below on narrow screens). *@
<div class="page-header">
    <div class="page-header-text">
        <div class="d-flex align-center flex-wrap gap-2">
            @if (Back is not null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@Back" Size="Size.Small" aria-label="Back" Class="ml-n2" />
            }
            <MudText Typo="Typo.h5" Class="page-title">@Title</MudText>
            @TitleContent
        </div>
        @if (Description is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Description</MudText>
        }
        @DescriptionContent
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Back { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? DescriptionContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
