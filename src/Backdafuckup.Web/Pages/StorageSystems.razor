@page "/infrastructure/storage-systems"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>Storage systems – backdafuckup</PageTitle>
<PageHeader Title="Storage Systems" Description="Storage arrays whose snapshots backups read from: the VM snapshot exists only for seconds, the disks are read from a snapshot of the array through a proxy with SAN access.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartAdding" Disabled="@(_step is not null)">Add storage system</MudButton></Actions>
</PageHeader>

@if (_step is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Add HPE Alletra MP</MudText>
        @if (_step == Step.Address)
        {
            <MudText Typo="Typo.body2" Class="mb-3">The array's management address (its WSAPI, port 443). The certificate is shown for confirmation next.</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Start">
                <MudTextField @bind-Value="_address" Label="Host name or IP address" Variant="Variant.Outlined" AutoFocus="true" />
                <MudNumericField @bind-Value="_port" Label="Port" Variant="Variant.Outlined" Style="max-width:120px" />
            </MudStack>
        }
        else if (_step == Step.Trust && _certificate is { } cert)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Verify the certificate before you trust it, e.g. compare the certificate SHA-256 with the one your browser shows for the array's management interface.
            </MudAlert>
            @CertificateTable(cert)
        }
        else if (_step == Step.Credentials)
        {
            <MudStack>
                <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_userName" Label="WSAPI user" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" />
                <MudText Typo="Typo.caption">
                    A user with the role <i>edit</i> in the domain that holds the volumes is enough. The server takes snapshots only of volumes you turn on below,
                    names them <span class="mono">bdfu-…</span> with its own id in the comment, and never changes or deletes anything else on the array.
                </MudText>
            </MudStack>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Text" OnClick="@(() => _step = null)">Cancel</MudButton>
            <MudSpacer />
            @if (_step == Step.Address)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_address))" OnClick="ProbeAsync">Next</MudButton>
            }
            else if (_step == Step.Trust)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => _step = Step.Credentials)">Trust certificate</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_userName))" OnClick="CreateAsync">Connect and add</MudButton>
            }
        </div>
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
    </MudPaper>
}

@if (_systems is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_systems.Count == 0 && _step is null)
{
    <MudAlert Severity="Severity.Info">
        No storage system yet. Add an HPE Alletra MP to back up VMs on its volumes from array snapshots (so far XCP-ng LVM storage over iSCSI or FC).
        It also needs a backup proxy with SAN access; see the admin guide, "Backup from storage snapshots".
    </MudAlert>
}
else
{
    @foreach (var system in _systems)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@AppIcons.StorageSystem" />
                <MudText Typo="Typo.h6">@system.Name</MudText>
                <StateChip State="@system.Status" />
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NetworkCheck" Disabled="_busy" OnClick="@(() => TestAsync(system))">Test</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="@(() => RefreshAsync(system))">Refresh mapping</MudButton>
                <MudTooltip Text="Edit name, account or address">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="_busy" aria-label="Edit" OnClick="@(() => StartEditing(system))" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="_busy" aria-label="Remove" OnClick="@(() => RemoveAsync(system))" />
            </div>
            <MudText Typo="Typo.body2" Class="mt-1">
                @system.Address:@system.Port · user @system.UserName
                @if (system.Facts is { } facts)
                {
                    <span> · @facts.Model, serial @facts.Serial, OS @facts.OsVersion, @facts.ApiVersion</span>
                    @if (facts.Privileges.Count > 0)
                    {
                        <span> · rights: @string.Join(", ", facts.Privileges)</span>
                    }
                }
                · checked @Fmt.Time(system.LastCheckedUtc)
            </MudText>
            @if (system.LastError is { } error)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@error</MudAlert>
            }
            @if (system.Facts?.LicenseWarning is { } warning)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@warning</MudAlert>
            }
            @if (system.Facts is { } rights && !CanSnapshot(rights))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    The account @system.UserName has @(rights.Privileges.Count == 0 ? "no rights the array named" : string.Join(", ", rights.Privileges)): the backup server can read the
                    array, but not take, present or delete snapshots. For backups from storage snapshots it needs the role edit, in the domain of the volumes (or in all domains).
                </MudAlert>
            }
            <MudAlert Severity="@(Usage(system).Used ? Severity.Success : Severity.Info)" Dense="true" Class="mt-2" Icon="@(Usage(system).Used ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.PauseCircle)">
                @Usage(system).Text
            </MudAlert>
            @foreach (var reader in (system.Readers ?? []).Where(r => r.TrippedUtc is not null))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                    <div class="d-flex align-center gap-2">
                        <span>
                            The @reader.Name reader is switched off since @Fmt.Time(reader.TrippedUtc): @reader.TripReason.
                            VMs on this storage are read from their VM snapshots.
                        </span>
                        <MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="@(() => ResetReaderAsync(system, reader))">Turn back on</MudButton>
                    </div>
                </MudAlert>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">Volumes (@system.VolumesEnabled of @system.Volumes turned on)</MudText>
            @if (_volumes.GetValueOrDefault(system.Id) is { } volumes)
            {
                <MudTable Items="volumes" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh><MudTooltip Text="Turned on: backups may take snapshots of this volume (with the experimental readers on, for jobs with 'Backup from storage snapshots')."><span>Use</span></MudTooltip></MudTh><MudTh>Volume</MudTh><MudTh>Size</MudTh><MudTh>Datastore / SR</MudTh><MudTh>Layout</MudTh><MudTh>WWN</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudSwitch T="bool" Value="@context.Enabled" ValueChanged="@(on => SetVolumeAsync(system, context, on))" Color="Color.Primary"
                                       Disabled="@(_busy || (context.Refusal is not null && !context.Enabled) || context.StorageName is null)" />
                        </MudTd>
                        <MudTd>
                            @context.VolumeName
                            @if (context.ReplicationRole is { } role)
                            {
                                <MudTooltip Text="@(role == "primary"
                                    ? "Replicated to another array (Peer Persistence); this array holds the primary side: snapshots are taken here."
                                    : "Replicated from another array (Peer Persistence); this is the secondary side: snapshots are taken only on the array that holds the primary.")">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(role == "primary" ? Color.Info : Color.Default)">@role</MudChip>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd>@Fmt.Bytes(context.SizeBytes)</MudTd>
                        <MudTd>
                            @if (context.StorageName is { } storage)
                            {
                                <span>@storage <span class="caption">(@context.ConnectionName)</span></span>
                            }
                            else
                            {
                                <span class="caption">no datastore or SR found on it</span>
                            }
                            @if (context.Refusal is { } refusal)
                            {
                                <br /><span class="caption">@refusal</span>
                            }
                        </MudTd>
                        <MudTd>@Layout(context.Layout)</MudTd>
                        <MudTd><span class="mono caption">@context.Wwn</span></MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">Proxy access (iSCSI)</MudText>
            <MudText Typo="Typo.caption" Class="help-text d-block">
                Backups read each array snapshot through a backup proxy with SAN access. The array presents a snapshot only to a host object, so for each proxy
                it needs one that lists the proxy's iSCSI initiator name (IQN), with the persona Generic-ALUA (Linux). backdafuckup presents each snapshot to that
                host object during the backup and removes the presentation afterwards; it never changes or removes the host object itself. Create it on the array
                yourself, or here: every change is shown first, with the CLI line that makes it by hand. The proxy also has to reach the array's iSCSI addresses
                (TCP port 3260).
            </MudText>
            @if (_access.GetValueOrDefault(system.Id) is not { } access)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2" />
            }
            else
            {
                @if (access.Error is { } accessError)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@accessError</MudAlert>
                }
                @if (access.Replicated)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Volumes of this array are replicated (Peer Persistence). Snapshots are taken on the array that holds a volume's primary side, and that side
                        can move: give each proxy a host object on both arrays (add the other array as a storage system too, and create it there as well).
                    </MudAlert>
                }
                @if (access.Proxies.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">No backup proxy yet: add one under <MudLink Href="infrastructure/proxies">Backup Proxies</MudLink> (on a machine that reaches the array's iSCSI network).</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                        <thead><tr><th>Proxy</th><th>iSCSI initiator</th><th>Host object on @system.Name</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var proxy in access.Proxies)
                            {
                                <tr>
                                    <td>@proxy.ProxyName @if (!proxy.Connected) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">offline</MudChip> }</td>
                                    <td>
                                        @if (proxy.InitiatorName is { } iqn)
                                        {
                                            <span class="mono">@iqn</span>
                                        }
                                        else
                                        {
                                            <span class="caption">@(proxy.Connected ? "none yet" : "known when it is connected")</span>
                                        }
                                        @if (proxy.SanProblem is { } san)
                                        {
                                            <br /><span class="caption">No SAN access: @san.Replace("\n", "; ")</span>
                                        }
                                        @if (proxy.PortalsReached is { } reached && proxy.PortalsUnreached is { } unreached)
                                        {
                                            <br />
                                            @if (unreached.Count == 0)
                                            {
                                                <span class="caption">Reaches all @reached.Count iSCSI addresses.</span>
                                            }
                                            else
                                            {
                                                <span class="@(reached.Count == 0 ? "mud-error-text" : "mud-warning-text") caption">
                                                    @(reached.Count == 0 ? "Reaches none" : $"Reaches {reached.Count}") of the @(reached.Count + unreached.Count) iSCSI addresses
                                                    (not: @string.Join(", ", unreached)). Its own addresses: @string.Join(", ", proxy.ProxyAddresses ?? []).
                                                    @(reached.Count == 0 ? "It needs a network interface in the array's iSCSI network(s), or a route to them." : string.Empty)
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (proxy.HostName is { } host)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-1" Style="vertical-align: middle" />
                                            <span>@host</span>
                                            <span class="caption"> · @(proxy.HostPersona ?? "persona unknown")@(proxy.HostDomain is { } d ? $" · domain {d}" : string.Empty)</span>
                                        }
                                        else if (proxy.InitiatorName is not null && access.Error is null)
                                        {
                                            <span class="mud-warning-text">none lists its initiator: backups cannot present snapshots to this proxy</span>
                                        }
                                        else
                                        {
                                            <span class="caption">–</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        @if (proxy.HostName is null && proxy.InitiatorName is not null && access.Error is null)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="_busy" OnClick="@(() => OpenHostDialogAsync(system, proxy))">Create host object…</MudButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                @if (access.Portals.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="d-block mt-1">iSCSI addresses of @system.Name: <span class="mono">@string.Join(", ", access.Portals)</span></MudText>
                }
            }

            <MudExpansionPanels Elevation="0" Class="mt-3">
                <MudExpansionPanel Text="Options">
                    @{ var options = _options[system.Id]; }
                    <div class="field-grid cols-4">
                        <MudNumericField @bind-Value="options.ExpiryHours" Label="Snapshot expiry (hours)" Min="1" Max="72" Variant="Variant.Outlined"
                                         HelperText="The array removes a forgotten snapshot by itself after this time." />
                        <MudNumericField @bind-Value="options.BatchWindowSeconds" Label="Batch window (s)" Min="0" Max="600" Variant="Variant.Outlined"
                                         HelperText="How long a group of VMs waits for the snapshot of its next VM (0: each VM its own array snapshot)." />
                        <MudNumericField @bind-Value="options.ProbationRuns" Label="Verify runs" Min="0" Max="50" Variant="Variant.Outlined"
                                         HelperText="The first backups per reader also compare a sample with the VM snapshot." />
                        <MudNumericField @bind-Value="options.MinSecondsAfterVmSnapshot" Label="Gap after VM snapshot (s)" Min="0" Max="60" Variant="Variant.Outlined"
                                         HelperText="The array snapshot waits this long after the last VM snapshot." />
                    </div>
                    <MudSwitch T="bool" @bind-Value="options.ExperimentalReaders" Color="Color.Primary" Class="mt-2"
                               Label="Experimental readers: XCP-ng LVM storage (LVHD) and vSphere VMFS6 datastores" />
                    <ul class="help-text caption pl-5 mt-1 mb-1">
                        <li><b>Off:</b> backups do not use this array. Every way to read a snapshot LUN is one of these readers so far, so VMs on its volumes are read
                            from their VM snapshots as usual (NBD on XCP-ng, HotAdd on vSphere), whatever is turned on above.</li>
                        <li><b>On:</b> for jobs with <i>Backup from storage snapshots</i>, a VM whose disks all lie on turned-on volumes is backed up like this: VM snapshot
                            (with guest processing), a read-only array snapshot of the volume, the VM snapshot removed again within seconds, then the disks read from the
                            array snapshot through a backup proxy with SAN access. Afterwards the array snapshot is deleted; its expiry removes it if a backup is
                            interrupted.</li>
                    </ul>
                    <MudText Typo="Typo.caption" Class="help-text">
                        Experimental, because backdafuckup reads the layout on the LUN itself: read-only, without activating or mounting anything. Each disk is checked
                        against what XCP-ng or vCenter reports before the VM snapshot is removed, and every incremental compares regions that change tracking reports
                        unchanged with the previous restore point. In verify mode (the first backups per reader, set by "Verify runs", and again after the on-disk
                        format changed) a sample of each disk is also compared with the VM snapshot before it is removed. Any difference switches the reader off
                        for this storage system, and its VMs go the usual way again.
                    </MudText>
                    @foreach (var reader in system.Readers ?? [])
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1">
                            @reader.Name: @ReaderState(reader)
                        </MudText>
                    }
                    <div class="d-flex mt-2"><MudSpacer /><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => SaveOptionsAsync(system))">Save options</MudButton></div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Objects of this server on the array" ExpandedChanged="@(open => open ? LoadLeftoversAsync(system) : Task.CompletedTask)">
                    @if (_leftovers.GetValueOrDefault(system.Id) is not { } leftovers)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (leftovers.Count == 0)
                    {
                        <MudText Typo="Typo.body2">None: no snapshot or presentation of this server is on the array.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>Kind</th><th>Name</th><th>Detail</th><th>Cleanup</th></tr></thead>
                            <tbody>
                                @foreach (var item in leftovers)
                                {
                                    <tr>
                                        <td>@item.Kind</td><td class="mono">@item.Name</td><td>@item.Detail</td>
                                        <td>@(item.Recorded ? "recorded, removed by the cleanup" : "not recorded, removed by the orphan scan after two hours")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
    }
}

<MudDialog @bind-Visible="_hostOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent><MudText Typo="Typo.h6">Host object for proxy @_hostProxy?.ProxyName on @_hostSystem?.Name</MudText></TitleContent>
    <DialogContent>
        @if (_hostPlan is not { } plan)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Nothing is changed on the array until you click "Create on the array". This is what would happen, as the call backdafuckup sends to the array's
                REST API, and as the line for the array's CLI if you would rather make the change yourself (as an array administrator).
            </MudText>
            <div class="field-grid cols-2">
                <MudTextField T="string" @bind-Value="_hostName" Label="Host object name" Variant="Variant.Outlined" Immediate="true" MaxLength="31"
                              HelperText="Up to 31 letters, digits, '.', '-' or '_'." />
                <MudTextField T="string" @bind-Value="_hostDomain" Label="Domain" Variant="Variant.Outlined" Immediate="true"
                              HelperText="The domain of the volumes; empty: none." />
            </div>
            @if (HostPlanStale)
            {
                <div class="d-flex mt-1"><MudSpacer /><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_planning" OnClick="ReplanHostAsync">Show the changes for this name and domain</MudButton></div>
            }
            <MudText Typo="Typo.subtitle2" Class="mt-3">Checked on the array</MudText>
            <ul class="help-text pl-5 mb-2">
                <li>Proxy @plan.ProxyName, iSCSI initiator <span class="mono">@(plan.InitiatorName ?? "–")</span></li>
                @foreach (var check in plan.Checks)
                {
                    <li>@check</li>
                }
            </ul>
            @if (plan.Refusal is { } refusal)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@refusal</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">What would be changed</MudText>
                @foreach (var (change, index) in plan.Changes.Select((c, i) => (c, i + 1)))
                {
                    <MudText Typo="Typo.body2" Class="mt-1"><b>@index.</b> @change.Title</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mt-1">REST API, as backdafuckup sends it:</MudText>
                    <pre class="code-block mono">@change.Method @change.Path
@change.Body</pre>
                    <MudText Typo="Typo.caption" Class="d-block">Or by hand in the array's CLI (the same change):</MudText>
                    <div class="d-flex align-center gap-1">
                        <pre class="code-block mono flex-grow-1">@change.Cli</pre>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy the CLI line" OnClick="@(() => CopyAsync(change.Cli))" />
                    </div>
                    <MudText Typo="Typo.caption" Class="d-block">
                        To remove it later: <span class="mono">@change.UndoCli</span> (after no backup uses it). backdafuckup never changes or removes host objects.
                    </MudText>
                }
                @if (plan.RunRefusal is { } runRefusal)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@runRefusal</MudAlert>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hostOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_hostPlan is not { CanRun: true } || HostPlanStale || _busy || _planning)" OnClick="CreateHostAsync">Create on the array</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent><MudText Typo="Typo.h6">Edit @_editing?.Name</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField T="string" @bind-Value="_editName" Label="Name" Variant="Variant.Outlined" Immediate="true" />
            <MudStack Row="true" AlignItems="AlignItems.Start">
                <MudTextField T="string" Value="_editAddress" ValueChanged="@(v => { _editAddress = v; _editCertificate = null; })" Label="Host name or IP address" Variant="Variant.Outlined" Immediate="true" />
                <MudNumericField T="int" Value="_editPort" ValueChanged="@(v => { _editPort = v; _editCertificate = null; })" Label="Port" Variant="Variant.Outlined" Style="max-width:120px" />
            </MudStack>
            <MudTextField T="string" @bind-Value="_editUserName" Label="WSAPI user" Variant="Variant.Outlined" Immediate="true" />
            <MudTextField T="string" @bind-Value="_editPassword" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true"
                          HelperText="Empty: the stored password stays." />
            @if (EditMoved)
            {
                @if (_editCertificate is { } editCert)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Verify the certificate of the new address before you trust it, e.g. compare its SHA-256 with the one your browser shows for the array's management interface.
                    </MudAlert>
                    @CertificateTable(editCert)
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        A new address: its certificate is shown for confirmation first. It has to be the same array (the serial number is compared); another array is a storage system of its own.
                    </MudAlert>
                }
            }
            <MudText Typo="Typo.caption">
                Saving signs in with these settings first; if that fails, or the address leads to another array, nothing is changed. The volumes turned on,
                the options and the objects of this server on the array stay as they are.
            </MudText>
            @if (_editError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_editError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editOpen = false)">Cancel</MudButton>
        @if (EditMoved && _editCertificate is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_editAddress))" OnClick="ProbeEditAsync">Show certificate</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editUserName))" OnClick="SaveEditAsync">
                @(EditMoved ? "Trust certificate and save" : "Save")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private enum Step { Address, Trust, Credentials }

    private List<StorageSystemDto>? _systems;
    private readonly Dictionary<Guid, List<StorageVolumeDto>> _volumes = [];
    private readonly Dictionary<Guid, OptionsModel> _options = [];
    private readonly Dictionary<Guid, List<StorageLeftoverDto>> _leftovers = [];
    private Step? _step;
    private bool _busy;
    private string? _error;
    private string _address = string.Empty;
    private int _port = 443;
    private CertificateDto? _certificate;
    private string _name = string.Empty;
    private string _userName = string.Empty;
    private string _password = string.Empty;

    /// <summary>Editable copy of a system's options.</summary>
    private sealed class OptionsModel
    {
        public int ExpiryHours { get; set; }

        public int MaxVmsPerSnapshot { get; set; }

        public int BatchWindowSeconds { get; set; }

        public bool ExperimentalReaders { get; set; }

        public int ProbationRuns { get; set; }

        public int MinSecondsAfterVmSnapshot { get; set; }

        public static OptionsModel From(StorageSystemOptionsDto o) => new()
        {
            ExpiryHours = o.ExpiryHours, MaxVmsPerSnapshot = o.MaxVmsPerSnapshot, BatchWindowSeconds = o.BatchWindowSeconds, ExperimentalReaders = o.ExperimentalReaders,
            ProbationRuns = o.ProbationRuns, MinSecondsAfterVmSnapshot = o.MinSecondsAfterVmSnapshot,
        };

        public StorageSystemOptionsDto ToDto() => new(ExpiryHours, MaxVmsPerSnapshot, BatchWindowSeconds, ExperimentalReaders, ProbationRuns, MinSecondsAfterVmSnapshot);
    }

    private readonly Dictionary<Guid, StorageProxyAccessDto> _access = [];
    private bool _editOpen;
    private StorageSystemDto? _editing;
    private string _editName = string.Empty;
    private string _editAddress = string.Empty;
    private int _editPort = 443;
    private string _editUserName = string.Empty;
    private string? _editPassword;
    private CertificateDto? _editCertificate;
    private string? _editError;

    private static RenderFragment CertificateTable(CertificateDto cert) => @<MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
        <tbody>
            <tr><td style="width:180px">Host</td><td>@cert.HostAddress</td></tr>
            <tr><td>Subject</td><td>@cert.Subject</td></tr>
            <tr><td>Issuer</td><td>@cert.Issuer @(cert.ValidAgainstSystemCa ? "(trusted CA)" : "(self-signed or unknown CA)")</td></tr>
            <tr><td>Valid</td><td>@Fmt.Time(cert.NotBefore) – @Fmt.Time(cert.NotAfter)</td></tr>
            <tr><td>Public key SHA-256</td><td class="mono">@cert.SpkiSha256</td></tr>
            <tr><td>Certificate SHA-256</td><td class="mono">@cert.Sha256Thumbprint</td></tr>
        </tbody>
    </MudSimpleTable>;

    /// <summary>The address or port differs from the stored one: the new certificate is confirmed before saving.</summary>
    private bool EditMoved => _editing is { } s && (!string.Equals(_editAddress.Trim(), s.Address, StringComparison.OrdinalIgnoreCase) || _editPort != s.Port);

    private void StartEditing(StorageSystemDto system)
    {
        (_editing, _editName, _editAddress, _editPort, _editUserName, _editPassword, _editCertificate, _editError) =
            (system, system.Name, system.Address, system.Port, system.UserName, null, null, null);
        _editOpen = true;
    }

    private async Task ProbeEditAsync()
    {
        _busy = true;
        _editError = null;
        try
        {
            _editCertificate = await Api.PostAsync<CertificateDto>("api/storage-systems/probe", new ProbeRequestDto(_editAddress.Trim(), _editPort, _editing!.Kind));
        }
        catch (ApiException ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveEditAsync()
    {
        _busy = true;
        _editError = null;
        try
        {
            var saved = await Api.PutAsync<StorageSystemDto>($"api/storage-systems/{_editing!.Id}", new UpdateStorageSystemDto
            {
                Name = _editName.Trim(), Address = _editAddress.Trim(), Port = _editPort, UserName = _editUserName.Trim(), Password = _editPassword,
                TrustedCertificates = EditMoved && _editCertificate is { } cert ? [cert] : [],
            });
            _editOpen = false;
            _editPassword = null;
            Snackbar.Add($"{saved.Name} saved; signed in as {saved.UserName}.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _editError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
    private bool _hostOpen;
    private bool _planning;
    private StorageSystemDto? _hostSystem;
    private StorageProxyHostDto? _hostProxy;
    private StorageHostPlanDto? _hostPlan;
    private string? _hostName;
    private string? _hostDomain;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _systems = await Api.GetAsync<List<StorageSystemDto>>("api/storage-systems");
        foreach (var system in _systems)
        {
            _options[system.Id] = OptionsModel.From(system.Options);
            _volumes[system.Id] = await Api.GetAsync<List<StorageVolumeDto>>($"api/storage-systems/{system.Id}/volumes");
        }

        // Reading the host objects signs in to each array: after the page shows.
        foreach (var system in _systems)
        {
            _ = LoadAccessAsync(system);
        }
    }

    private async Task LoadAccessAsync(StorageSystemDto system)
    {
        _access.Remove(system.Id);
        try
        {
            _access[system.Id] = await Api.GetAsync<StorageProxyAccessDto>($"api/storage-systems/{system.Id}/proxy-access");
        }
        catch (ApiException ex)
        {
            _access[system.Id] = new StorageProxyAccessDto([], [], null, null, null, false, ex.Message);
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The name or domain was edited since the changes were shown: they have to be shown again before anything is created.</summary>
    private bool HostPlanStale =>
        _hostPlan is { } plan && (!string.Equals((_hostName ?? string.Empty).Trim(), plan.Name, StringComparison.Ordinal)
                                  || !string.Equals((_hostDomain ?? string.Empty).Trim(), plan.Domain ?? string.Empty, StringComparison.Ordinal));

    private async Task OpenHostDialogAsync(StorageSystemDto system, StorageProxyHostDto proxy)
    {
        (_hostSystem, _hostProxy, _hostPlan, _hostOpen) = (system, proxy, null, true);
        await PlanHostAsync(new StorageHostRequestDto(proxy.ProxyId));
    }

    private Task ReplanHostAsync() =>
        PlanHostAsync(new StorageHostRequestDto(_hostProxy!.ProxyId, _hostName, string.IsNullOrWhiteSpace(_hostDomain) ? "-" : _hostDomain));

    private async Task PlanHostAsync(StorageHostRequestDto request)
    {
        _planning = true;
        try
        {
            _hostPlan = await Api.PostAsync<StorageHostPlanDto>($"api/storage-systems/{_hostSystem!.Id}/proxy-access/plan", request);
            (_hostName, _hostDomain) = (_hostPlan.Name, _hostPlan.Domain ?? string.Empty);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _hostOpen = false;
        }
        finally
        {
            _planning = false;
        }
    }

    private Task CreateHostAsync() => RunAsync(async () =>
    {
        var plan = _hostPlan!;
        _access[_hostSystem!.Id] = await Api.PostAsync<StorageProxyAccessDto>($"api/storage-systems/{_hostSystem.Id}/proxy-access/hosts",
            new StorageHostRequestDto(_hostProxy!.ProxyId, plan.Name, plan.Domain ?? "-"));
        Snackbar.Add($"Host object {plan.Name} created on {_hostSystem.Name}.", Severity.Success);
        _hostOpen = false;
    });

    private async Task CopyAsync(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add("Copied.", Severity.Info);
    }

    /// <summary>Whether the account may take, present and delete snapshots: the role edit (or super) somewhere.</summary>
    private static bool CanSnapshot(StorageSystemFactsDto facts) =>
        facts.Privileges.Any(p => p.Split(' ', 2)[0].ToLowerInvariant() is "edit" or "super");

    /// <summary>Whether backups use this storage system now, and why (not).</summary>
    private static (bool Used, string Text) Usage(StorageSystemDto system) =>
        !system.Options.ExperimentalReaders
            ? (false, "Not used by backups: the experimental readers are off (Options), so VMs on these volumes are read from their VM snapshots as usual. Turning volumes on only prepares them.")
        : system.VolumesEnabled == 0
            ? (false, "Not used by backups: no volume is turned on.")
        : system.Facts is { } facts && !CanSnapshot(facts)
            ? (false, $"Not used by backups: the account {system.UserName} may not take snapshots (see above); its VMs are read from their VM snapshots.")
            : (true, $"Used by backups: jobs with 'Backup from storage snapshots' read VMs whose disks all lie on the {system.VolumesEnabled} turned-on volume(s) from array snapshots taken here.");

    private static string Layout(string layout) => layout switch
    {
        "Lvhd" => "XCP-ng LVM (LVHD)",
        "Vmfs5" => "VMFS 5",
        "Vmfs6" => "VMFS 6",
        _ => layout,
    };

    private void StartAdding()
    {
        _step = Step.Address;
        _error = null;
        _certificate = null;
        _address = string.Empty;
        _port = 443;
        _name = string.Empty;
        _userName = string.Empty;
        _password = string.Empty;
    }

    private Task ProbeAsync() => RunAsync(async () =>
    {
        _certificate = await Api.PostAsync<CertificateDto>("api/storage-systems/probe", new ProbeRequestDto(_address.Trim(), _port, "AlletraMp"));
        _name = string.IsNullOrEmpty(_name) ? _address.Trim() : _name;
        _step = Step.Trust;
    });

    private Task CreateAsync() => RunAsync(async () =>
    {
        var created = await Api.PostAsync<StorageSystemDto>("api/storage-systems", new CreateStorageSystemDto
        {
            Name = _name.Trim(),
            Address = _address.Trim(),
            Port = _port,
            UserName = _userName.Trim(),
            Password = _password,
            TrustedCertificates = _certificate is null ? [] : [_certificate],
        });
        _step = null;
        _password = string.Empty;
        Snackbar.Add($"Storage system {created.Name} added: {created.Volumes} volume(s) with a datastore or SR found. Turn on those backups may use.", Severity.Success);
        await LoadAsync();
    });

    private Task TestAsync(StorageSystemDto system) => RunAsync(async () =>
    {
        var tested = await Api.PostAsync<StorageSystemDto>($"api/storage-systems/{system.Id}/test");
        Snackbar.Add(tested.LastError is null ? $"{tested.Name}: connected." : $"{tested.Name}: {tested.LastError}", tested.LastError is null ? Severity.Success : Severity.Error);
        await LoadAsync();
    });

    private Task RefreshAsync(StorageSystemDto system) => RunAsync(async () =>
    {
        _volumes[system.Id] = await Api.PostAsync<List<StorageVolumeDto>>($"api/storage-systems/{system.Id}/volumes/refresh");
        Snackbar.Add($"{system.Name}: mapping refreshed.", Severity.Success);
    });

    private Task SetVolumeAsync(StorageSystemDto system, StorageVolumeDto volume, bool enabled) => RunAsync(async () =>
    {
        if (enabled)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                $"Use volume {volume.VolumeName}?",
                $"Backups of jobs with 'Backup from storage snapshots' will take snapshots of {volume.VolumeName} ({volume.StorageName}) on {system.Name} and present " +
                "them to a backup proxy. Turn on only volumes this server may snapshot.",
                yesText: "Turn on", cancelText: "Cancel");
            if (confirmed != true)
            {
                return;
            }
        }

        await Api.PutAsync($"api/storage-systems/{system.Id}/volumes/{volume.Id}", new SetStorageVolumeDto(enabled));
        await LoadAsync();
    });

    private Task SaveOptionsAsync(StorageSystemDto system) => RunAsync(async () =>
    {
        await Api.PutAsync<StorageSystemDto>($"api/storage-systems/{system.Id}/options", _options[system.Id].ToDto());
        Snackbar.Add($"{system.Name}: options saved.", Severity.Success);
        await LoadAsync();
    });

    private static string ReaderState(StorageReaderDto reader) =>
        (reader.TrippedUtc is not null ? "switched off"
            : reader.VerifiedRuns < reader.ProbationRuns ? $"verify mode, {reader.VerifiedRuns} of {reader.ProbationRuns} backups compared"
            : $"verified ({reader.VerifiedRuns} backups compared)")
        + (reader.WriterRuns is { Count: > 0 } writers
            ? "; " + string.Join(", ", writers.OrderBy(w => w.Key, StringComparer.Ordinal)
                .Select(w => w.Value < reader.ProbationRuns ? $"{w.Key} {w.Value} of {reader.ProbationRuns}" : $"{w.Key} verified"))
            : string.Empty)
        + (reader.FormatVersion is { } version ? $", format {version}" : string.Empty);

    private Task ResetReaderAsync(StorageSystemDto system, StorageReaderDto reader) => RunAsync(async () =>
    {
        await Api.PostAsync<StorageReaderDto>($"api/storage-systems/{system.Id}/readers/{reader.Reader}/reset");
        Snackbar.Add($"{system.Name}: the {reader.Name} reader is on again; the next backups run in verify mode.", Severity.Success);
        await LoadAsync();
    });

    private async Task LoadLeftoversAsync(StorageSystemDto system)
    {
        _leftovers.Remove(system.Id);
        await RunAsync(async () => _leftovers[system.Id] = await Api.GetAsync<List<StorageLeftoverDto>>($"api/storage-systems/{system.Id}/leftovers"));
    }

    private async Task RemoveAsync(StorageSystemDto system)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Remove {system.Name}?",
            "The server forgets the array and its volume mapping. It refuses while snapshots or presentations of this server are still on the array. Nothing on the array is changed.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Api.DeleteAsync($"api/storage-systems/{system.Id}");
            Snackbar.Add($"{system.Name} removed.", Severity.Success);
            await LoadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
