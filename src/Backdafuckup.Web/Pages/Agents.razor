@page "/infrastructure/agents"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>Guest agents – backdafuckup</PageTitle>
<PageHeader Title="Guest Agents"
            Description="The backdafuckup agent in a Windows VM freezes the applications through VSS while the VM snapshot is taken, so backups are application-consistent (SQL Server, Active Directory, Exchange …). It only connects outbound to this server; no port has to be opened in the VM. Install it here over SMB (port 445, Windows administrator credentials) or with the setup package by group policy or software distribution.">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="api/agents/package" Target="_blank" Disabled="@(_settings?.ServerUrl is null || _settings.Builds.Count == 0)">Download setup</MudButton>
    </Actions>
</PageHeader>

@if (_settings is not null)
{
    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="Settings" Expanded="@(_settings.ServerUrl is null || _settings.Builds.Count == 0)">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_serverUrl" Label="Address under which the guests reach this server" Placeholder="https://backup.example.local:9555/" Variant="Variant.Outlined"
                                  HelperText="The agents connect to this address (HTTPS). It must be resolvable and reachable from the VMs." />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUrlAsync">Save</MudButton>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@_settings.EnrollmentSecret" Label="Enrollment secret" ReadOnly="true" Variant="Variant.Outlined"
                                  InputType="@(_showSecret ? InputType.Text : InputType.Password)" Adornment="Adornment.End"
                                  AdornmentIcon="@(_showSecret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" OnAdornmentClick="@(() => _showSecret = !_showSecret)"
                                  HelperText="Part of the setup package. Renewing it does not affect enrolled agents." />
                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="RenewSecretAsync">Renew secret</MudButton>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.body2">
                        Server certificate pinned by the agents:
                        @if (_settings.ServerPins.Count == 0)
                        {
                            <span>none (Windows certificate validation applies: use a certificate the VMs trust)</span>
                        }
                        else
                        {
                            <span class="mono">@string.Join(", ", _settings.ServerPins)</span>
                        }
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Agent builds:
                        @if (_settings.Builds.Count == 0)
                        {
                            <span style="color:#c62828">none in <span class="mono">@_settings.PackageDirectory</span> (scripts/build-agent.sh)</span>
                        }
                        else
                        {
                            @foreach (var build in _settings.Builds)
                            {
                                <MudChip T="string" Size="Size.Small">@build.Name @build.Version (@Fmt.Bytes(build.SizeBytes))</MudChip>
                            }
                        }
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (_pools is null || _agents is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_pools.Count == 0)
{
    <MudAlert Severity="Severity.Info">Add a virtualization pool first.</MudAlert>
}
else
{
    <MudPaper Class="pa-3 mb-3 d-flex flex-wrap gap-3 align-center" Elevation="1">
        <MudSelect T="Guid" Value="_poolId" ValueChanged="PoolChangedAsync" Label="Pool" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px">
            @foreach (var pool in _pools)
            {
                <MudSelectItem T="Guid" Value="pool.Id">@pool.DisplayName</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_filter" Placeholder="Filter VMs" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width:220px" />
        <MudSpacer />
        <MudSelect T="Guid?" @bind-Value="_credentialId" Label="Windows credentials" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px">
            @foreach (var credential in _credentials)
            {
                <MudSelectItem T="Guid?" Value="credential.Id">@credential.UserName</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.InstallDesktop" Disabled="@(_selected.Count == 0 || _credentialId is null || _busy)" OnClick="InstallAsync">
            Install agent (@_selected.Count)
        </MudButton>
    </MudPaper>
    @if (_credentials.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">For the push installation add Windows credentials first (<MudLink Href="/infrastructure/credentials">Windows Credentials</MudLink>).</MudAlert>
    }

    @if (_testing)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-2" />
    }
    @if (_test is not null)
    {
        <MudAlert Severity="@(_test.Ok ? Severity.Success : Severity.Error)" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _test = null)">
            <b>@_testHost:</b> @_test.Message
            @foreach (var line in _test.Log)
            {
                <div class="mono" style="font-size:12px">@line</div>
            }
        </MudAlert>
    }

    <MudTable T="VmRow" Items="@Rows" Dense="true" Hover="true" Elevation="1" MultiSelection="true" @bind-SelectedItems="_selected">
        <HeaderContent>
            <MudTh>VM</MudTh><MudTh>Agent</MudTh><MudTh>Guest</MudTh><MudTh>Build</MudTh><MudTh>VSS provider</MudTh><MudTh>Addresses</MudTh><MudTh>Last contact</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.Vm.Name
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.Vm.Properties.GetValueOrDefault("powerState")</MudText>
            </MudTd>
            <MudTd>
                @if (context.Agent is null)
                {
                    <MudChip T="string" Size="Size.Small">not installed</MudChip>
                }
                else if (!context.Agent.Online)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">offline</MudChip>
                }
                else if (!context.Agent.UpToDate)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">updating</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">online</MudChip>
                }
            </MudTd>
            <MudTd>
                @context.Agent?.HostName
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.Agent?.OsName</MudText>
            </MudTd>
            <MudTd>@(context.Agent is null ? "" : $"{context.Agent.Build} {context.Agent.Version}")</MudTd>
            <MudTd>@context.Agent?.VssProvider</MudTd>
            <MudTd><span class="mono">@(context.Agent?.IpAddresses ?? context.Agent?.RemoteAddress)</span></MudTd>
            <MudTd>@(context.Agent is null ? "" : Fmt.Time(context.Agent.LastContactUtc))</MudTd>
            <MudTd Style="text-align:right">
                @if (context.Agent is { Online: true })
                {
                    <MudTooltip Text="Test VSS: prepare, freeze for a moment and thaw (no snapshot)">
                        <MudIconButton Size="Size.Small" Icon="@AppIcons.Verify" Disabled="_testing" OnClick="@(() => TestAsync(context.Agent))" />
                    </MudTooltip>
                }
                @if (context.Agent is not null)
                {
                    <MudTooltip Text="Forget this agent (its key stops working; a running agent enrolls again)">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LinkOff" OnClick="@(() => ForgetAsync(context.Agent))" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No VMs in this pool.</MudText></NoRecordsContent>
    </MudTable>
}

@code {
    private sealed record VmRow(InventoryItemDto Vm, AgentDto? Agent);

    private AgentSettingsDto? _settings;
    private List<ConnectionDto>? _pools;
    private List<AgentDto>? _agents;
    private List<InventoryItemDto> _vms = [];
    private List<WindowsCredentialDto> _credentials = [];
    private HashSet<VmRow> _selected = [];
    private Guid _poolId;
    private Guid? _credentialId;
    private string? _serverUrl;
    private string _filter = string.Empty;
    private bool _showSecret;
    private bool _busy;
    private bool _testing;
    private AgentTestResultDto? _test;
    private string? _testHost;

    private IEnumerable<VmRow> Rows => _vms
        .Where(v => v.Kind == "Vm" && (_filter.Length == 0 || v.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(v => v.Name)
        .Select(v => new VmRow(v, _agents?.FirstOrDefault(a => a.VmNativeId == v.NativeId)));

    protected override async Task OnInitializedAsync()
    {
        _settings = await Api.GetAsync<AgentSettingsDto>("api/agents/settings");
        _serverUrl = _settings.ServerUrl ?? $"{new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)}/";
        _credentials = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
        _credentialId = _credentials.Count == 1 ? _credentials[0].Id : null;
        _pools = await Api.GetAsync<List<ConnectionDto>>("api/connections");
        _agents = await Api.GetAsync<List<AgentDto>>("api/agents");
        if (_pools.Count > 0)
        {
            await PoolChangedAsync(_pools[0].Id);
        }
    }

    private async Task PoolChangedAsync(Guid poolId)
    {
        _poolId = poolId;
        _selected = [];
        _vms = await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{poolId}/inventory");
    }

    private async Task SaveUrlAsync()
    {
        try
        {
            await Api.PutAsync("api/agents/settings", new AgentSettingsUpdateDto(_serverUrl));
            _settings = await Api.GetAsync<AgentSettingsDto>("api/agents/settings");
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RenewSecretAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Renew enrollment secret", "New installations need the new secret; existing setup packages stop working. Enrolled agents keep working.", yesText: "Renew", cancelText: "Cancel") != true)
        {
            return;
        }

        await Api.PostAsync("api/agents/settings/renew-secret");
        _settings = await Api.GetAsync<AgentSettingsDto>("api/agents/settings");
    }

    private async Task InstallAsync()
    {
        _busy = true;
        try
        {
            var vms = _selected.Select(r => new JobObjectDto(r.Vm.NativeId, r.Vm.Name)).ToList();
            var started = await Api.PostAsync<StartedDto>("api/agents/install", new InstallAgentsDto(_poolId, vms, _credentialId!.Value));
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(AgentDto agent)
    {
        _testing = true;
        _test = null;
        _testHost = agent.HostName;
        try
        {
            _test = await Api.PostAsync<AgentTestResultDto>($"api/agents/{agent.Id}/test");
        }
        catch (ApiException ex)
        {
            _test = new AgentTestResultDto(false, ex.Message, []);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task ForgetAsync(AgentDto agent)
    {
        if (await Dialogs.ShowMessageBoxAsync("Forget agent", $"Forget the agent on {agent.HostName}? It stays installed in the VM and enrolls again with the enrollment secret.", yesText: "Forget", cancelText: "Cancel") != true)
        {
            return;
        }

        await Api.DeleteAsync($"api/agents/{agent.Id}");
        _agents = await Api.GetAsync<List<AgentDto>>("api/agents");
    }
}
