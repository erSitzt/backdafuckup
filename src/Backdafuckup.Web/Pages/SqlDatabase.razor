@page "/sql/databases/{Id:guid}"
@using System.Globalization
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_detail?.Database.Name ?? "SQL Server database") – backdafuckup</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_detail is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    var d = _detail.Database;
    <PageHeader Title="@d.Name" Back="/sql/databases"
                Description="@($"{d.Instance} on {d.VmName} · {d.RecoveryModel ?? "recovery model unknown"} · {(d.ProductVersion is null ? "" : $"SQL Server {d.ProductVersion} · ")}last log backup {Fmt.Time(d.LastLogUtc)} · last full backup {Fmt.Time(d.LastFullUtc)}")">
        <TitleContent>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@SqlDatabases.ChainColor(d.ChainState)" Icon="@SqlDatabases.ChainIcon(d.ChainState)">@SqlDatabases.ChainLabel(d.ChainState)</MudChip>
        </TitleContent>
    </PageHeader>
    @if (d.ChainReason is not null)
    {
        <MudAlert Severity="@(d.ChainState == "Simple" ? Severity.Info : Severity.Warning)" Dense="true" Class="mb-3">@d.ChainReason</MudAlert>
    }

    <MudPaper Class="pa-3" Elevation="1">
        <MudText Typo="Typo.h6" Class="section-title mb-2">Restore to a point in time</MudText>
        @if (_detail.Spans.Count == 0)
        {
            <MudText Typo="Typo.body2">No backup of this database can be restored yet (no full backup it could start from).</MudText>
        }
        else
        {
            var (from, to) = Range();
            var total = Math.Max(1, (to - from).TotalSeconds);
            string Left(DateTimeOffset t) => (Math.Clamp((t - from).TotalSeconds / total * 100, 0, 100)).ToString("0.###", CultureInfo.InvariantCulture) + "%";
            string Width(DateTimeOffset a, DateTimeOffset b) => (Math.Max(0.4, (b - a).TotalSeconds / total * 100)).ToString("0.###", CultureInfo.InvariantCulture) + "%";
            <div style="position:relative;height:30px;background:var(--mud-palette-background-gray);border-radius:4px;overflow:hidden">
                @foreach (var span in _detail.Spans)
                {
                    <div title="@($"{Fmt.Time(span.FromUtc)} – {Fmt.Time(span.ToUtc)}: {BaseText(span.BaseKind)} and {span.Logs} log backup(s)")"
                         style="position:absolute;top:0;bottom:0;left:@Left(span.FromUtc);width:@Width(span.FromUtc, span.ToUtc);background:var(--mud-palette-success-lighten)"></div>
                }
                @foreach (var gap in _detail.Gaps)
                {
                    <div title="@($"not covered: {gap.Reason}")" style="position:absolute;top:0;bottom:0;left:@Left(gap.FromUtc);width:@Width(gap.FromUtc, gap.ToUtc);background:var(--mud-palette-warning)"></div>
                }
                @foreach (var point in _detail.Points)
                {
                    <div title="@($"{Fmt.Time(point.FinishUtc)}: {PointText(point.Kind)} ({Fmt.Bytes(point.Bytes)})")"
                         style="position:absolute;bottom:0;left:@Left(point.FinishUtc);width:2px;height:@(point.Kind == "Log" ? "45%" : "100%");background:var(--mud-palette-success-darken)"></div>
                }
                @if (Selected() is { } at)
                {
                    <div style="position:absolute;top:0;bottom:0;left:@Left(at);width:3px;margin-left:-1px;background:var(--mud-palette-error)"></div>
                }
            </div>
            <div style="position:relative;height:16px">
                @foreach (var tick in HourTicks(from, to))
                {
                    <div style="position:absolute;left:@Left(tick);transform:translateX(-50%);font-size:11px;color:var(--mud-palette-text-secondary);border-left:1px solid var(--mud-palette-lines-default);padding-left:2px;white-space:nowrap">
                        @tick.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)
                    </div>
                }
            </div>
            <MudSlider T="double" Value="_slider" ValueChanged="OnSliderChanged" Min="0" Max="total" Step="1" Immediate="true" Color="Color.Error" Class="mt-1"
                       aria-label="Point in time" />
            <div class="d-flex justify-space-between">
                <MudText Typo="Typo.caption">@Fmt.Time(from)</MudText>
                <MudText Typo="Typo.caption">@Fmt.Time(to)</MudText>
            </div>
            <div class="d-flex align-center justify-center mb-2" style="gap:4px">
                <MudTooltip Text="The oldest restorable point"><MudIconButton Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" OnClick="@(() => JumpAsync(from))" aria-label="Oldest point" /></MudTooltip>
                <MudTooltip Text="The end of the previous backup"><MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="@(() => StepAsync(-1))" aria-label="Previous backup" /></MudTooltip>
                <MudText Typo="Typo.body1" Class="mx-2" Style="flex:0 1 260px;text-align:center"><b>@SelectedText(to)</b></MudText>
                <MudTooltip Text="The end of the next backup"><MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="@(() => StepAsync(1))" aria-label="Next backup" /></MudTooltip>
                <MudTooltip Text="The latest backup"><MudIconButton Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" OnClick="LatestAsync" aria-label="Latest point" /></MudTooltip>
            </div>
            <div class="d-flex gap-2 align-center mb-2" style="flex-wrap:wrap">
                <MudTextField T="string" @bind-Value="_timeText" Label="Exact time (yyyy-MM-dd HH:mm:ss, local)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:300px" Immediate="true" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TypedAsync">Use</MudButton>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">Green: restorable · dark marks: ends of full (tall) and log backups (short) · orange: not covered · red: the chosen time</MudText>
            @if (_snapped is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_snapped</MudAlert>
            }
            @if (_planError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_planError</MudAlert>
            }
            @if (_plan is { } plan)
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    Restores @BaseText(plan.BaseKind) of @Fmt.Time(plan.BaseUtc) (@Fmt.Bytes(plan.BaseBytes))@(plan.Logs == 0 ? " and no log backup" : $", then {plan.Logs} log backup(s) ({Fmt.Bytes(plan.LogBytes)})")
                    @(plan.StopAtLocal is { } stop ? $"up to {plan.ReachedUtc.ToLocalTime():yyyy-MM-dd HH:mm:ss} (STOPAT {stop.Replace('T', ' ')[..19]} in SQL Server's time)" : plan.Logs == 0 ? string.Empty : "to the end of the last one") — the state of @plan.ReachedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture).
                </MudText>
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SettingsBackupRestore" OnClick="@(() => OpenAsync(false))">Restore as a new database</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.SettingsBackupRestore" OnClick="@(() => OpenAsync(true))">Overwrite the original</MudButton>
                    <MudTooltip Text="@(plan.RestorePointId is null ? "Publishing needs a restore point as the base; this time starts from a full backup. Restore it as a new database instead." : "Attach it in a VM from the backup without copying the files; the log backups are applied in a temporary overlay.")">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Publish" Disabled="@(plan.RestorePointId is null)" OnClick="@(() => OpenAsync(false, true))">Publish</MudButton>
                    </MudTooltip>
                </div>
            }
        }
    </MudPaper>

    @if (_detail.Fulls.Count > 0)
    {
        <MudPaper Class="pa-3 mt-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="section-title">Full backups (.bak)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                The full backups the agent took, read straight from the repository. Restore one anywhere with
                <span class="mono">RESTORE DATABASE … FROM DISK = N'…' WITH MOVE …</span> (<span class="mono">RESTORE FILELISTONLY</span> lists the files).
            </MudText>
            <MudTable Items="_detail.Fulls" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Finished</MudTh>
                    <MudTh>Kind</MudTh>
                    <MudTh>File</MudTh>
                    <MudTh Style="text-align:right">Size</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Finished" Style="white-space:nowrap">@Fmt.Time(context.FinishUtc)</MudTd>
                    <MudTd DataLabel="Kind">@(context.Kind == "SystemFull" ? "system database" : "full")</MudTd>
                    <MudTd DataLabel="File" Class="mono" Style="word-break:break-all">@context.FileName</MudTd>
                    <MudTd DataLabel="Size" Style="text-align:right;white-space:nowrap">@Fmt.Bytes(context.Bytes)</MudTd>
                    <MudTd Style="text-align:right">
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadAsync(context))"
                                   aria-label="@($"Download {context.FileName}")">Download</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

<MudDialog @bind-Visible="_open" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_overwrite ? $"Overwrite {_detail?.Database.Name}" : _publish ? $"Publish {_detail?.Database.Name}" : $"Restore {_detail?.Database.Name} as a new database")</MudText>
        <MudText Typo="Typo.body2">@_detail?.Database.Instance on @_detail?.Database.VmName, @(_plan is null ? "" : $"state of {Fmt.Time(_plan.ReachedUtc)}")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_overwrite)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The database is restored beside its own files first (*.bdfu-new). Then it goes offline for the swap: open connections are dropped
                    and their transactions rolled back. If its job backs up its logs, it gets a last log backup right before (in single-user mode),
                    so everything up to the swap stays restorable; otherwise what was written after its last backup is lost. If it does not come
                    online with the restored files, it gets its own back.
                </MudAlert>
            }
            else if (_publish)
            {
                <MudText Typo="Typo.body2">
                    The agent in the target VM mounts the volumes of the restore point (read from the backup, nothing is copied), restores the
                    database from its SQL Server snapshot onto them and applies the log backups up to the chosen time. Everything it writes goes to
                    a temporary overlay in the VM and is discarded when the database is unpublished; the backup stays as it is.
                </MudText>
            }
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="_targetVm" ValueChanged="OnTargetVmChanged" Label="Target VM" Variant="Variant.Outlined" Dense="true" Disabled="_overwrite" ToStringFunc="VmLabel"
                               HelperText="@(_publish ? "VMs whose agent can publish SQL Server databases." : "VMs whose agent can restore SQL Server databases.")">
                        @foreach (var a in _agents)
                        {
                            <MudSelectItem T="string" Value="@a.VmNativeId">@($"{a.VmName ?? a.HostName} ({a.HostName}{(a.Online ? "" : ", offline")})")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" Value="_accountId" ValueChanged="OnAccountChanged" Label="Account" Variant="Variant.Outlined" Dense="true"
                               HelperText="@(_overwrite ? "A Windows account or a SQL Server login that is sysadmin." : "A Windows account or a SQL Server login with dbcreator or sysadmin.")">
                        @foreach (var (id, text) in _accounts)
                        {
                            <MudSelectItem T="Guid?" Value="@id">@text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (_agents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No VM has an agent that can @(_publish ? "publish" : "restore") SQL Server databases. Install the agent under Guest Agents; agents update themselves after a server update.</MudAlert>
            }
            @if (_accounts.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No account yet. Add a Windows credential or a SQL Server login under <MudLink Href="/infrastructure/credentials">Credentials</MudLink>.</MudAlert>
            }
            <div>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Cable" Disabled="@(_targetVm is null || _accountId is null || _checking)" OnClick="CheckTargetAsync">Connect</MudButton>
                @if (_checking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
                }
            </div>
            @if (_checkError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_checkError</MudAlert>
            }
            @if (_target is { } target)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_instance" Label="Instance" Variant="Variant.Outlined" Dense="true" Disabled="_overwrite"
                                   HelperText="@($"{target.Host} ({target.Address ?? "address unknown"}), as {target.Account}")">
                            @foreach (var i in target.Instances)
                            {
                                <MudSelectItem T="string" Value="@i.Name">@($"{i.Name} · {i.Product ?? i.SetupVersion ?? "SQL Server"}{(i.Connected ? "" : " · not connected")}")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="_name" Label="Database name" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" Disabled="_overwrite" />
                    </MudItem>
                </MudGrid>
                @if (_publish)
                {
                    <MudSelect T="int" @bind-Value="_publishHours" Label="Unpublish automatically after" Variant="Variant.Outlined" Dense="true"
                               HelperText="Or earlier with Unpublish in the session." Style="max-width:320px">
                        @foreach (var hours in new[] { 1, 2, 4, 8, 24, 72 })
                        {
                            <MudSelectItem T="int" Value="@hours">@(hours == 1 ? "1 hour" : $"{hours} hours")</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (_overwrite)
                {
                    <MudCheckBox T="bool" @bind-Value="_keepReplaced" Color="Color.Primary" Label="Keep the previous files (as *.bdfu-replaced beside the database's files)" />
                }
                else
                {
                    <MudRadioGroup T="string" @bind-Value="_fileLocation">
                        <MudRadio T="string" Value="@SqlRestoreFiles.Original" Color="Color.Primary">The folders of the files in the backup</MudRadio>
                        <MudRadio T="string" Value="@SqlRestoreFiles.Default" Color="Color.Primary">The instance's default folders</MudRadio>
                        <MudRadio T="string" Value="@SqlRestoreFiles.Folder" Color="Color.Primary">Other folders</MudRadio>
                    </MudRadioGroup>
                    @if (_fileLocation == SqlRestoreFiles.Folder)
                    {
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_dataFolder" Label="Folder for the data files" Placeholder="D:\SQL\Data" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_logFolder" Label="Folder for the log files" Placeholder="(the data folder)" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>
                    }
                    @if (Targets() is { } paths && _plan is not null)
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>In the backup</th><th>Restored as</th></tr></thead>
                            <tbody>
                                @foreach (var (file, path) in _plan.Files.Zip(paths))
                                {
                                    <tr><td class="mono">@file.Path</td><td class="mono">@path</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _open = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(_overwrite ? Color.Error : Color.Primary)" Disabled="@(_target is null || _instance is null || string.IsNullOrWhiteSpace(_name) || _starting)"
                   OnClick="StartAsync">@(_overwrite ? "Overwrite" : _publish ? "Publish" : "Restore")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    private SqlCatalogDatabaseDetailDto? _detail;
    private string? _error;
    private bool _latest = true;
    private string _timeText = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    private DateTimeOffset? _pointInTime;
    private double _slider;
    private string? _snapped;
    private DateTimeOffset? _dragging;
    private CancellationTokenSource? _settle;
    private SqlRestorePlanDto? _plan;
    private string? _planError;
    private bool _open;
    private bool _overwrite;
    private bool _keepReplaced;
    private bool _publish;
    private int _publishHours = 8;
    private List<AgentDto> _agents = [];
    private List<(Guid Id, string Text)> _accounts = [];
    private string? _targetVm;
    private Guid? _accountId;
    private SqlTargetDto? _target;
    private string? _instance;
    private string _name = string.Empty;
    private string _fileLocation = SqlRestoreFiles.Original;
    private string? _dataFolder;
    private string? _logFolder;
    private bool _checking;
    private string? _checkError;
    private bool _starting;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _detail = await Api.GetAsync<SqlCatalogDatabaseDetailDto>($"api/sql/databases/{Id}");
            if (_detail.Spans.Count > 0)
            {
                await SelectAsync(null);
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>A VM by its name (the select shows the value itself when the VM has no agent in the list, e.g. for an overwrite).</summary>
    private string VmLabel(string? vm) =>
        _agents.FirstOrDefault(a => a.VmNativeId == vm) is { } agent ? $"{agent.VmName ?? agent.HostName} ({agent.HostName}{(agent.Online ? "" : ", offline")})"
        : vm is not null && vm == _detail?.Database.VmNativeId ? _detail.Database.VmName
        : vm ?? string.Empty;

    private async Task DownloadAsync(SqlBackupFileDto full)
    {
        try
        {
            var ticket = await Api.PostAsync<FileDownloadTicketDto>($"api/sql/backup-sets/{full.Id}/link", new { });
            await JS.InvokeVoidAsync("bdfuDownload", ticket.Url);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private static string BaseText(string kind) => kind == "NativeFull" ? "the full backup" : "the SQL Server snapshot of the restore point";

    /// <summary>The restorable range: from the oldest span to the newest.</summary>
    private (DateTimeOffset From, DateTimeOffset To) Range() => (_detail!.Spans[0].FromUtc, _detail.Spans[^1].ToUtc);

    private DateTimeOffset? Selected() => _latest ? _detail?.Spans.LastOrDefault()?.ToUtc : _pointInTime;

    private static string PointText(string kind) => kind switch
    {
        "SnapshotFull" => "restore point with the SQL Server snapshot",
        "NativeFull" => "full backup",
        _ => "log backup",
    };

    /// <summary>While the slider moves, its time shows at once; the plan follows when it rests for a moment.</summary>
    private async Task OnSliderChanged(double seconds)
    {
        _slider = seconds;
        var (from, to) = Range();
        _dragging = from.AddSeconds(seconds);
        _settle?.Cancel();
        var settle = _settle = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, settle.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _dragging = null;
        await SelectAsync(seconds >= (to - from).TotalSeconds ? null : from.AddSeconds(seconds));
    }

    private string SelectedText(DateTimeOffset to) =>
        _dragging is { } moving ? moving.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
        : _latest ? $"latest ({to.ToLocalTime():yyyy-MM-dd HH:mm:ss})"
        : Selected() is { } shown ? shown.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) : "–";

    /// <summary>Full local hours (or every 2, 6, 12, 24 hours for longer ranges) for the axis.</summary>
    private static IEnumerable<DateTimeOffset> HourTicks(DateTimeOffset from, DateTimeOffset to)
    {
        var hours = (to - from).TotalHours;
        var step = hours <= 12 ? 1 : hours <= 24 ? 2 : hours <= 72 ? 6 : hours <= 168 ? 12 : 24;
        var local = from.ToLocalTime();
        var tick = new DateTimeOffset(local.Year, local.Month, local.Day, local.Hour, 0, 0, local.Offset).AddHours(1);
        while (tick.Hour % step != 0)
        {
            tick = tick.AddHours(1);
        }

        for (; tick < to; tick = tick.AddHours(step))
        {
            yield return tick;
        }
    }

    private Task JumpAsync(DateTimeOffset at) => SelectAsync(at);

    private Task LatestAsync() => SelectAsync(null);

    /// <summary>To the end of the previous or next backup (from the selected point).</summary>
    private Task StepAsync(int direction)
    {
        var current = Selected() ?? Range().To;
        var points = _detail!.Points.Select(p => p.FinishUtc).Distinct().OrderBy(p => p).ToList();
        var next = direction < 0 ? points.LastOrDefault(p => p < current.AddMilliseconds(-500)) : points.FirstOrDefault(p => p > current.AddMilliseconds(500));
        return next == default ? Task.CompletedTask : SelectAsync(next);
    }

    private async Task TypedAsync()
    {
        if (!DateTime.TryParseExact(_timeText.Trim(), ["yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm"], CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var local))
        {
            _planError = "Enter the time as yyyy-MM-dd HH:mm:ss (local time).";
            return;
        }

        await SelectAsync(new DateTimeOffset(local).ToUniversalTime());
    }

    /// <summary>Selects a point (null: the latest); a point in a gap or outside snaps to the nearest restorable time.</summary>
    private async Task SelectAsync(DateTimeOffset? at)
    {
        _snapped = null;
        var (from, to) = Range();
        if (at is null || at >= to)
        {
            _latest = true;
            _pointInTime = null;
            if (at > to)
            {
                _snapped = $"No backup reaches further than {Fmt.Time(to)} yet: the latest point is chosen.";
            }
        }
        else
        {
            var chosen = at.Value < from ? from : at.Value;
            if (_detail!.Gaps.FirstOrDefault(g => g.FromUtc < chosen && chosen < g.ToUtc) is { } gap)
            {
                var nearer = chosen - gap.FromUtc <= gap.ToUtc - chosen ? gap.FromUtc : gap.ToUtc;
                _snapped = $"{chosen.ToLocalTime():HH:mm:ss} is not covered ({gap.Reason}); moved to {nearer.ToLocalTime():HH:mm:ss}.";
                chosen = nearer;
            }
            else if (at.Value < from)
            {
                _snapped = $"The oldest restorable point is {Fmt.Time(from)}.";
            }

            _latest = chosen >= to;
            // Exact: the end of a backup keeps its milliseconds (cutting them off would land before it).
            _pointInTime = _latest ? null : chosen.ToUniversalTime();
        }

        var selected = Selected() ?? to;
        _slider = Math.Clamp((selected - from).TotalSeconds, 0, (to - from).TotalSeconds);
        _timeText = selected.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
        await PlanAsync();
    }

    private async Task PlanAsync()
    {
        _plan = null;
        _planError = null;
        var query = _latest || _pointInTime is null ? string.Empty : "?at=" + Uri.EscapeDataString(_pointInTime.Value.ToString("O", CultureInfo.InvariantCulture));
        try
        {
            _plan = await Api.GetAsync<SqlRestorePlanDto>($"api/sql/databases/{Id}/plan{query}");
        }
        catch (ApiException ex)
        {
            _planError = ex.Message;
        }
    }

    private async Task OpenAsync(bool overwrite, bool publish = false)
    {
        if (_detail is null)
        {
            return;
        }

        _overwrite = overwrite;
        _publish = publish;
        _target = null;
        _checkError = null;
        _instance = overwrite ? _detail.Database.Instance : null;
        _name = overwrite ? _detail.Database.Name : publish ? $"{_detail.Database.Name}_published" : $"{_detail.Database.Name}_restored";
        try
        {
            _agents = [.. (await Api.GetAsync<List<AgentDto>>("api/agents")).Where(a => (publish ? a.CanPublishSql : a.CanRestoreSql) && a.VmNativeId is not null).OrderBy(a => a.VmName ?? a.HostName)];
            var windows = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
            var logins = await Api.GetAsync<List<SqlCredentialDto>>("api/credentials/sql");
            _accounts = [.. windows.Select(c => (c.Id, $"{c.UserName} (Windows)")), .. logins.Select(c => (c.Id, $"{c.UserName} (SQL login)"))];
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        _targetVm = overwrite ? _detail.Database.VmNativeId : _agents.FirstOrDefault(a => a.VmNativeId == _detail.Database.VmNativeId)?.VmNativeId ?? _agents.FirstOrDefault()?.VmNativeId;
        _accountId ??= _accounts.Count == 1 ? _accounts[0].Id : null;
        _open = true;
    }

    private void OnTargetVmChanged(string? vm)
    {
        _targetVm = vm;
        _target = null;
    }

    private void OnAccountChanged(Guid? account)
    {
        _accountId = account;
        _target = null;
    }

    private async Task CheckTargetAsync()
    {
        if (_targetVm is null || _accountId is null)
        {
            return;
        }

        _checking = true;
        _checkError = null;
        try
        {
            _target = await Api.PostAsync<SqlTargetDto>("api/sql/inventory", new SqlInventoryRequestDto(_targetVm, _accountId, null));
            _instance ??= _target.Instances.FirstOrDefault(i => i.Connected && string.Equals(i.Name, _detail?.Database.Instance, StringComparison.OrdinalIgnoreCase))?.Name
                ?? _target.Instances.FirstOrDefault(i => i.Connected)?.Name;
        }
        catch (ApiException ex)
        {
            _checkError = ex.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private IReadOnlyList<string>? Targets()
    {
        var instance = _target?.Instances.FirstOrDefault(i => i.Name == _instance);
        if (_plan is null || _plan.Files.Count == 0 || string.IsNullOrWhiteSpace(_name))
        {
            return null;
        }

        try
        {
            return SqlRestoreFiles.TargetPaths(_name.Trim(), [.. _plan.Files.Select(f => (f.Path, f.Kind))], _fileLocation, _dataFolder, _logFolder, instance?.DefaultDataFolder, instance?.DefaultLogFolder);
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    private async Task StartAsync()
    {
        if (_detail is null || _targetVm is null || _accountId is null || _instance is null)
        {
            return;
        }

        _starting = true;
        try
        {
            var started = _publish
                ? await Api.PostAsync<StartedDto>("api/sql/publishes", new SqlPublishRequestDto(
                    Guid.Empty, _detail.Database.Instance, _detail.Database.Name, _targetVm, _instance, _accountId.Value, _name.Trim(), _publishHours * 60,
                    Id, _latest ? null : _pointInTime))
                : await Api.PostAsync<StartedDto>("api/sql/restores", new SqlRestoreRequestDto(
                    Guid.Empty, _detail.Database.Instance, _detail.Database.Name, _targetVm, _instance, _accountId.Value, _name.Trim(), _fileLocation, _dataFolder, _logFolder,
                    _overwrite, _keepReplaced, Id, _latest ? null : _pointInTime));
            _open = false;
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _starting = false;
        }
    }
}
