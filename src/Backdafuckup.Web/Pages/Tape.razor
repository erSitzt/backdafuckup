    private void Choose(string? choice)
    {
        _choice = choice;
        _mapping = [];
        if (_scan?.Changers.FirstOrDefault(c => c.Changer.Serial == choice) is { } changer)
        {
            foreach (var element in changer.Drives)
            {
                _mapping[element.Element] = element.Serial;
            }

            if (string.IsNullOrWhiteSpace(_name))
            {
                _name = changer.Changer.Product;
            }
        }
        else if (_scan?.StandaloneDrives.FirstOrDefault(d => "drive:" + d.Serial == choice) is { } drive && string.IsNullOrWhiteSpace(_name))
        {
            _name = $"{drive.Product} {drive.Serial}";
        }
    }

    /// <summary>Drives a changer element can be mapped to: those the scan found and no library has yet.</summary>
    private IEnumerable<string> DriveSerials() =>
        (_scan?.Changers.SelectMany(c => c.Drives).Select(d => d.Serial) ?? [])
            .Concat(_scan?.StandaloneDrives.Where(d => d.Library is null).Select(d => (string?)d.Serial) ?? [])
            .OfType<string>()
            .Distinct()
            .Order(StringComparer.Ordinal);

    private async Task AddAsync()
    {
        if (_choice is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var request = _choice.StartsWith("drive:", StringComparison.Ordinal)
                ? new CreateTapeLibraryDto(_name.Trim(), _host, null, [new TapeDriveMappingDto(_choice["drive:".Length..], null, null)])
                : new CreateTapeLibraryDto(_name.Trim(), _host, _choice, _mapping.Where(m => m.Value is not null).Select(m => new TapeDriveMappingDto(m.Value!, m.Key, null)).ToList());
            var created = await Api.PostAsync<TapeLibraryDto>("api/tape/libraries", request);
            Snackbar.Add($"{created.Name} added: {created.Media} cartridge(s).", created.LastError is null ? Severity.Success : Severity.Warning);
            _adding = false;
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
