    private async Task CopySecretAsync()
    {
        if (_agentSecret is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _agentSecret.EnvironmentFile);
            Snackbar.Add("Copied.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("The browser did not allow copying; select the text instead.", Severity.Warning);
        }
    }

