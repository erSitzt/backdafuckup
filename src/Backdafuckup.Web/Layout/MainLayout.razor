@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Navigation
@inject ApiClient Api

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!Auth.Initialized)
{
    <div class="boot">
        <img src="img/backdafuckup-banner-512x128.png" alt="backdafuckup" width="512" height="128" />
        <span>Connecting to the backup server…</span>
    </div>
}
else if (Auth.SetupRequired)
{
    <SetupForm />
}
else if (Auth.User is null)
{
    <LoginForm />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <a href="/" class="ml-1" title="Dashboard"><img src="img/backdafuckup-banner-512x128.png" alt="backdafuckup" class="appbar-logo" /></a>
            <MudSpacer />
            @if (_about is { } about)
            {
                <MudTooltip Text="@($"backdafuckup {about.Version}{(about.Commit is null ? "" : $", commit {about.Commit}")}{(about.BuildUtc is { } built ? $", built {built.ToLocalTime():g}" : "")}")">
                    <MudLink Href="/about" Typo="Typo.caption" Color="Color.Inherit" Class="mr-4" Style="opacity:0.75">v@(about.Version)</MudLink>
                </MudTooltip>
            }
            <MudText Typo="Typo.body2" Class="mr-2">@Auth.User.UserName</MudText>
            <MudTooltip Text="Sign out">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
            </MudTooltip>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                <TapeRequestsBanner />
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private AboutDto? _about;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#00704a",
            Secondary = "#37474f",
            // Black like the background of the logo images.
            AppbarBackground = "#000000",
            DrawerBackground = "#f7f8f8",
            Background = "#f5f6f7",
            TableLines = "#eceff1",
            Info = "#1e88e5",
            Success = "#2e7d32",
            Warning = "#ef6c00",
            Error = "#d32f2f",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" },
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        await Auth.InitializeAsync();
    }

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        await LoadAboutAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync() => await LoadAboutAsync();

    /// <summary>The server's version, once signed in (the API needs a session).</summary>
    private async Task LoadAboutAsync()
    {
        if (_about is not null || Auth.User is null)
        {
            return;
        }

        try
        {
            _about = await Api.GetAsync<AboutDto>("api/about");
        }
        catch (ApiException)
        {
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
