<Project>
  <!-- Central package management. Keep THIRD-PARTY-NOTICES.md in sync when adding packages. -->
  <ItemGroup Label="Runtime">
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="Polly.Core" Version="8.9.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <!-- Guest agent (netstandard2.0 / net48 / net10.0-windows) -->
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
    <PackageVersion Include="System.Management" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Microsoft.Data.SqlClient 7.1.1 brings 9.0.18, which has advisories GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <!-- iSCSI target for publishing restore points into a guest (LGPL-3.0-or-later, unmodified libraries). -->
    <PackageVersion Include="ISCSI" Version="1.5.6" />
    <PackageVersion Include="DiskAccessLibrary" Version="1.6.6" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- Push installation of the guest agent (SMB 2/3 client, LGPL-3.0) -->
    <PackageVersion Include="SMBLibrary" Version="1.5.8.1" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- File-level restore: partitions and file systems (MIT). The ext and XFS providers are vendored and patched
         in src/ThirdParty (see their NOTICE.md); keep their upstream commit in step with these versions. -->
    <PackageVersion Include="LTRData.DiscUtils.Core" Version="1.0.90" />
    <PackageVersion Include="LTRData.DiscUtils.Streams" Version="1.0.90" />
    <PackageVersion Include="LTRData.DiscUtils.Ntfs" Version="1.0.90" />
    <PackageVersion Include="LTRData.DiscUtils.Fat" Version="1.0.90" />
    <PackageVersion Include="LTRData.DiscUtils.Lvm" Version="1.0.90" />
    <PackageVersion Include="LTRData.DiscUtils.Registry" Version="1.0.90" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
