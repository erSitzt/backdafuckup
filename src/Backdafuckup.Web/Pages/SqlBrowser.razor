@page "/sql/{RestorePointId:guid}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>Restore SQL databases – backdafuckup</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAsync" StartIcon="@Icons.Material.Filled.Storage">Open again</MudButton>
    <MudButton Variant="Variant.Text" Href="/backups" Class="ml-2">Back to backups</MudButton>
}
else if (_mount is null || _sql is null)
{
    <MudText Typo="Typo.h5" Class="mb-2">Restore SQL databases</MudText>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    <MudText Typo="Typo.body2">Opening the restore point: reading partitions, file systems and the SQL Server configuration…</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">SQL Server: @_mount.VmName</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@_mount.RestorePointCreatedUtc.ToLocalTime().ToString("g")</MudChip>
        <ConsistencyChip Consistency="@_mount.Consistency" Reason="@_mount.ConsistencyReason" />
        <MudSpacer />
        <MudText Typo="Typo.caption">Closes after @_mount.IdleTimeoutMinutes minutes without use.</MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CloseAsync" StartIcon="@Icons.Material.Filled.Close">Close</MudButton>
    </MudStack>

    @foreach (var warning in _mount.Warnings.Concat(_sql.Warnings))
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@warning</MudAlert>
    }

    @if (_sql.Databases.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-2">
            This restore point lists no SQL Server databases. They are recorded when the VM is backed up with guest processing
            (backdafuckup agent in the VM) and SQL Server's VSS writer (service "SQL Server VSS Writer") is running.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-2" Elevation="1" Style="min-height:60vh;overflow:auto">
                    @* MudBlazor 9 renders Items only through an ItemTemplate. *@
                    <MudTreeView T="string" Items="_tree" SelectedValue="_selected" SelectedValueChanged="OnSelected" Dense="true" Hover="true">
                        <ItemTemplate>
                            <MudTreeViewItem T="string" Value="@context.Value" Text="@context.Text" Icon="@context.Icon" @bind-Items="context.Children"
                                             CanExpand="@context.Expandable" @bind-Expanded="@context.Expanded" />
                        </ItemTemplate>
                    </MudTreeView>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="9">
                <MudPaper Class="pa-3" Elevation="1" Style="min-height:60vh">
                    @if (SelectedDatabase is { } db)
                    {
                        var instance = InstanceOf(db.Instance);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" />
                            <MudText Typo="Typo.h6">@db.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@db.Instance@(instance?.Product is { } product ? $" · {product}" : "")</MudText>
                            <ConsistencyChip Consistency="@db.Consistency" Reason="@db.ConsistencyReason" />
                            <MudSpacer />
                            <MudTooltip Text="Attach the database from the backup to an instance, without copying it, e.g. to take tables or rows out of it. Unpublish removes it again.">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link"
                                           Disabled="@(!db.Restorable || !CanExport(db))" OnClick="@(() => OpenPublishAsync(db, restore: false))">Publish</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Copy the database files into a VM under new names and attach them as a new database, on the original or another instance.">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                                           Disabled="@(!db.Restorable || !CanExport(db))" OnClick="@(() => OpenPublishAsync(db, restore: true))">Restore</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="The database files as they are in the backup, plus a script that attaches them to an instance.">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderZip"
                                           Disabled="@(!CanExport(db) || _preparing)" OnClick="@(() => ExportFilesAsync(db))">Export files</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory2"
                                           Disabled="@(!db.Restorable || !CanExport(db))" OnClick="@(() => OpenPublishAsync(db, restore: false, export: true))">Export .bak</MudButton>
                            </MudTooltip>
                        </MudStack>

                        @if (!db.Restorable)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                <b>Cannot be restored:</b>
                                <ul class="ml-4">
                                    @foreach (var problem in db.Problems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                            </MudAlert>
                        }

                        @if (db.Consistency != "application")
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                The database files are crash-consistent@(db.ConsistencyReason is { } reason ? $" ({reason})" : "").
                                SQL Server recovers them when they are attached, like after a power failure.
                            </MudAlert>
                        }

                        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                            <thead><tr><th>File</th><th>Type</th><th style="text-align:right">Size</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var file in db.Files)
                                {
                                    <tr>
                                        <td><span class="mono">@file.Path</span></td>
                                        <td>
                                            @(file.Kind switch { "data" => file.Primary ? "data (primary)" : "data", "log" => "log", _ => "other" })
                                        </td>
                                        <td style="text-align:right">@(file.SizeBytes is { } size ? Fmt.Bytes(size) : "")</td>
                                        <td>
                                            @if (file.Problem is not null)
                                            {
                                                <MudTooltip Text="@file.Problem">
                                                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" />
                                                </MudTooltip>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudText Typo="Typo.caption" Class="mt-2">@db.Files.Count file(s), @Fmt.Bytes(db.TotalBytes) in the backup.</MudText>
                    }
                    else if (SelectedInstance is { } inst)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Dns" />
                            <MudText Typo="Typo.h6">@inst.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@(inst.Product ?? "SQL Server")</MudText>
                        </MudStack>
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                <tr><td>Version</td><td>@(inst.Version ?? "unknown")</td></tr>
                                <tr><td>Edition</td><td>@(inst.Edition ?? "unknown")</td></tr>
                                <tr><td>Instance id</td><td class="mono">@inst.InstanceId</td></tr>
                                <tr><td>Service</td><td class="mono">@inst.ServiceName@(inst.ServiceAccount is { } account ? $" ({account})" : "")</td></tr>
                                <tr><td>Default data folder</td><td class="mono">@inst.DefaultDataFolder</td></tr>
                                <tr><td>Default log folder</td><td class="mono">@inst.DefaultLogFolder</td></tr>
                                <tr><td>Backup folder</td><td class="mono">@inst.BackupFolder</td></tr>
                                <tr><td>Databases</td><td>@_sql.Databases.Count(d => string.Equals(d.Instance, inst.Name, StringComparison.OrdinalIgnoreCase))</td></tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudText Typo="Typo.caption" Class="mt-2">As recorded in the registry of the backed-up VM.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="pa-4">Choose an instance or a database on the left.</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
}

<MudDialog @bind-Visible="_publishOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_exportMode ? $"Export {_publishDb?.Name} as .bak" : _restoreMode ? (_overwrite ? $"Overwrite {_publishDb?.Name} with the restore point" : $"Restore {_publishDb?.Name} as a new database") : $"Publish {_publishDb?.Name}")</MudText>
        <MudText Typo="Typo.body2">
            @_publishDb?.Instance on @_mount?.VmName, restore point of @_mount?.RestorePointCreatedUtc.ToLocalTime().ToString("g") ·
            @(_publishDb is null ? "" : Fmt.Bytes(_publishDb.TotalBytes))
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_restoreMode)
            {
                <MudRadioGroup T="bool" Value="_overwrite" ValueChanged="OnOverwriteChanged">
                    <MudRadio T="bool" Value="false" Color="Color.Primary">As a new database (the original stays as it is)</MudRadio>
                    <MudRadio T="bool" Value="true" Color="Color.Error">Overwrite the original database in @_mount?.VmName</MudRadio>
                </MudRadioGroup>
                @if (_overwrite)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        The database goes offline for the swap: open connections are dropped and their transactions rolled back. Everything
                        written since the restore point is lost. The restored files are written beside the database's own first; if the
                        database does not come online with them, it gets its own files back. Owner, users and settings stay.
                    </MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        The agent in the target VM writes the database files under new names (never over existing files), checks them
                        against the backup and attaches them to an instance there. The database in the backup and existing databases stay as they are.
                    </MudText>
                }
            }
            else if (_exportMode)
            {
                <MudText Typo="Typo.body2">
                    The database is published on an instance in the target VM (read from the backup, nothing is copied), backed up there
                    copy-only with checksums into a .bak, verified with RESTORE VERIFYONLY, and unpublished again. Choose an instance of
                    the same or a newer SQL Server version; the original VM works too (the database gets the name <i>name</i>_bdfu_export if
                    its own name is taken there).
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    The agent in the target VM mounts the backup's volumes (read from the backup, nothing is copied) and attaches the
                    database to an instance there. Changes go to a temporary overlay in the VM and are discarded when it is unpublished.
                </MudText>
            }
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="_targetVm" ValueChanged="OnTargetVmChanged" Label="Target VM" Variant="Variant.Outlined" Dense="true" Disabled="_overwrite"
                               HelperText="@(_restoreMode ? "VMs whose agent can restore SQL Server databases." : "VMs whose agent can publish SQL Server databases.")">
                        @foreach (var a in _publishAgents)
                        {
                            <MudSelectItem T="string" Value="@a.VmNativeId">@($"{a.VmName ?? a.HostName} ({a.HostName}{(a.Online ? "" : ", offline")})")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" Value="_accountId" ValueChanged="OnAccountChanged" Label="Account" Variant="Variant.Outlined" Dense="true"
                               HelperText="A Windows account or a SQL Server login with dbcreator or sysadmin on the instance.">
                        @foreach (var (id, text) in _accounts)
                        {
                            <MudSelectItem T="Guid?" Value="@id">@text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (_publishAgents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No VM has an agent that can @(_restoreMode ? "restore" : "publish") SQL Server databases. Install the agent under Guest Agents; agents update themselves after a server update.</MudAlert>
            }
            @if (_accounts.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No account yet. Add a Windows credential or a SQL Server login under <MudLink Href="/infrastructure/credentials">Credentials</MudLink>.</MudAlert>
            }
            <div>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Cable" Disabled="@(_targetVm is null || _accountId is null || _checking)"
                           OnClick="CheckTargetAsync">Connect</MudButton>
                @if (_checking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
                }
            </div>
            @if (_checkError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_checkError</MudAlert>
            }
            @if (_targetSql is { } target)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Value="_targetInstance" ValueChanged="OnInstanceChanged" Label="Instance" Variant="Variant.Outlined" Dense="true" Disabled="_overwrite"
                                   HelperText="@($"{target.Host} ({target.Address ?? "address unknown"}), as {target.Account}")">
                            @foreach (var i in target.Instances)
                            {
                                <MudSelectItem T="string" Value="@i.Name">@($"{i.Name} · {i.Product ?? i.SetupVersion ?? "SQL Server"}{(i.Connected ? "" : " · not connected")}")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    @if (_exportMode)
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_exportFolder" Label="Folder for the .bak (in the VM)" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense"
                                          Placeholder="@(TargetInstance?.BackupFolder ?? "the instance's backup folder")"
                                          HelperText="Empty: the instance's backup folder. SQL Server's service must be able to write there." />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_publishName" Label="Database name" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense"
                                          Disabled="_overwrite" HelperText="@(_overwrite ? "The database that is overwritten." : "Must not exist on the instance.")" />
                        </MudItem>
                    }
                    @if (!_restoreMode && !_exportMode)
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" @bind-Value="_publishHours" Label="Unpublish automatically after" Variant="Variant.Outlined" Dense="true"
                                       HelperText="Or earlier with Unpublish in the session.">
                                @foreach (var hours in new[] { 1, 2, 4, 8, 24, 72 })
                                {
                                    <MudSelectItem T="int" Value="@hours">@(hours == 1 ? "1 hour" : $"{hours} hours")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>
                @if (_exportMode)
                {
                    <MudCheckBox T="bool" @bind-Value="_exportDownload" Color="Color.Primary" Label="Also keep it on the backup server for download (24 hours)" />
                }
                @if (_restoreMode && _overwrite)
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>File of the database (replaced)</th><th style="text-align:right">Now</th><th style="text-align:right">In the backup</th></tr></thead>
                        <tbody>
                            @foreach (var file in RestoreFilesOrdered())
                            {
                                var now = LiveDatabase?.Files.FirstOrDefault(f => string.Equals(f.PhysicalName, file.Path, StringComparison.OrdinalIgnoreCase));
                                <tr><td class="mono">@file.Path</td><td style="text-align:right">@(now is null ? "missing" : Fmt.Bytes(now.SizeBytes))</td><td style="text-align:right">@(file.SizeBytes is { } size ? Fmt.Bytes(size) : "")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudCheckBox T="bool" @bind-Value="_keepReplaced" Color="Color.Primary" Label="Keep the previous files (as *.bdfu-replaced beside the database's files)" />
                }
                else if (_restoreMode)
                {
                    <MudRadioGroup T="string" @bind-Value="_fileLocation">
                        <MudRadio T="string" Value="@SqlRestoreFiles.Original" Color="Color.Primary">The folders of the files in the backup</MudRadio>
                        <MudRadio T="string" Value="@SqlRestoreFiles.Default" Color="Color.Primary">
                            The instance's default folders@(TargetInstance is { } ti ? $" ({ti.DefaultDataFolder ?? "none"}, {ti.DefaultLogFolder ?? ti.DefaultDataFolder ?? "none"})" : "")
                        </MudRadio>
                        <MudRadio T="string" Value="@SqlRestoreFiles.Folder" Color="Color.Primary">Other folders</MudRadio>
                    </MudRadioGroup>
                    @if (_fileLocation == SqlRestoreFiles.Folder)
                    {
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="_dataFolder" Label="Folder for the data files" Placeholder="D:\SQL\Data" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="_logFolder" Label="Folder for the log files" Placeholder="(the data folder)" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    }
                    @if (RestoreTargets() is { Paths: { } paths })
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>In the backup</th><th>Restored as</th><th style="text-align:right">Size</th></tr></thead>
                            <tbody>
                                @foreach (var (file, path) in RestoreFilesOrdered().Zip(paths))
                                {
                                    <tr><td class="mono">@file.Path</td><td class="mono">@path</td><td style="text-align:right">@(file.SizeBytes is { } size ? Fmt.Bytes(size) : "")</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
                @foreach (var (severity, text) in PublishChecks())
                {
                    <MudAlert Severity="@severity" Dense="true">@text</MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _publishOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_restoreMode ? Icons.Material.Filled.SettingsBackupRestore : Icons.Material.Filled.Link)"
                   Disabled="@(!CanPublish || _starting)" OnClick="PublishAsync">@(_exportMode ? "Export" : _restoreMode ? (_overwrite ? "Overwrite" : "Restore") : "Publish")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const char Separator = '\u0001';

    [Parameter]
    public Guid RestorePointId { get; set; }

    private FileMountDto? _mount;
    private SqlMountDto? _sql;
    private string? _error;
    private List<TreeItemData<string>> _tree = [];
    private string? _selected;
    private bool _closed;
    private bool _preparing;

    private bool _publishOpen;
    private bool _restoreMode;
    private bool _exportMode;
    private string? _exportFolder;
    private bool _exportDownload = true;
    private bool _overwrite;
    private bool _keepReplaced;
    private string _fileLocation = SqlRestoreFiles.Original;
    private string? _dataFolder;
    private string? _logFolder;
    private SqlDatabaseDto? _publishDb;
    private List<AgentDto> _publishAgents = [];
    private List<(Guid Id, string Text)> _accounts = [];
    private string? _targetVm;
    private Guid? _accountId;
    private SqlTargetDto? _targetSql;
    private string? _targetInstance;
    private string _publishName = string.Empty;
    private int _publishHours = 8;
    private bool _checking;
    private bool _starting;
    private string? _checkError;

    private SqlTargetInstanceDto? TargetInstance =>
        _targetSql?.Instances.FirstOrDefault(i => string.Equals(i.Name, _targetInstance, StringComparison.OrdinalIgnoreCase));

    /// <summary>Overwrite: the database as it is now on the original instance.</summary>
    private SqlTargetDatabaseDto? LiveDatabase =>
        TargetInstance?.Databases.FirstOrDefault(d => string.Equals(d.Name, _publishDb?.Name, StringComparison.OrdinalIgnoreCase));

    /// <summary>Overwrite works only on the original database: the target is fixed to its VM, instance and name.</summary>
    private void OnOverwriteChanged(bool overwrite)
    {
        _overwrite = overwrite;
        _checkError = null;
        if (overwrite && _publishDb is not null)
        {
            if (_targetVm != _mount?.VmNativeId)
            {
                _targetVm = _publishAgents.FirstOrDefault(a => a.VmNativeId == _mount?.VmNativeId)?.VmNativeId;
                _targetSql = null;
            }

            if (_targetSql is not null)
            {
                _targetInstance = _publishDb.Instance;
            }

            _publishName = _publishDb.Name;
        }
        else
        {
            OnInstanceChanged(_targetInstance);
        }
    }

    private async Task OpenPublishAsync(SqlDatabaseDto db, bool restore, bool export = false)
    {
        _restoreMode = restore;
        _exportMode = export;
        _exportFolder = null;
        _overwrite = false;
        _keepReplaced = false;
        _publishDb = db;
        _targetSql = null;
        _checkError = null;
        _targetInstance = null;
        _publishName = db.Name;
        try
        {
            _publishAgents = [.. (await Api.GetAsync<List<AgentDto>>("api/agents"))
                .Where(a => (restore ? a.CanRestoreSql : a.CanPublishSql) && a.VmNativeId is not null).OrderBy(a => a.VmName ?? a.HostName)];
            var windows = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
            var logins = await Api.GetAsync<List<SqlCredentialDto>>("api/credentials/sql");
            _accounts = [.. windows.Select(c => (c.Id, $"{c.UserName} (Windows)")), .. logins.Select(c => (c.Id, $"{c.UserName} (SQL login)"))];
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        _targetVm = _publishAgents.FirstOrDefault(a => a.VmNativeId == _mount?.VmNativeId)?.VmNativeId ?? _publishAgents.FirstOrDefault()?.VmNativeId;
        _accountId ??= _accounts.Count == 1 ? _accounts[0].Id : null;
        if (_accountId is { } chosen && _accounts.All(a => a.Id != chosen))
        {
            _accountId = null;
        }

        _publishOpen = true;
    }

    private void OnTargetVmChanged(string? vm)
    {
        _targetVm = vm;
        _targetSql = null;
        _checkError = null;
    }

    private void OnAccountChanged(Guid? account)
    {
        _accountId = account;
        _targetSql = null;
        _checkError = null;
    }

    /// <summary>What the agent finds with the account: the instances, the account's rights and the databases there.</summary>
    private async Task CheckTargetAsync()
    {
        if (_targetVm is null || _accountId is null || _publishDb is null)
        {
            return;
        }

        _checking = true;
        _checkError = null;
        _targetSql = null;
        try
        {
            _targetSql = await Api.PostAsync<SqlTargetDto>("api/sql/inventory", new SqlInventoryRequestDto(_targetVm, _accountId, null));
            var connected = _targetSql.Instances.Where(i => i.Connected).ToList();
            var instance = connected.FirstOrDefault(i => string.Equals(i.Name, _publishDb.Instance, StringComparison.OrdinalIgnoreCase)) ?? connected.FirstOrDefault() ?? _targetSql.Instances.FirstOrDefault();
            OnInstanceChanged(instance?.Name);
        }
        catch (ApiException ex)
        {
            _checkError = ex.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    /// <summary>Proposes the original name, or name_published (name_published2, …) if the instance has it already.</summary>
    private void OnInstanceChanged(string? instance)
    {
        _targetInstance = _overwrite && _publishDb is not null ? _publishDb.Instance : instance;
        if (_publishDb is null)
        {
            return;
        }

        if (_overwrite)
        {
            _publishName = _publishDb.Name;
            return;
        }

        var taken = TargetInstance?.Databases.Select(d => d.Name).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];
        var name = _publishDb.Name;
        var suffix = _restoreMode ? "_restored" : "_published";
        for (var n = 1; taken.Contains(name); n++)
        {
            name = n == 1 ? _publishDb.Name + suffix : $"{_publishDb.Name}{suffix}{n}";
        }

        _publishName = name;
    }

    private static int? Major(string? version) =>
        version?.Split('.') is [var first, ..] && int.TryParse(first, out var major) ? major : null;

    /// <summary>What speaks against the publish (errors) and what the admin should know (warnings, notes).</summary>
    private List<(Severity Severity, string Text)> PublishChecks()
    {
        var checks = new List<(Severity, string)>();
        if (_publishDb is not { } db || TargetInstance is not { } target || _targetSql is null)
        {
            return checks;
        }

        if (!target.Connected)
        {
            checks.Add((Severity.Error, $"{_targetSql.Account} cannot connect to instance {target.Name}: {target.ConnectError ?? "unknown error"}"));
            return checks;
        }

        var name = _publishName.Trim();
        if (_restoreMode && _overwrite)
        {
            if (_targetVm != _mount?.VmNativeId)
            {
                checks.Add((Severity.Error, $"Only the original database in {_mount?.VmName} can be overwritten; its agent cannot restore SQL Server databases (yet)."));
            }

            if (target.IsSysadmin != true)
            {
                checks.Add((Severity.Error, $"{target.LoginName ?? _targetSql.Account} is not sysadmin on instance {target.Name}; overwriting a database needs sysadmin."));
            }

            if (LiveDatabase is not { } live)
            {
                checks.Add((Severity.Error, $"Instance {target.Name} has no database {name} to overwrite; restore it as a new database."));
            }
            else
            {
                var now = live.Files.Select(f => f.PhysicalName).ToList();
                var backup = db.Files.Select(f => f.Path).ToList();
                if (now.Count != backup.Count || now.Except(backup, StringComparer.OrdinalIgnoreCase).Any())
                {
                    checks.Add((Severity.Error, $"The database's files are not the ones in the backup (now: {string.Join(", ", now)}); restore it as a new database instead."));
                }
            }
        }
        else if (_exportMode)
        {
            if (target.IsSysadmin != true && target.IsDbCreator != true)
            {
                checks.Add((Severity.Error, $"{target.LoginName ?? _targetSql.Account} may not create databases on instance {target.Name}; it needs the server role dbcreator or sysadmin."));
            }

            var exportFolder = _exportFolder?.Trim();
            if (!string.IsNullOrEmpty(exportFolder) && !(exportFolder.Length >= 2 && char.IsAsciiLetter(exportFolder[0]) && exportFolder[1] == ':' && (exportFolder.Length == 2 || exportFolder[2] == '\\')))
            {
                checks.Add((Severity.Error, $"'{exportFolder}' is not a local folder in the VM; enter it as D:\\Backup."));
            }

            // The server picks the staging name the same way.
            var staging = db.Name;
            for (var n = 1; target.Databases.Any(d => string.Equals(d.Name, staging, StringComparison.OrdinalIgnoreCase)); n++)
            {
                staging = n == 1 ? db.Name + "_bdfu_export" : $"{db.Name}_bdfu_export{n}";
            }

            if (staging != db.Name)
            {
                checks.Add((Severity.Info, $"Instance {target.Name} has a database {db.Name} already: the database is published there as {staging}, " +
                    $"and the .bak contains it under that name. Choose an instance without {db.Name} to keep its name in the .bak."));
            }
        }
        else
        {
            if (target.IsSysadmin != true && target.IsDbCreator != true)
            {
                checks.Add((Severity.Error, $"{target.LoginName ?? _targetSql.Account} may not create databases on instance {target.Name}; it needs the server role dbcreator or sysadmin."));
            }

            if (name.Length is 0 or > 128)
            {
                checks.Add((Severity.Error, "Enter a database name (at most 128 characters)."));
            }
            else if (target.Databases.Any(d => string.Equals(d.Name, name, StringComparison.OrdinalIgnoreCase)))
            {
                checks.Add((Severity.Error, $"Instance {target.Name} has a database {name} already; choose another name."));
            }
        }

        var source = InstanceOf(db.Instance);
        var sourceMajor = Major(source?.Version);
        var targetMajor = Major(target.ProductVersion ?? target.SetupVersion);
        if (sourceMajor is { } from && targetMajor is { } to)
        {
            if (to < from)
            {
                checks.Add((Severity.Error, $"The database comes from {source?.Product ?? "a newer SQL Server"}; instance {target.Name} is {target.Product ?? "older"}. SQL Server attaches databases only on the same or a newer version."));
            }
            else if (to > from)
            {
                checks.Add((Severity.Info, _exportMode
                    ? $"{target.Product} upgrades the database from {source?.Product} when it attaches it: the .bak can then be restored only on {target.Product} or newer. Use an instance of {source?.Product} for a .bak of the original version."
                    : $"{target.Product} upgrades the database from {source?.Product} when it attaches it; the upgrade lands in the overlay, the backup stays as it is."));
            }
        }

        var dataBytes = db.Files.Where(f => f.Kind == "data").Sum(f => f.SizeBytes ?? 0);
        if (target.EngineEdition == 4)
        {
            var limit = (targetMajor ?? 0) >= 17 ? 50L << 30 : 10L << 30;
            if (dataBytes > limit)
            {
                checks.Add((Severity.Error, $"Instance {target.Name} is SQL Server Express: databases up to {Fmt.Bytes(limit)}; this one has {Fmt.Bytes(dataBytes)} of data files."));
            }
        }

        if (db.Consistency != "application")
        {
            checks.Add((Severity.Info, "The database is crash-consistent in this restore point; SQL Server recovers it when it attaches it, like after a power failure."));
        }

        var host = _publishAgents.FirstOrDefault(a => a.VmNativeId == _targetVm)?.HostName ?? "the VM";
        if (_restoreMode)
        {
            var (paths, error) = _overwrite ? ((IReadOnlyList<string>?)RestoreFilesOrdered().Select(f => f.Path).ToList(), (string?)null) : RestoreTargets();
            if (error is not null)
            {
                checks.Add((Severity.Error, error));
            }
            else if (paths is not null)
            {
                foreach (var drive in RestoreFilesOrdered().Zip(paths).GroupBy(f => f.Second[..3], StringComparer.OrdinalIgnoreCase))
                {
                    var needed = drive.Sum(f => f.First.SizeBytes ?? 0);
                    var volume = _targetSql.Volumes.FirstOrDefault(v => string.Equals(v.Root, drive.Key, StringComparison.OrdinalIgnoreCase));
                    if (volume is null)
                    {
                        checks.Add((Severity.Error, $"{drive.Key} is not a local fixed volume of {host}."));
                    }
                    else if (volume.FreeBytes < needed + (512L << 20))
                    {
                        checks.Add((Severity.Error, $"{drive.Key} on {host} has {Fmt.Bytes(volume.FreeBytes)} free; the files need {Fmt.Bytes(needed)} (512 MB stay free)."));
                    }
                }
            }

            checks.Add((Severity.Normal, _overwrite
                ? "The restored files need the space of the database once more until the previous files are deleted."
                : "Existing files are never replaced: if a file of that name exists, the restore stops and deletes what it has written."));
        }
        else if (_exportMode)
        {
            checks.Add((Severity.Normal, $"The .bak is a copy-only full backup. The export leaves backup history rows in msdb of instance {target.Name}; " +
                "TRUSTWORTHY is off in the backup and the attaching account is its owner. Its files have the paths of the temporary publish: " +
                "give new paths when you restore it (WITH MOVE, or \"Relocate all files to folder\" in SSMS)."));
        }
        else
        {
            checks.Add((Severity.Normal, $"While the database is published, the agent in {host} does no other restore work; restores into {host} wait until it is unpublished."));
        }

        return checks;
    }

    /// <summary>The database's files in the order the server names them: primary data file, other data files, logs.</summary>
    private List<SqlFileDto> RestoreFilesOrdered() =>
        _publishDb is null ? [] : [.. _publishDb.Files.OrderByDescending(f => f.Primary).ThenBy(f => f.Kind == "log" ? 1 : 0)];

    /// <summary>Where the files would go (the same naming as the server's), or why not.</summary>
    private (IReadOnlyList<string>? Paths, string? Error) RestoreTargets()
    {
        if (_publishDb is null || TargetInstance is not { } target || string.IsNullOrWhiteSpace(_publishName))
        {
            return (null, null);
        }

        try
        {
            return (SqlRestoreFiles.TargetPaths(_publishName.Trim(), [.. RestoreFilesOrdered().Select(f => (f.Path, f.Kind))], _fileLocation, _dataFolder, _logFolder,
                target.DefaultDataFolder, target.DefaultLogFolder), null);
        }
        catch (ArgumentException ex)
        {
            return (null, ex.Message);
        }
    }

    private bool CanPublish =>
        _publishDb is not null && _targetVm is not null && _accountId is not null && TargetInstance is { Connected: true } &&
        PublishChecks().All(c => c.Severity != Severity.Error);

    private async Task PublishAsync()
    {
        if (!CanPublish || _publishDb is null || _mount is null)
        {
            return;
        }

        if (_restoreMode && _overwrite && await Dialogs.ShowMessageBoxAsync(
                "Overwrite database",
                $"Overwrite {_publishDb.Name} on {_mount.VmName} with the restore point of {_mount.RestorePointCreatedUtc.ToLocalTime():g}? Everything written to it since then is lost.",
                yesText: "Overwrite", cancelText: "Cancel") != true)
        {
            return;
        }

        _starting = true;
        try
        {
            var started = _exportMode
                ? await Api.PostAsync<StartedDto>("api/sql/exports", new SqlExportRequestDto(
                    _mount.RestorePointId, _publishDb.Instance, _publishDb.Name, _targetVm!, _targetInstance!, _accountId!.Value,
                    string.IsNullOrWhiteSpace(_exportFolder) ? null : _exportFolder.Trim(), _exportDownload))
                : _restoreMode
                ? await Api.PostAsync<StartedDto>("api/sql/restores", new SqlRestoreRequestDto(
                    _mount.RestorePointId, _publishDb.Instance, _publishDb.Name, _targetVm!, _targetInstance!, _accountId!.Value, _publishName.Trim(),
                    _fileLocation, _dataFolder, _logFolder, _overwrite, _overwrite && _keepReplaced))
                : await Api.PostAsync<StartedDto>("api/sql/publishes", new SqlPublishRequestDto(
                    _mount.RestorePointId, _publishDb.Instance, _publishDb.Name, _targetVm!, _targetInstance!, _accountId!.Value, _publishName.Trim(), _publishHours * 60));
            _publishOpen = false;
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _starting = false;
        }
    }

    private SqlDatabaseDto? SelectedDatabase =>
        _selected is { } s && s.StartsWith("d:", StringComparison.Ordinal) && _sql is not null
            ? _sql.Databases.FirstOrDefault(d => Key(d) == s)
            : null;

    private SqlInstanceDto? SelectedInstance =>
        _selected is { } s && s.StartsWith("i:", StringComparison.Ordinal) ? InstanceOf(s[2..]) : null;

    protected override Task OnInitializedAsync() => OpenAsync();

    private async Task OpenAsync()
    {
        _error = null;
        _mount = null;
        _sql = null;
        try
        {
            _mount = await Api.PostAsync<FileMountDto>("api/file-restore/mounts", new OpenFileMountRequestDto(RestorePointId));
            _closed = false;
            _sql = await Api.GetAsync<SqlMountDto>($"api/file-restore/mounts/{_mount.Id}/sql");
            _tree = [.. _sql.Instances.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).Select(i => new TreeItemData<string>
            {
                Value = "i:" + i.Name,
                Text = i.Product is null ? i.Name : $"{i.Name}  ·  {i.Product}",
                Icon = Icons.Material.Filled.Dns,
                Expanded = true,
                Children = [.. _sql.Databases
                    .Where(d => string.Equals(d.Instance, i.Name, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase)
                    .Select(d => new TreeItemData<string>
                    {
                        Value = Key(d),
                        Text = d.Name,
                        Icon = d.Restorable ? Icons.Material.Filled.Storage : Icons.Material.Filled.Block,
                        Expandable = false,
                    })],
            })];
            _selected = _sql.Databases.Where(d => d.Restorable).Select(Key).FirstOrDefault() ?? _tree.FirstOrDefault()?.Value;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void OnSelected(string? value) => _selected = value;

    private SqlInstanceDto? InstanceOf(string name) =>
        _sql?.Instances.FirstOrDefault(i => string.Equals(i.Name, name, StringComparison.OrdinalIgnoreCase));

    private static string Key(SqlDatabaseDto d) => "d:" + d.Instance + Separator + d.Name;

    private static bool CanExport(SqlDatabaseDto d) => d.Files.Count > 0 && d.Files.All(f => f.Problem is null);

    private async Task ExportFilesAsync(SqlDatabaseDto db)
    {
        if (_mount is null)
        {
            return;
        }

        _preparing = true;
        try
        {
            var ticket = await Api.PostAsync<FileDownloadTicketDto>(
                $"api/file-restore/mounts/{_mount.Id}/sql/downloads", new SqlDownloadRequestDto(db.Instance, db.Name, TimeZoneInfo.Local.Id));
            await JS.InvokeVoidAsync("bdfuDownload", ticket.Url);
            Snackbar.Add($"Downloading {ticket.FileName}: the database files and {db.Name}-attach.sql.", Severity.Info);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _preparing = false;
        }
    }

    private async Task CloseAsync()
    {
        await UnmountAsync();
        _mount = null;
        _error = "The SQL browser is closed.";
    }

    private async Task UnmountAsync()
    {
        if (_mount is null || _closed)
        {
            return;
        }

        _closed = true;
        try
        {
            await Api.DeleteAsync($"api/file-restore/mounts/{_mount.Id}");
        }
        catch (ApiException)
        {
        }
    }

    public async ValueTask DisposeAsync() => await UnmountAsync();
}
