        "showUnfilled": true
      }
    },
    {
      "type": "bargauge",
      "title": "Guest writes held for the last snapshot",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "VSS freeze or SQL Server suspend, per VM.",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bdfu_vm_last_writes_held_seconds{pool=~\"$pool\"}",
          "legendFormat": "{{vm}}",
          "refId": "A",
          "instant": true,
