@page "/sessions/{Id:guid}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject LiveConnection Live
@inject ISnackbar Snackbar

<PageTitle>Session – backdafuckup</PageTitle>

@if (_session is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.h4">@_session.Name</MudText>
        <MudChip T="string" Class="ml-3" Color="@Fmt.StateColor(_session.State)">@_session.State</MudChip>
        <MudSpacer />
        @if (_session.State is "Running" or "Queued")
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopAsync">Stop</MudButton>
        }
    </div>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @_session.Kind · started by @_session.TriggeredBy · @Fmt.Time(_session.StartedUtc ?? _session.CreatedUtc) · duration @Fmt.Duration(_session.StartedUtc, _session.EndedUtc)
        @if (_session.Summary is not null) { <span> · @_session.Summary</span> }
    </MudText>
    <MudProgressLinear Color="Color.Primary" Value="@_session.Progress" Size="Size.Large" Class="mb-4">@($"{_session.Progress:0}%")</MudProgressLinear>

    var m = _session.Metrics ?? new TransferMetricsDto { ReadBytes = _session.ReadBytes, StoredBytes = _session.TransferredBytes };
    var running = _session.State is "Running" or "Stopping";
    @if (_session.Kind == "Restore")
    {
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="6" md="3"><StatTile Title="Duration" Value="@Fmt.Duration(_session.StartedUtc, _session.EndedUtc)" Detail="@($"{_tasks.Count} object(s)")" Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Restore rate" Value="@Fmt.Rate(m.ProcessingRate)" Detail="@(running ? $"current network rate {Fmt.Rate(m.CurrentBytesPerSecond)}" : $"network {Fmt.Rate(m.Seconds > 0 ? m.StoredBytes / m.Seconds : null)}")" Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Restored" Value="@Fmt.Bytes(m.ProcessedBytes)" Detail="@($"of {Fmt.Bytes(m.TotalBytes)} disk size")" Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Transferred" Value="@Fmt.Bytes(m.StoredBytes)" Detail="@($"sent to the host, {Fmt.Bytes(Math.Max(0, m.ProcessedBytes - m.StoredBytes))} empty blocks skipped")" Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" /></MudItem>
        </MudGrid>
    }
    else
    {
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="6" md="3"><StatTile Title="Duration" Value="@Fmt.Duration(_session.StartedUtc, _session.EndedUtc)" Detail="@($"{_tasks.Count} object(s)")" Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Processing rate" Value="@Fmt.Rate(m.ProcessingRate)" Detail="@(running ? $"current read rate {Fmt.Rate(m.CurrentBytesPerSecond)}" : $"read rate {Fmt.Rate(m.ReadRate)}")" Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Processed" Value="@Fmt.Bytes(m.ProcessedBytes)" Detail="@($"of {Fmt.Bytes(m.TotalBytes)} provisioned")" Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Read" Value="@Fmt.Bytes(m.ReadBytes)" Detail="from the source" Icon="@Icons.Material.Filled.Download" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Transferred" Value="@Fmt.Bytes(m.StoredBytes)" Detail="@($"written to the repository, new data {Fmt.Bytes(m.NewDataBytes)}")" Icon="@Icons.Material.Filled.Save" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Dedupe" Value="@Fmt.Ratio(m.DedupeRatio)" Detail="@($"{Fmt.Bytes(m.DedupedBytes)} already stored")" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Compression" Value="@Fmt.Ratio(m.CompressionRatio)" Detail="@($"{Fmt.Bytes(m.NewDataBytes)} → {Fmt.Bytes(m.StoredBytes)}")" Icon="@Icons.Material.Filled.Compress" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Bottleneck" Value="@(m.Bottleneck ?? "–")" Detail="@($"source {Fmt.Percent(m.SourceLoad)} · processing {Fmt.Percent(m.ProcessingLoad)} · target {Fmt.Percent(m.TargetLoad)}")" Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" /></MudItem>
    </MudGrid>

    @if (m.ProcessedBytes > 0)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Processed data</MudText>
            <div class="data-bar">
                @foreach (var (label, bytes, css) in Breakdown(m))
                {
                    if (bytes > 0)
                    {
                        <div class="@css" style="@($"width:{bytes * 100.0 / m.ProcessedBytes:0.##}%".Replace(',', '.'))" title="@($"{label}: {Fmt.Bytes(bytes)}")"></div>
                    }
                }
            </div>
            <div class="d-flex flex-wrap gap-4 mt-1">
                @foreach (var (label, bytes, css) in Breakdown(m))
                {
                    <MudText Typo="Typo.caption"><span class="@($"legend {css}")"></span>@label @Fmt.Bytes(bytes)</MudText>
                }
            </div>
        </MudPaper>
    }
    }

    @if (_tasks.Values.Any(t => t.Metrics?.Disks is { Count: > 0 }))
    {
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Disks</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Style="overflow-x:auto">
            <thead>
                <tr>
                    <th>Object</th><th>Disk</th><th>State</th><th>Mode</th><th>Transport</th><th>Processed</th><th>Read</th>
                    <th>New → stored</th><th>Dedupe</th><th>Compression</th><th>Rate</th><th>Duration</th><th>Bottleneck</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tasks.Values.OrderBy(t => t.ObjectName))
                {
                    @foreach (var d in t.Metrics?.Disks ?? [])
                    {
                        var dm = d.Metrics;
                        <tr>
                            <td>@t.ObjectName</td>
                            <td>@d.Name <MudText Typo="Typo.caption" Color="Color.Secondary">@Fmt.Bytes(d.CapacityBytes)</MudText></td>
                            <td>@d.State</td>
                            <td title="@d.FullReason">@(d.Mode ?? "–")@(d.Mode == "Full" && d.FullReason is not null ? " *" : "")</td>
                            <td>@(d.Transport ?? "–")</td>
                            <td>@Fmt.Bytes(dm.ProcessedBytes)</td>
                            <td>@Fmt.Bytes(dm.ReadBytes)</td>
                            <td>@Fmt.Bytes(dm.NewDataBytes) → @Fmt.Bytes(dm.StoredBytes)</td>
                            <td>@Fmt.Ratio(dm.DedupeRatio)</td>
                            <td>@Fmt.Ratio(dm.CompressionRatio)</td>
                            <td>@Fmt.Rate(dm.ProcessingRate)</td>
                            <td>@(dm.Seconds > 0 ? Fmt.Seconds(dm.Seconds) : "–")</td>
                            <td>@(dm.Bottleneck is { } b ? $"{b} ({Fmt.Percent(Math.Max(dm.SourceLoad, Math.Max(dm.ProcessingLoad, dm.TargetLoad)))})" : "–")</td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Color="Color.Secondary">* Full read; hover for the reason. Rates refer to the transfer time of the disk.</MudText>
    </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Objects</MudText>
                @foreach (var t in _tasks.Values.OrderBy(t => t.ObjectName))
                {
                    var tm = t.Metrics;
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.body1">@t.ObjectName</MudText>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="@Fmt.StateColor(t.State)">@t.State</MudChip>
                    </div>
                    <MudProgressLinear Value="@t.Progress" Color="@Fmt.StateColor(t.State)" />
                    <MudText Typo="Typo.caption" Class="d-block mb-3">
                        @Fmt.Bytes(t.ReadBytes) read · @Fmt.Bytes(t.TransferredBytes) transferred · @Fmt.Rate(tm?.ProcessingRate)
                        @if (t.State == "Running" && tm is not null) { <span> (now @Fmt.Rate(tm.CurrentBytesPerSecond))</span> }
                        · dedupe @Fmt.Ratio(tm?.DedupeRatio) · compression @Fmt.Ratio(tm?.CompressionRatio) · @Fmt.Duration(t.StartedUtc, t.EndedUtc)
                        @if (t.Error is not null) { <span style="color:#c62828"> · @t.Error</span> }
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Log</MudText>
                <div class="session-log">
                    @foreach (var entry in _log.Values.OrderBy(e => e.Id))
                    {
                        <div class="@entry.Severity">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss") @entry.Message</div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SessionSummaryDto? _session;

    private static IEnumerable<(string Label, long Bytes, string Css)> Breakdown(TransferMetricsDto m) =>
    [
        ("Unchanged", m.UnchangedBytes, "seg-unchanged"),
        ("Empty", m.ZeroBytes, "seg-zero"),
        ("Already stored", m.DedupedBytes, "seg-dedupe"),
        ("New", m.NewDataBytes, "seg-new"),
    ];
    private readonly Dictionary<Guid, SessionTaskDto> _tasks = [];
    private readonly SortedDictionary<long, LogEntryDto> _log = [];

    protected override async Task OnInitializedAsync()
    {
        Live.SessionUpdated += OnSession;
        Live.TaskUpdated += OnTask;
        Live.LogEntryUpserted += OnLog;
        try
        {
            await Live.JoinSessionAsync(Id);
        }
        catch (Exception)
        {
            // Without live updates the page shows the state at load time.
        }

        var detail = await Api.GetAsync<SessionDetailDto>($"api/sessions/{Id}");
        _session = detail.Session;
        foreach (var t in detail.Tasks)
        {
            _tasks[t.Id] = t;
        }

        foreach (var e in await Api.GetAsync<List<LogEntryDto>>($"api/sessions/{Id}/log"))
        {
            _log[e.Id] = e;
        }
    }

    private void OnSession(SessionSummaryDto s)
    {
        if (s.Id == Id)
        {
            _session = s;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void OnTask(SessionTaskDto t)
    {
        if (t.SessionId == Id)
        {
            _tasks[t.Id] = t;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void OnLog(LogEntryDto e)
    {
        if (e.SessionId == Id)
        {
            _log[e.Id] = e;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await Api.PostAsync($"api/sessions/{Id}/stop");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.SessionUpdated -= OnSession;
        Live.TaskUpdated -= OnTask;
        Live.LogEntryUpserted -= OnLog;
        try
        {
            await Live.LeaveSessionAsync(Id);
        }
        catch (Exception)
        {
        }
    }
}
