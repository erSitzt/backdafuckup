@* "application" or "crash" consistency of a restore point or a database, with the reason as a tooltip. Crash-consistent is
   what a backup without guest processing promises: it shows as a warning only when it is less than the job promised. *@
@if (Consistency == "application")
{
    <MudTooltip Text="@(Hooks ? "The backup hooks of the pods ran before the snapshots: their volumes are application-consistent." : "The guest held its writes for the snapshot (VSS).")">
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@AppIcons.ApplicationConsistent">@(Hooks ? "app-consistent (hooks)" : "application-consistent")</MudChip>
    </MudTooltip>
}
else
{
    <MudTooltip Text="@($"Like after a power failure: the newest changes before the snapshot may be missing. {Reason}")">
        <MudChip T="string" Size="Size.Small" Color="@(Warning ? Color.Warning : Color.Default)" Icon="@(Warning ? Icons.Material.Filled.Warning : null)">crash-consistent</MudChip>
    </MudTooltip>
}

@code {
    [Parameter]
    public string Consistency { get; set; } = "crash";

    [Parameter]
    public string? Reason { get; set; }

    /// <summary>Less consistent than promised (default): a database that is only crash-consistent always is.</summary>
    [Parameter]
    public bool Warning { get; set; } = true;

    /// <summary>A Kubernetes namespace: its consistency comes from the backup hooks of its pods.</summary>
    [Parameter]
    public bool Hooks { get; set; }
}
