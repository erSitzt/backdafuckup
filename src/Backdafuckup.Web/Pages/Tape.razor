        public string Export { get; set; } = "Never";
    }

    private sealed class TapeJobForm
    {
        public string Name { get; set; } = string.Empty;
        public Guid PoolId { get; set; }
        public string Mode { get; set; } = "NewestPerVm";
        public List<Guid> SourceJobIds { get; set; } = [];
        public Guid? AfterJobId { get; set; }
        public string ScheduleKind { get; set; } = "None";
        public string Time { get; set; } = "08:00";
        public List<DayOfWeek> Days { get; set; } = [DayOfWeek.Saturday];
        public bool Enabled { get; set; } = true;
    }

    private static string NewSetText(string newSet) => newSet switch
    {
        "EveryRun" => "a new set every run",
        "Daily" => "a new set every day",
        "Weekly" => "a new set every week",
        "Monthly" => "a new set every month",
        _ => "one growing set",
    };

    private string RunsText(TapeJobDto job)
    {
        var after = job.AfterJobId is { } id ? _backupJobs?.FirstOrDefault(j => j.Id == id)?.Name : null;
        var schedule = job.Schedule.Kind switch
        {
            "Daily" => $"daily at {job.Schedule.TimeOfDay}",
            "Weekly" => $"{string.Join(", ", job.Schedule.Days)} at {job.Schedule.TimeOfDay}",
            _ => null,
        };
        return string.Join(" · ", new[] { schedule, after is null ? null : $"after {after}" }.OfType<string>().DefaultIfEmpty("on demand"));
    }

