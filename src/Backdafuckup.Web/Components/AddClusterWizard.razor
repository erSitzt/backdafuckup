@using System.Net
@using System.Net.Http.Json
@inject ApiClient Api
@inject ISnackbar Snackbar

@* Adds a Kubernetes cluster: its API address, the API server's certificate confirmed by the user (trust on first use),
   then a ServiceAccount token from the setup manifest. *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-3">Add Kubernetes cluster</MudText>

    @if (_step == Step.Address)
    {
        <MudText Typo="Typo.body2" Class="mb-3">The address of the cluster's API server (its load balancer, or a server node). The certificate is shown for confirmation next.</MudText>
        <div class="field-grid schedule-row" style="grid-template-columns: minmax(0, 1fr) 140px; max-width: 640px">
            <MudTextField @bind-Value="_address" Label="API server: host name or IP address" Variant="Variant.Outlined" AutoFocus="true" />
            <MudNumericField @bind-Value="_port" Label="Port" Variant="Variant.Outlined" />
        </div>
    }
    else if (_step == Step.Trust)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Verify the certificate before you trust it. Compare it with the one in your kubeconfig, e.g.
            <span class="mono">kubectl config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}'</span> names the CA that signed it.
        </MudAlert>
        @foreach (var cert in _pending)
        {
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                <tbody>
                    <tr><td style="width:180px">Host</td><td>@cert.HostAddress</td></tr>
                    <tr><td>Subject</td><td>@cert.Subject</td></tr>
                    <tr><td>Issuer</td><td>@cert.Issuer @(cert.ValidAgainstSystemCa ? "(trusted CA)" : "(self-signed or the cluster's own CA)")</td></tr>
                    <tr><td>Valid</td><td>@Fmt.Time(cert.NotBefore) – @Fmt.Time(cert.NotAfter)</td></tr>
                    <tr><td>Public key SHA-256</td><td class="mono">@cert.SpkiSha256</td></tr>
                </tbody>
            </MudSimpleTable>
        }
    }
    else
    {
        <div class="form-narrow">
            <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_token" Label="ServiceAccount token" InputType="InputType.Password" Variant="Variant.Outlined"
                          HelperText="From the setup manifest: kubectl -n backdafuckup-system get secret backdafuckup-token -o jsonpath='{.data.token}' | base64 -d" />
        </div>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
    }

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Text" OnClick="OnCancel">Cancel</MudButton>
        <MudSpacer />
        @if (_step == Step.Address)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_address))" OnClick="ProbeAsync">Next</MudButton>
        }
        else if (_step == Step.Trust)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Trust">Trust certificate</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_token))" OnClick="CreateAsync">Connect and add</MudButton>
        }
    </div>
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-2" />
    }
</MudPaper>

@code {
    private enum Step { Address, Trust, Credentials }

    [Parameter] public EventCallback OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Step _step = Step.Address;
    private string _address = string.Empty;
    private int _port = 6443;
    private string _displayName = string.Empty;
    private string _token = string.Empty;
    private bool _busy;
    private string? _error;
    private readonly List<CertificateDto> _trusted = [];
    private List<CertificateDto> _pending = [];

    private async Task ProbeAsync()
    {
        await RunAsync(async () =>
        {
            var cert = await Api.PostAsync<CertificateDto>("api/connections/probe", new ProbeRequestDto(_address.Trim(), _port, "Kubernetes"));
            _pending = [cert];
            _displayName = string.IsNullOrEmpty(_displayName) ? _address.Trim() : _displayName;
            _step = Step.Trust;
        });
    }

    private void Trust()
    {
        _trusted.AddRange(_pending);
        _pending = [];
        _step = Step.Credentials;
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            var request = new CreateConnectionDto
            {
                Kind = "Kubernetes",
                DisplayName = _displayName.Trim(),
                Address = _address.Trim(),
                Port = _port,
                UserName = "backdafuckup",
                Password = _token.Trim(),
                TrustedCertificates = _trusted,
            };
            using var response = await Api.PostRawAsync("api/connections", request);
            if (response.StatusCode == HttpStatusCode.Conflict && response.Content.Headers.ContentType?.MediaType == "application/json"
                && await TryReadUntrustedAsync(response) is { Certificates.Count: > 0 } untrusted)
            {
                _pending = untrusted.Certificates.ToList();
                _step = Step.Trust;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                throw new ApiException(await ApiClient.ReadProblemAsync(response), response.StatusCode, null);
            }

            Snackbar.Add($"Cluster {_displayName} added.", Severity.Success);
            await OnDone.InvokeAsync();
        });
    }

    private static async Task<UntrustedCertificatesDto?> TryReadUntrustedAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<UntrustedCertificatesDto>();
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
