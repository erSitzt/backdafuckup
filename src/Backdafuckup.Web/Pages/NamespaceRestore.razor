@page "/restore-namespace/{Id:guid}"
@inject ApiClient Api
@inject NavigationManager Navigation

@* The restore of a Kubernetes namespace's restore point into a cluster (its own or another, with StorageClasses mapped): the
   whole namespace, apps and workloads with what they need, or single PVCs (also under new names); into the original namespace
   or another one. A preview shows each volume's way into the target and what to look at before anything is written. *@
<PageTitle>Restore namespace – backdafuckup</PageTitle>
<PageHeader Title="@($"Restore namespace {_details?.Namespace}")" Back="/backups"
            Description="Objects and the data of volumes come back into the cluster they were backed up from or into another one, with its StorageClasses. PVCs with data are written to new volumes; objects that exist are left as they are unless you replace them." />

@if (_error is not null && _details is null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_point is null || _details is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2">
            Restore point from <b>@Fmt.Time(_point.CreatedUtc)</b> (job @_point.JobName) · cluster @_details.Cluster · Kubernetes @_details.KubernetesVersion ·
            @_details.Objects.Count objects · @_details.Volumes.Count(v => KubernetesDataPaths.HasData(v.DataPath)) of @_details.Volumes.Count PVCs with data ·
            <ConsistencyChip Consistency="@_point.Consistency" Reason="@_point.ConsistencyReason" Warning="@_point.ConsistencyWarning" Hooks="true" />
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="section-title mb-2">What to restore</MudText>
        <MudToggleGroup T="string" @bind-Value="_what" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Outlined="true" CheckMark="false" Class="mb-3">
            <MudToggleItem T="string" Value="@WhatNamespace" Text="Whole namespace" />
            <MudToggleItem T="string" Value="@WhatApps" Text="Apps and workloads" />
            <MudToggleItem T="string" Value="@WhatClaims" Text="Single PVCs" />
        </MudToggleGroup>

        @switch (_what)
        {
            case WhatNamespace:
                <MudText Typo="Typo.body2">
                    Every object of the namespace (@Summary(_details.Objects.Where(o => o.Namespace is not null && !o.Controlled).Select(o => o.Kind))) and the data of its PVCs.
                    Objects made by controllers (@_details.Objects.Count(o => o.Controlled), e.g. the pods of a StatefulSet) are made again by their owners.
                </MudText>
                break;

            case WhatApps:
                <MudText Typo="Typo.body2" Class="mb-2">
                    A workload comes with what it needs: its ConfigMaps and Secrets, ServiceAccount and roles, PVCs with their data, and the Services and Ingresses to it.
                </MudText>
                <div class="table-box">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead><tr><th style="width:48px"></th><th>Workload</th><th>Brings along</th></tr></thead>
                        <tbody>
                            @foreach (var app in Apps())
                            {
                                <tr class="group-row">
                                    <td><MudCheckBox T="bool" Value="@app.Workloads.All(w => _objects.Contains(Key(w)))" ValueChanged="@(on => ToggleApp(app.Workloads, on))" Dense="true" Color="Color.Primary" /></td>
                                    <td colspan="2"><b>@(app.Name ?? "Without an app label")</b><span class="cell-sub">@app.Workloads.Count workload(s)</span></td>
                                </tr>
                                @foreach (var workload in app.Workloads)
                                {
                                    <tr class="@(_objects.Contains(Key(workload)) ? "row-selected" : null)">
                                        <td><MudCheckBox T="bool" Value="@_objects.Contains(Key(workload))" ValueChanged="@(on => Toggle(Key(workload), on))" Dense="true" Color="Color.Primary" /></td>
                                        <td class="nowrap">@workload.Kind <b>@workload.Name</b></td>
                                        <td>
                                            @foreach (var need in workload.Needs ?? [])
                                            {
                                                <span class="@(need.StartsWith("PersistentVolumeClaim/", StringComparison.Ordinal) && HasData(need) ? "mini-chip info" : "mini-chip")"
                                                      title="@(HasData(need) ? "with its data" : null)">@need</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                break;

            case WhatClaims:
                <div class="table-box">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead><tr><th style="width:48px"></th><th>PVC</th><th class="num">Size</th><th>Storage class</th><th>Restore as</th></tr></thead>
                        <tbody>
                            @foreach (var volume in _details.Volumes)
                            {
                                var withData = KubernetesDataPaths.HasData(volume.DataPath);
                                <tr class="@(_claims.ContainsKey(volume.Claim) ? "row-selected" : null)">
                                    <td><MudCheckBox T="bool" Value="@_claims.ContainsKey(volume.Claim)" ValueChanged="@(on => ToggleClaim(volume.Claim, on))" Dense="true" Color="Color.Primary" Disabled="@(!withData)" /></td>
                                    <td>@volume.Claim@if (!withData) {<span class="cell-sub">objects only: @volume.Reason</span>}</td>
                                    <td class="num">@Fmt.Bytes(volume.SizeBytes)</td>
                                    <td>@volume.StorageClass</td>
                                    <td>
                                        @if (_claims.ContainsKey(volume.Claim) && _replaceClaims)
                                        {
                                            <span class="mini-chip warning">replaces @volume.Claim</span>
                                        }
                                        else if (_claims.ContainsKey(volume.Claim))
                                        {
                                            <MudTextField T="string" Value="@_claims[volume.Claim]" ValueChanged="@(v => _claims[volume.Claim] = v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                <MudSwitch T="bool" Value="_replaceClaims" ValueChanged="OnReplaceChanged" Color="Color.Warning" Class="mt-3"
                           Label="Replace the PVCs in place: their workloads are stopped for the swap and started again" />
                @if (_replaceClaims)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        The current data of the selected PVCs is deleted and replaced by the restore point's. Their volumes are written first, while the workloads still run;
                        then the Deployments or StatefulSets using them are scaled to 0, the PVCs swapped and the workloads scaled back. If Fleet or Argo CD manages their
                        replicas, they may scale them up during the swap. Pods without such a controller (DaemonSets, bare pods) stop the restore before anything is written.
                    </MudAlert>
                    <MudTextField @bind-Value="_confirm" Label="@($"Type {_details.Namespace} to confirm")" Variant="Variant.Outlined" Class="mt-3" Style="max-width: 420px" Immediate="true" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="help-text">A PVC is restored next to the original under a new name, or under its own name into another namespace. Its workload is not changed.</MudText>
                }

                break;
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="section-title mb-2">Where</MudText>
        <div class="form-narrow">
            <MudSelect T="Guid" Value="_cluster" ValueChanged="OnClusterChanged" Label="Cluster" Variant="Variant.Outlined" Class="mb-3"
                       HelperText="@(_cluster == _point.ConnectionId ? "The cluster the namespace was backed up from." : "Another cluster: its StorageClasses take the volumes (below); what only the old cluster means is left out.")">
                @foreach (var cluster in _clusters)
                {
                    <MudSelectItem T="Guid" Value="@cluster.Id">@cluster.DisplayName@(cluster.Id == _point.ConnectionId ? " (backed up here)" : string.Empty)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Value="_target" ValueChanged="OnTargetChanged" Label="Target namespace" Variant="Variant.Outlined" Disabled="@(_what == WhatClaims && _replaceClaims)"
                          DebounceInterval="400" HelperText="@(_target.Trim() == _details.Namespace ? "The original namespace." : "Created when it does not exist; RoleBindings to its ServiceAccounts follow the new name.")" />
            @if (_what != WhatClaims)
            {
                <MudSwitch T="bool" @bind-Value="_replace" Color="Color.Primary" Class="mt-3"
                           Label="Replace objects that exist with their state in the restore point (otherwise they are left as they are)" />
            }
        </div>
        @if (_what != WhatClaims && _target.Trim() == _details.Namespace && Selected().Any() && _plan?.NamespaceExists == true)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                PVCs with data must not exist in the target namespace: delete them (and stop their workloads) first, restore into another namespace, or restore single PVCs under new names.
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="section-title mb-2">Volumes in the target</MudText>
        @if (SourceClasses().Any())
        {
            <div class="table-box mb-3">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead><tr><th>StorageClass of the backup</th><th>Goes into</th></tr></thead>
                    <tbody>
                        @foreach (var source in SourceClasses())
                        {
                            <tr>
                                <td class="nowrap">@source</td>
                                <td>
                                    <MudSelect T="string" Value="@(_map.GetValueOrDefault(source) ?? source)" ValueChanged="@(v => OnMapChanged(source, v))" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Dense="true" Style="max-width: 320px">
                                        @if (_plan is null || !_plan.StorageClasses.Contains(source))
                                        {
                                            <MudSelectItem T="string" Value="@source">@source (not in this cluster)</MudSelectItem>
                                        }
                                        @foreach (var name in _plan?.StorageClasses ?? [])
                                        {
                                            <MudSelectItem T="string" Value="@name">@name@(name == _plan?.DefaultStorageClass ? " (default)" : string.Empty)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }

        @if (_planning)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2" />
        }
        else if (_planError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_planError</MudAlert>
        }
        else if (_plan is not null)
        {
            <div class="table-box">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead><tr><th>PVC</th><th class="num">Size</th><th>StorageClass</th><th>Data</th></tr></thead>
                    <tbody>
                        @foreach (var volume in _plan.Volumes.Where(v => _what != WhatClaims || _claims.ContainsKey(v.Claim)))
                        {
                            <tr>
                                <td>@volume.Claim</td>
                                <td class="num">@Fmt.Bytes(volume.SizeBytes)</td>
                                <td>@volume.TargetStorageClass</td>
                                <td>
                                    <span class="@PathChip(volume.Path)">@PathText(volume.Path)</span>
                                    <span class="cell-sub">@volume.Reason</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            @foreach (var problem in _plan.Errors)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@problem</MudAlert>
            }

            @foreach (var warning in _plan.Warnings)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@warning</MudAlert>
            }
        }
    </MudPaper>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
    }

    <div class="d-flex gap-2">
        <MudButton Href="/backups">Cancel</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SettingsBackupRestore" Disabled="@(_busy || !Ready || _planning || _plan?.Errors.Count > 0)" OnClick="StartAsync">Start restore</MudButton>
    </div>
}

@code {
    private const string WhatNamespace = "namespace";
    private const string WhatApps = "apps";
    private const string WhatClaims = "claims";

    [Parameter] public Guid Id { get; set; }

    private RestorePointDto? _point;
    private KubernetesRestorePointDto? _details;
    private List<ConnectionDto> _clusters = [];
    private Guid _cluster;
    private readonly Dictionary<string, string> _map = new(StringComparer.Ordinal);
    private KubernetesRestorePlanDto? _plan;
    private bool _planning;
    private string? _planError;
    private string _what = WhatNamespace;
    private string _target = string.Empty;
    private bool _replace;
    private bool _replaceClaims;
    private string _confirm = string.Empty;
    private readonly HashSet<string> _objects = [];
    private readonly Dictionary<string, string> _claims = [];
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _details = await Api.GetAsync<KubernetesRestorePointDto>($"api/restore-points/{Id}/kubernetes");
            _point = await Api.GetAsync<RestorePointDto>($"api/restore-points/{Id}");
            _target = _details.Namespace;
            _clusters = [.. (await Api.GetAsync<List<ConnectionDto>>("api/connections")).Where(c => c.Kind == "Kubernetes").OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)];
            _cluster = _point.ConnectionId ?? _clusters.FirstOrDefault()?.Id ?? Guid.Empty;
            await LoadPlanAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private bool Ready => !string.IsNullOrWhiteSpace(_target) && _what switch
    {
        WhatApps => _objects.Count > 0,
        WhatClaims when _replaceClaims => _claims.Count > 0 && _confirm.Trim() == _details?.Namespace,
        WhatClaims => _claims.Count > 0 && _claims.Values.All(v => !string.IsNullOrWhiteSpace(v)),
        _ => true,
    };

    private IEnumerable<string> Selected() => _what switch
    {
        WhatApps => _objects,
        WhatClaims => _claims.Keys,
        _ => _details?.Objects.Select(Key) ?? [],
    };

    /// <summary>The workloads that are not made by a controller, grouped by their app.</summary>
    private IEnumerable<(string? Name, List<KubernetesObjectDto> Workloads)> Apps() => _details!.Objects
        .Where(o => o.Needs is not null)
        .GroupBy(o => o.App)
        .OrderBy(g => g.Key is null).ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .Select(g => (g.Key, g.OrderBy(o => o.Kind, StringComparer.Ordinal).ThenBy(o => o.Name, StringComparer.Ordinal).ToList()));

    private bool HasData(string key) => key.StartsWith("PersistentVolumeClaim/", StringComparison.Ordinal)
        && _details!.Volumes.Any(v => KubernetesDataPaths.HasData(v.DataPath) && $"PersistentVolumeClaim/{v.Claim}" == key);

    private static string Key(KubernetesObjectDto o) => $"{o.Kind}/{o.Name}";

    private static string Summary(IEnumerable<string> kinds) =>
        string.Join(", ", kinds.GroupBy(k => k).OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.Ordinal).Select(g => $"{g.Count()} {g.Key}"));

    private void Toggle(string key, bool on)
    {
        if (on)
        {
            _objects.Add(key);
        }
        else
        {
            _objects.Remove(key);
        }
    }

    private void ToggleApp(List<KubernetesObjectDto> workloads, bool on)
    {
        foreach (var workload in workloads)
        {
            Toggle(Key(workload), on);
        }
    }

    private void OnReplaceChanged(bool on)
    {
        _replaceClaims = on;
        _confirm = string.Empty;
        if (on)
        {
            _target = _details!.Namespace;
            foreach (var claim in _claims.Keys.ToList())
            {
                _claims[claim] = claim;
            }
        }
    }

    private void ToggleClaim(string claim, bool on)
    {
        if (on)
        {
            _claims[claim] = _replaceClaims || _target.Trim() != _details!.Namespace ? claim : $"{claim}-restored";
        }
        else
        {
            _claims.Remove(claim);
        }
    }

    /// <summary>The StorageClasses the restore point's PVCs come from.</summary>
    private IEnumerable<string> SourceClasses() => _details!.Volumes.Select(v => v.StorageClass).OfType<string>().Where(c => c.Length > 0).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal);

    private static string PathChip(string path) => path switch
    {
        "block" or "files" => "mini-chip info",
        "missing" => "mini-chip error",
        _ => "mini-chip",
    };

    private static string PathText(string path) => path switch
    {
        "block" => "as a block volume",
        "files" => "as files",
        "missing" => "no such class",
        _ => "objects only",
    };

    /// <summary>Another cluster: classes it lacks go into its default class until chosen otherwise.</summary>
    private async Task OnClusterChanged(Guid cluster)
    {
        _cluster = cluster;
        _map.Clear();
        await LoadPlanAsync();
        if (_plan is { } plan && cluster != _point!.ConnectionId)
        {
            var fallback = plan.DefaultStorageClass ?? plan.StorageClasses.FirstOrDefault();
            foreach (var source in SourceClasses().Where(c => fallback is not null && !plan.StorageClasses.Contains(c)))
            {
                _map[source] = fallback!;
            }

            if (_map.Count > 0)
            {
                await LoadPlanAsync();
            }
        }
    }

    private async Task OnMapChanged(string source, string target)
    {
        if (target == source)
        {
            _map.Remove(source);
        }
        else
        {
            _map[source] = target;
        }

        await LoadPlanAsync();
    }

    private async Task OnTargetChanged(string target)
    {
        _target = target;
        await LoadPlanAsync();
    }

    private async Task LoadPlanAsync()
    {
        if (_cluster == Guid.Empty || string.IsNullOrWhiteSpace(_target))
        {
            return;
        }

        _planning = true;
        _planError = null;
        try
        {
            _plan = await Api.PostAsync<KubernetesRestorePlanDto>($"api/restore-points/{Id}/kubernetes/restore-plan", new KubernetesRestorePlanRequestDto
            {
                TargetConnectionId = _cluster, TargetNamespace = _target.Trim(), StorageClassMap = new Dictionary<string, string>(_map),
            });
        }
        catch (ApiException ex)
        {
            _plan = null;
            _planError = ex.Message;
        }
        finally
        {
            _planning = false;
        }
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var options = new KubernetesRestoreDto
            {
                TargetNamespace = _target.Trim(),
                ReplaceExisting = _replace && _what != WhatClaims,
                Objects = _what == WhatApps ? [.. _objects] : null,
                OnlyClaims = _what == WhatClaims ? [.. _claims.Keys] : null,
                ReplaceClaims = _what == WhatClaims && _replaceClaims,
                ClaimNames = _what == WhatClaims && !_replaceClaims ? _claims.ToDictionary(kv => kv.Key, kv => kv.Value.Trim()) : [],
                StorageClassMap = new Dictionary<string, string>(_map),
            };
            var started = await Api.PostAsync<StartedDto>("api/restores", new RestoreRequestDto
            {
                RestorePointId = Id,
                TargetConnectionId = _cluster,
                Mode = _cluster == _point!.ConnectionId ? RestoreModeDto.OriginalLocation : RestoreModeDto.AlternateLocation,
                Kubernetes = options,
            });
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
