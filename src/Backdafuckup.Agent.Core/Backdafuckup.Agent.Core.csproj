<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The platform-neutral part of the guest agent (long poll, commands, self-update, certificate pin, file hash).
    netstandard2.0, so both agent builds (net10.0-windows and net48) use it and it is testable on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Backdafuckup.Agent.Protocol\Backdafuckup.Agent.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="ISCSI" />
    <PackageReference Include="DiskAccessLibrary" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Backdafuckup.Agent.Tests" />
  </ItemGroup>
</Project>
