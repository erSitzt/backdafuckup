<MudSimpleTable Dense="true" Hover="true" Elevation="0">
    <thead>
        <tr>
            <th>Session</th><th>Type</th><th>State</th><th>Started</th><th>Duration</th>
            <th>Processed</th><th>Read</th><th>Transferred</th><th>Rate</th><th>Dedupe</th><th>Compression</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Sessions)
        {
            var m = s.Metrics;
            <tr>
                <td><MudLink Href="@($"/sessions/{s.Id}")">@s.Name</MudLink></td>
                <td>@s.Kind</td>
                <td><MudChip T="string" Size="Size.Small" Color="@Fmt.StateColor(s.State)">@s.State</MudChip></td>
                <td>
                    @Fmt.Time(s.StartedUtc ?? s.CreatedUtc)
                    @if (s.Kind == "SqlBackup")
                    {
                        <br /><MudText Typo="Typo.caption">@(s.State == "Running" ? "running now" : $"last run {Fmt.Time(s.EndedUtc)}")</MudText>
                    }
                </td>
                @* A day session of SQL Server backups spans the day's runs: its "duration" would only mislead. *@
                <td>@(s.Kind == "SqlBackup" ? "–" : Fmt.Duration(s.StartedUtc, s.EndedUtc))</td>
                <td>@Fmt.Bytes(m?.ProcessedBytes)</td>
                <td>@Fmt.Bytes(s.ReadBytes)</td>
                <td>@Fmt.Bytes(s.TransferredBytes)</td>
                <td>@Fmt.Rate(m?.ProcessingRate)</td>
                <td>@Fmt.Ratio(m?.DedupeRatio)</td>
                <td>@Fmt.Ratio(m?.CompressionRatio)</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public IReadOnlyList<SessionSummaryDto> Sessions { get; set; } = [];
}
