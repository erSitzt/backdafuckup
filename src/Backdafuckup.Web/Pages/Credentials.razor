@page "/infrastructure/credentials"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Credentials – backdafuckup</PageTitle>
<div class="d-flex align-center mb-2">
    <MudText Typo="Typo.h4">Windows Credentials</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _adding = true)" Disabled="_adding">Add credentials</MudButton>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Administrator accounts for the push installation of the guest agent over SMB (port 445). Passwords are stored encrypted
    and never shown again. Use <span class="mono">DOMAIN\user</span>, <span class="mono">user@domain</span> or
    <span class="mono">.\Administrator</span> for a local account (other local administrators are restricted by UAC for
    network logons).
</MudText>

@if (_adding)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_user" Label="User name" Variant="Variant.Outlined" Immediate="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-4">
            <MudButton OnClick="@(() => _adding = false)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_user) || string.IsNullOrEmpty(_password))" OnClick="AddAsync">Save</MudButton>
        </div>
    </MudPaper>
}

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable Items="_items" Dense="true" Hover="true" Elevation="1">
        <HeaderContent><MudTh>User</MudTh><MudTh>Description</MudTh><MudTh>Added</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><span class="mono">@context.UserName</span></MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>@Fmt.Time(context.CreatedUtc)</MudTd>
            <MudTd Style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No Windows credentials yet.</MudText></NoRecordsContent>
    </MudTable>
}

<div class="d-flex align-center mt-8 mb-2">
    <MudText Typo="Typo.h4">Linux Credentials</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _addingLinux = true)" Disabled="_addingLinux">Add credentials</MudButton>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Accounts for restoring files into Linux VMs over SSH (port 22): <span class="mono">root</span>, or an account that may
    use <span class="mono">sudo</span>. Enter the sudo password if sudo asks for one. Password or private key (OpenSSH or PEM);
    everything is stored encrypted and never shown again.
</MudText>

@if (_addingLinux)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_linuxUser" Label="User name" Variant="Variant.Outlined" Immediate="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_linuxPassword" Label="Password (or a key below)" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_linuxSudo" Label="sudo password (optional)" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="Usually the same as the login password" /></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="_linuxKey" Label="Private key (optional)" Lines="4" Variant="Variant.Outlined" Immediate="true" Class="mono" Placeholder="-----BEGIN OPENSSH PRIVATE KEY-----" /></MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_linuxPassphrase" Label="Key passphrase (optional)" InputType="InputType.Password" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_linuxDescription" Label="Description (optional)" Variant="Variant.Outlined" Class="mt-2" />
            </MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-4">
            <MudButton OnClick="@(() => _addingLinux = false)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddLinuxAsync"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_linuxUser) || (string.IsNullOrEmpty(_linuxPassword) && string.IsNullOrWhiteSpace(_linuxKey)))">Save</MudButton>
        </div>
    </MudPaper>
}

@if (_linux is not null)
{
    <MudTable Items="_linux" Dense="true" Hover="true" Elevation="1">
        <HeaderContent><MudTh>User</MudTh><MudTh>Logon</MudTh><MudTh>sudo password</MudTh><MudTh>Description</MudTh><MudTh>Added</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><span class="mono">@context.UserName</span></MudTd>
            <MudTd>@(context.UsesPrivateKey ? "private key" : "password")</MudTd>
            <MudTd>@(context.HasSudoPassword ? "yes" : "no")</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>@Fmt.Time(context.CreatedUtc)</MudTd>
            <MudTd Style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteLinuxAsync(context))" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No Linux credentials yet.</MudText></NoRecordsContent>
    </MudTable>
}

<MudText Typo="Typo.h5" Class="mt-8 mb-2">Known SSH hosts</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    The first connection to a VM trusts its host key; later connections must present the same key. After a reinstall of
    the VM, remove its old key here.
</MudText>
@if (_hosts is not null)
{
    <MudTable Items="_hosts" Dense="true" Hover="true" Elevation="1">
        <HeaderContent><MudTh>Host</MudTh><MudTh>Key</MudTh><MudTh>Trusted</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><span class="mono">@context.Host:@context.Port</span></MudTd>
            <MudTd><span class="mono">@context.KeyType SHA256:@context.Fingerprint</span></MudTd>
            <MudTd>@Fmt.Time(context.TrustedUtc)@(context.TrustedBy is null ? "" : $" ({context.TrustedBy})")</MudTd>
            <MudTd Style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => ForgetHostAsync(context))" /></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No SSH hosts yet.</MudText></NoRecordsContent>
    </MudTable>
}

@code {
    private List<WindowsCredentialDto>? _items;
    private bool _adding;
    private bool _busy;
    private string _user = string.Empty;
    private string _password = string.Empty;
    private string? _description;
    private List<LinuxCredentialDto>? _linux;
    private List<SshHostKeyDto>? _hosts;
    private bool _addingLinux;
    private string _linuxUser = string.Empty;
    private string _linuxPassword = string.Empty;
    private string? _linuxSudo;
    private string? _linuxKey;
    private string? _linuxPassphrase;
    private string? _linuxDescription;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _items = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
        _linux = await Api.GetAsync<List<LinuxCredentialDto>>("api/credentials/linux");
        _hosts = await Api.GetAsync<List<SshHostKeyDto>>("api/ssh-host-keys");
    }

    private async Task AddLinuxAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync("api/credentials/linux", new SaveLinuxCredentialDto(_linuxUser.Trim(), _linuxPassword, _linuxKey, _linuxPassphrase, _linuxSudo, _linuxDescription));
            Snackbar.Add($"Linux credentials for {_linuxUser} saved.", Severity.Success);
            _addingLinux = false;
            _linuxUser = _linuxPassword = string.Empty;
            _linuxSudo = _linuxKey = _linuxPassphrase = _linuxDescription = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteLinuxAsync(LinuxCredentialDto credential)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete credentials", $"Delete the Linux credentials of {credential.UserName}?", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/credentials/linux/{credential.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ForgetHostAsync(SshHostKeyDto host)
    {
        if (await Dialogs.ShowMessageBoxAsync("Forget host key", $"Forget the host key of {host.Host}:{host.Port}? The next connection trusts whatever key the host presents.", yesText: "Forget", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/ssh-host-keys/{host.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AddAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync("api/credentials", new SaveWindowsCredentialDto(_user.Trim(), _password, _description));
            Snackbar.Add($"Credentials for {_user} saved.", Severity.Success);
            _adding = false;
            _user = string.Empty;
            _password = string.Empty;
            _description = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(WindowsCredentialDto credential)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete credentials", $"Delete the credentials of {credential.UserName}? Jobs that install the agent with them stop doing so.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/credentials/{credential.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
