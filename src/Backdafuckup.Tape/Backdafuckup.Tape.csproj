<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tape: SCSI commands from the public T10 standards (SPC, SSC, SMC), transports for Linux (SG_IO) and Windows
    (SCSI pass-through), drives, changers and the on-tape format. No vendor SDKs or tools.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Backdafuckup.Core\Backdafuckup.Core.csproj" />
    <PackageReference Include="ZstdSharp.Port" />
    <!-- Argon2id for tape passphrases (MIT, fully managed); the .NET libraries have no memory-hard KDF. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Backdafuckup.Tape.Tests" />
  </ItemGroup>
</Project>
