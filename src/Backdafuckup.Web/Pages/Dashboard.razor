@page "/"
@implements IDisposable
@inject ApiClient Api
@inject LiveConnection Live

<PageTitle>Home – backdafuckup</PageTitle>
<PageHeader Title="Home" Description="Backups of the last 24 hours, what runs now and how full the repositories are." />

@if (_data is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="3"><StatTile Title="Succeeded (24 h)" Value="@_data.JobsSucceeded24h.ToString()" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatTile Title="Warnings (24 h)" Value="@_data.JobsWarning24h.ToString()" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatTile Title="Failed (24 h)" Value="@_data.JobsFailed24h.ToString()" Color="Color.Error" Icon="@Icons.Material.Filled.Error" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatTile Title="Protected VMs" Value="@($"{_data.ProtectedVms} / {_data.ProtectedVms + _data.UnprotectedVms}")" Color="Color.Primary" Icon="@Icons.Material.Filled.Shield" /></MudItem>

        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6" Class="section-title">Recent sessions</MudText>
                    <MudSpacer />
                    <MudButton Href="/sessions" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">All sessions</MudButton>
                </div>
                <SessionTable Sessions="_data.RecentSessions" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudStack Spacing="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.h6" Class="section-title">Running</MudText>
                        @if (_data.RunningSessions.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-2">@_data.RunningSessions.Count</MudChip>
                        }
                    </div>
                    @if (_data.RunningSessions.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing is running.</MudText>
                    }
                    @foreach (var s in _data.RunningSessions)
                    {
                        var kind = ObjectKindUi.Session(s);
                        <div class="mb-3">
                            <div class="d-flex align-center">
                                <span title="@kind.Title" class="d-flex">@AppIcons.Svg(kind.Icon, $"kind-icon {kind.Css}")</span>
                                <MudLink Href="@($"/sessions/{s.Id}")" Typo="Typo.body2" Style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@s.Name</MudLink>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="ml-2 nowrap">@(s.Kind == "SqlBackup" ? "running" : $"{s.Progress:0} %")</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Value="@s.Progress" Indeterminate="@(s.Kind == "SqlBackup")" Rounded="true" Size="Size.Small" Class="mt-1" />
                            <span class="cell-sub">@Fmt.Kind(s.Kind, s.ObjectKind) · since @Fmt.Time(s.StartedUtc ?? s.CreatedUtc)</span>
                        </div>
                    }
                </MudPaper>
                <MudPaper Class="pa-4" Elevation="1">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.h6" Class="section-title">Repositories</MudText>
                        <MudSpacer />
                        <MudButton Href="/infrastructure/repositories" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">Manage</MudButton>
                    </div>
                    @foreach (var r in _data.Repositories)
                    {
                        var used = r.TotalBytes is > 0 && r.FreeBytes is { } free ? 100.0 * (r.TotalBytes.Value - free) / r.TotalBytes.Value : 0;
                        <div class="mb-3">
                            <div class="d-flex align-center mb-1">
                                <MudText Typo="Typo.body1" Style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Name</MudText>
                                <MudSpacer />
                                <StateChip State="@r.State" />
                            </div>
                            <MudProgressLinear Color="@(used > 90 ? Color.Error : used > 75 ? Color.Warning : Color.Primary)" Value="@used" Size="Size.Medium" Rounded="true" />
                            <span class="cell-sub mt-1">@($"{used:0} % used") · @Fmt.Bytes(r.FreeBytes) free of @Fmt.Bytes(r.TotalBytes) · @r.RestorePoints restore points</span>
                        </div>
                    }
                    @if (_data.Repositories.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No repository yet. <MudLink Href="/infrastructure/repositories">Add one</MudLink>.</MudText>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardDto? _data;
    private DateTime _lastLoad;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Live.SessionUpdated += OnSessionUpdated;
        try
        {
            await Live.EnsureStartedAsync();
        }
        catch (Exception)
        {
            // Live updates are optional; the page still works.
        }
    }

    private async Task LoadAsync()
    {
        _lastLoad = DateTime.UtcNow;
        _data = await Api.GetAsync<DashboardDto>("api/dashboard");
    }

    private void OnSessionUpdated(SessionSummaryDto session)
    {
        if (DateTime.UtcNow - _lastLoad > TimeSpan.FromSeconds(2))
        {
            _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
    }

    public void Dispose() => Live.SessionUpdated -= OnSessionUpdated;
}
