    {
      "type": "timeseries",
      "title": "Snapshot release p90 (VM.destroy + data_destroy)",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le, storage) (increase(bdfu_snapshot_release_seconds_bucket{pool=~\"$pool\"}[1d])))",
