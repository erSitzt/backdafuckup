@* "application" or "crash" consistency of a restore point or a database, with the reason as a tooltip. *@
@if (Consistency == "application")
{
    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@AppIcons.ApplicationConsistent">application-consistent</MudChip>
}
else
{
    <MudTooltip Text="@($"The newest changes before the snapshot may be missing. {Reason}")">
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">crash-consistent</MudChip>
    </MudTooltip>
}

@code {
    [Parameter]
    public string Consistency { get; set; } = "crash";

    [Parameter]
    public string? Reason { get; set; }
}
