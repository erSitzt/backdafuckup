@page "/jobs/new"
@page "/jobs/{Id:guid}"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "New job" : "Edit job") – backdafuckup</PageTitle>
<PageHeader Title="@(Id is null ? "New Backup Job" : $"Edit {_name}")" Back="/jobs" />

@if (_pools is null || _repositories is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="wizard" Elevation="0" Outlined="true">
        <WizardSteps Steps="Steps" Current="_step" Hints="Hints()" OnSelect="GoTo" />

        <div class="wizard-body">
            <div class="wizard-step-head">
                <MudText Typo="Typo.h6" Class="section-title">@StepTitles[_step]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@StepIntros[_step]</MudText>
            </div>

            @switch (_step)
            {
                case 0:
                    <div class="form-narrow">
                        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Class="mb-4" AutoFocus="true" />
                        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="3"
                                      HelperText="Optional: what the job is for, or whom to ask about it." />
                        <MudText Typo="Typo.body2" Class="mt-5 mb-2"><b>What the job backs up</b></MudText>
                        <MudToggleGroup T="string" Value="_kind" ValueChanged="OnKindChangedAsync" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary"
                                        Outlined="true" CheckMark="false" Disabled="@(Id is not null)">
                            <MudToggleItem T="string" Value="@KindVms">
                                <span class="d-flex align-center gap-2"><MudIcon Icon="@AppIcons.Vm" Size="Size.Small" />Virtual machines</span>
                            </MudToggleItem>
                            <MudToggleItem T="string" Value="@KindNamespaces">
                                <span class="d-flex align-center gap-2"><MudIcon Icon="@AppIcons.Kubernetes" Size="Size.Small" />Kubernetes namespaces</span>
                            </MudToggleItem>
                        </MudToggleGroup>
                        <MudText Typo="Typo.caption" Class="help-text">
                            @(Id is not null
                                ? "A saved job keeps what it backs up; create a new job for the other kind."
                                : IsCluster
                                    ? "Namespaces of a Kubernetes cluster: their objects, and the data of their volumes whose storage takes CSI snapshots."
                                    : "VMs of a pool: their disks, with change tracking, and optionally application-consistent through the agent.")
                        </MudText>
                    </div>
                    break;

                case 1:
                    @if (!Connections.Any())
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            @if (IsCluster)
                            {
                                <span>No Kubernetes cluster yet. Add one under <MudLink Href="/infrastructure/kubernetes">Kubernetes Clusters</MudLink>; its namespaces are listed here then.</span>
                            }
                            else
                            {
                                <span>No virtualization pool yet. Add one under <MudLink Href="/infrastructure/pools">Virtualization Pools</MudLink>; its VMs are listed here then.</span>
                            }
                        </MudAlert>
                    }
                    <div class="field-toolbar">
                        <MudSelect T="Guid" Value="_connectionId" ValueChanged="OnPoolChangedAsync" Label="@(IsCluster ? "Cluster" : "Pool")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(id => _pools.FirstOrDefault(p => p.Id == id)?.DisplayName ?? string.Empty)">
                            @foreach (var pool in Connections)
                            {
                                <MudSelectItem T="Guid" Value="pool.Id">@pool.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_vmFilter" Placeholder="@(IsCluster ? "Filter namespaces" : "Filter VMs")" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
                        <div class="field-toolbar-end">
                            <span class="mini-chip @(_selected.Count > 0 ? "success" : null)">@_selected.Count selected</span>
                            @if (_withMemory.Count > 0)
                            {
                                <span class="mini-chip info">@_withMemory.Count with memory</span>
                            }
                        </div>
                    </div>
                    @if (IsCluster)
                    {
                        <div class="mb-3">
                            <MudTextField T="string" @bind-Value="_labelSelector" Immediate="true" DebounceInterval="250" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Label="And every namespace with these labels (optional)" Placeholder="backup=daily"
                                          Error="@(SelectorError is not null)" ErrorText="@SelectorError"
                                          HelperText="As kubectl -l: key=value, key!=value, key in (a,b), key notin (a,b), key, !key; separated by commas, all have to hold. Checked at every run, so namespaces that get the labels later are backed up too." />
                            @if (SelectorMatches is { } matches)
                            {
                                <div class="cell-sub mt-1">Has the labels now: @(matches.Count == 0 ? "no namespace" : string.Join(", ", matches))</div>
                            }
                        </div>
                        <div class="table-box">
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" FixedHeader="true">
                                <thead><tr><th style="width:48px"></th><th>Namespace</th><th class="num">PVCs</th><th class="num">With data (snapshot)</th><th>Phase</th></tr></thead>
                                <tbody>
                                    @foreach (var ns in _vms.Where(v => string.IsNullOrWhiteSpace(_vmFilter) || v.Name.Contains(_vmFilter, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <tr class="@(_selected.ContainsKey(ns.NativeId) ? "row-selected" : null)">
                                            <td><MudCheckBox T="bool" Value="@_selected.ContainsKey(ns.NativeId)" ValueChanged="@(on => Toggle(ns, on))" Dense="true" Color="Color.Primary" /></td>
                                            <td>
                                                @ns.Name
                                                @if (SelectorMatches?.Contains(ns.Name) == true)
                                                {
                                                    <span class="mini-chip info" title="Backed up for its labels">by labels</span>
                                                }
                                            </td>
                                            <td class="num">@ns.Properties.GetValueOrDefault("volumeClaims")</td>
                                            <td class="num">@ns.Properties.GetValueOrDefault("snapshotVolumes")</td>
                                            <td>@ns.Properties.GetValueOrDefault("phase")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                        <div class="form-note mt-3">
                            <MudIcon Icon="@AppIcons.Kubernetes" Size="Size.Small" />
                            <span>
                                Every object of a namespace is backed up, Secrets included. PVCs on a CSI driver with a VolumeSnapshotClass are backed up with their data
                                (a snapshot, read by a mover pod, deleted right after); other PVCs, e.g. on NFS, only as objects. Pods with the annotation
                                <span class="mono nowrap">pre.hook.backup.velero.io/command</span> run it before the snapshots (application-consistent), and
                                <span class="mono nowrap">post.hook.backup.velero.io/command</span> after them.
                            </span>
                        </div>
                        break;
                    }
                    <div class="table-box">
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" FixedHeader="true">
                            <thead><tr><th style="width:48px"></th><th>VM</th><th>Power</th><th>Disks</th><th title="Snapshot with memory: the VM can be resumed on restore">With memory</th></tr></thead>
                            <tbody>
                                @foreach (var vm in _vms.Where(v => string.IsNullOrWhiteSpace(_vmFilter) || v.Name.Contains(_vmFilter, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <tr class="@(_selected.ContainsKey(vm.NativeId) ? "row-selected" : null)">
                                        <td><MudCheckBox T="bool" Value="@_selected.ContainsKey(vm.NativeId)" ValueChanged="@(on => Toggle(vm, on))" Dense="true" Color="Color.Primary" /></td>
                                        <td>@vm.Name</td>
                                        <td>@vm.Properties.GetValueOrDefault("powerState")</td>
                                        <td class="nowrap">@vm.Properties.GetValueOrDefault("diskCount") (@Fmt.Bytes(long.TryParse(vm.Properties.GetValueOrDefault("diskBytes"), out var b) ? b : null))</td>
                                        <td>
                                            <MudSwitch T="bool" Value="@_withMemory.Contains(vm.NativeId)" ValueChanged="@(on => ToggleMemory(vm.NativeId, on))" Size="Size.Small" Color="Color.Primary"
                                                       Disabled="@(!_selected.ContainsKey(vm.NativeId))"
                                                       title="@($"RAM {Fmt.Bytes(long.TryParse(vm.Properties.GetValueOrDefault("memoryBytes"), out var m) ? m : null)}: written at every backup")" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                    <div class="form-note mt-3">
                        <MudIcon Icon="@AppIcons.Memory" Size="Size.Small" />
                        <span>
                            <b>With memory</b> (snapshot with RAM): the VM is paused while its RAM is written and all its disks are captured, so the disks match each other and a
                            restore can resume the VM where it was. It costs a pause of the RAM write plus every disk (about a minute for 16 GB and four disks on shared LVM),
                            RAM-sized space on the VM's storage during the backup and in every restore point, and disks marked [NOBAK] are captured too (not backed up).
                            These VMs get no guest processing (VSS). A VM that is not running gets a normal snapshot.
                        </span>
                    </div>
                    break;

                case 2:
                    <div class="field-grid repo-row">
                        <MudSelect T="Guid" @bind-Value="_repositoryId" Label="Backup repository" Variant="Variant.Outlined">
                            @foreach (var repository in _repositories)
                            {
                                <MudSelectItem T="Guid" Value="repository.Id">@repository.Name (@Fmt.Bytes(repository.FreeBytes) free)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField @bind-Value="_retention" Label="Restore points to keep" Min="1" Max="10000" Variant="Variant.Outlined"
                                         HelperText="Older ones are deleted after each run." />
                    </div>

                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="form-sections">
                        <MudExpansionPanel>
                            <TitleContent>
                                <SectionTitle Icon="@AppIcons.Performance" Title="Transport and performance" Summary="@TransportSummary()" />
                            </TitleContent>
                            <ChildContent>
                                <div class="form-wide">
                                    @if (IsCluster)
                                    {
                                        <div class="field-grid cols-4">
                                            <MudNumericField @bind-Value="_parallelVms" Label="Namespaces in parallel" Min="1" Max="16" Variant="Variant.Outlined" />
                                            <MudNumericField @bind-Value="_parallelDisks" Label="Volumes per namespace in parallel" Min="1" Max="8" Variant="Variant.Outlined" />
                                            <MudNumericField @bind-Value="_retries" Label="Retries for failed namespaces" Min="0" Max="10" Variant="Variant.Outlined" />
                                        </div>
                                        <MudText Typo="Typo.caption" Class="help-text">
                                            Each volume is read by its own mover pod. The snapshots of a namespace are taken one after another, before any volume is read.
                                        </MudText>
                                    }
                                    else
                                    {
                                    <MudSelect T="string" @bind-Value="_transport" Label="Disk transport" Variant="Variant.Outlined" Class="form-narrow">
                                        <MudSelectItem T="string" Value="@TransportModes.Automatic">Automatic (NBD, otherwise HTTP export)</MudSelectItem>
                                        <MudSelectItem T="string" Value="@TransportModes.NbdOnly">NBD only</MudSelectItem>
                                        <MudSelectItem T="string" Value="@TransportModes.HttpExportOnly">HTTP export only</MudSelectItem>
                                    </MudSelect>
                                    <MudText Typo="Typo.caption" Class="help-text">
                                        NBD reads disks in parallel and, with change tracking, only the changed blocks. The HTTP export needs no network setup,
                                        but uses one stream per disk and transfers the whole allocated disk on every backup.
                                    </MudText>
                                    <div class="field-grid cols-4">
                                        <MudNumericField @bind-Value="_parallelVms" Label="VMs in parallel" Min="1" Max="16" Variant="Variant.Outlined" />
                                        <MudNumericField @bind-Value="_parallelDisks" Label="Disks per VM in parallel" Min="1" Max="8" Variant="Variant.Outlined" />
                                        <MudNumericField @bind-Value="_nbdConnections" Label="NBD connections per disk" Min="1" Max="12" Variant="Variant.Outlined" />
                                        <MudNumericField @bind-Value="_retries" Label="Retries for failed VMs" Min="0" Max="10" Variant="Variant.Outlined" />
                                    </div>
                                    <MudText Typo="Typo.caption" Class="help-text">
                                        Each disk is read as its own stream. Parallel streams speed up the HTTP export, which is limited per stream,
                                        until the network is full: on a 1 Gbit/s link about two streams already reach the line rate.
                                    </MudText>
                                    }
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>

                        @if (!IsCluster)
                        {
                        <MudExpansionPanel>
                            <TitleContent>
                                <SectionTitle Icon="@AppIcons.ApplicationConsistent" Title="Guest processing" Summary="@GuestSummary()" On="_guest" />
                            </TitleContent>
                            <ChildContent>
                                <div class="form-wide">
                                    <MudSwitch T="bool" @bind-Value="_guest" Color="Color.Primary" Label="Application-consistent backups through the backdafuckup agent" />
                                    <MudText Typo="Typo.caption" Class="help-text">
                                        The agent freezes SQL Server, Active Directory, Exchange and other VSS-aware applications in Windows VMs while
                                        the snapshot is taken (VSS backups are copy-only: other backup products are not disturbed). Without it,
                                        backups are crash-consistent, like after a power failure.
                                    </MudText>
                                    @if (_guest)
                                    {
                                        <MudSelect T="string" @bind-Value="_guestMode" Label="Method" Variant="Variant.Outlined">
                                            <MudSelectItem T="string" Value="@GuestProcessingModes.Vss">VSS for every VM</MudSelectItem>
                                            <MudSelectItem T="string" Value="@GuestProcessingModes.SqlSnapshot">SQL Server snapshot where SQL Server 2022+ runs, VSS for all other VMs</MudSelectItem>
                                        </MudSelect>
                                        <MudText Typo="Typo.caption" Class="help-text">
                                            @if (_guestMode == GuestProcessingModes.SqlSnapshot)
                                            {
                                                <text>
                                                    VMs with SQL Server 2022 or later: the agent suspends the writes of the SQL Server databases (reads go
                                                    on) until the VM snapshot is taken, however long it takes, and records it in msdb as a backup of the
                                                    chosen type. The databases are application-consistent, other files crash-consistent. Writes wait during
                                                    the snapshot; applications with short timeouts may see errors meanwhile.
                                                    All other VMs (no SQL Server, an older one, or no database could be suspended) use VSS, as with the
                                                    first method.
                                                </text>
                                            }
                                            else
                                            {
                                                <text>
                                                    All VSS-aware applications (SQL Server, Active Directory, Exchange, files). Windows holds the writes for
                                                    at most 10 s: on slow storage or with many disks the snapshot takes longer, and the backup is then
                                                    crash-consistent; the session log shows the snapshot time.
                                                </text>
                                            }
                                        </MudText>
                                        @if (_guestMode == GuestProcessingModes.SqlSnapshot)
                                        {
                                            <div class="field-grid cols-2">
                                                <MudSelect T="Guid?" @bind-Value="_sqlCredentialId" Label="SQL Server account" Variant="Variant.Outlined" Clearable="true"
                                                           HelperText="A Windows account or SQL Server login that is sysadmin on the SQL Server instances (Credentials).">
                                                    @foreach (var (id, label) in _sqlAccounts)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="id">@label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <MudSelect T="bool" @bind-Value="_sqlCopyOnly" Label="SQL Server backup type" Variant="Variant.Outlined">
                                                    <MudSelectItem T="bool" Value="false">Full backup (in the backup chain)</MudSelectItem>
                                                    <MudSelectItem T="bool" Value="true">Copy-only backup (outside the backup chain)</MudSelectItem>
                                                </MudSelect>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="help-text">
                                                @if (_sqlCopyOnly)
                                                {
                                                    <text>
                                                        Changes nothing in the databases' backup chains: for VMs whose SQL Server backups another tool takes
                                                        (e.g. with differential backups), or for backups kept apart. Log backups cannot build on it while a
                                                        database has no regular full backup.
                                                    </text>
                                                }
                                                else
                                                {
                                                    <text>
                                                        A regular full backup: log backups and differential backups (also those of other tools) build on it.
                                                        For a database in FULL recovery without a full backup it starts the log chain: from then on only log
                                                        backups free its transaction log, otherwise it grows. The session log warns about such databases and
                                                        about log chains without a log backup for a day. VMs that fall back to VSS get copy-only backups.
                                                    </text>
                                                }
                                            </MudText>
                                        }
                                        <div class="field-grid cols-2">
                                            <MudSelect T="string" @bind-Value="_guestPolicy" Label="If the guest cannot be frozen" Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@GuestFailurePolicies.CrashConsistentWithWarning">Back up crash-consistently and warn</MudSelectItem>
                                                <MudSelectItem T="string" Value="@GuestFailurePolicies.FailVm">Fail the VM</MudSelectItem>
                                            </MudSelect>
                                            <MudSelect T="Guid?" @bind-Value="_guestCredentialId" Label="Install the agent where it is missing, with" Variant="Variant.Outlined" Clearable="true"
                                                       HelperText="Windows administrator credentials (SMB 445); leave empty to install agents yourself.">
                                                @foreach (var credential in _credentials)
                                                {
                                                    <MudSelectItem T="Guid?" Value="credential.Id">@credential.UserName</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                    }
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>

                        <MudExpansionPanel>
                            <TitleContent>
                                <SectionTitle Icon="@AppIcons.Database" Title="SQL Server backups (log chain)" Summary="@SqlSummary()" On="_sqlBackup" />
                            </TitleContent>
                            <ChildContent>
                                <div class="form-wide">
                                    <MudSwitch T="bool" @bind-Value="_sqlBackup" Color="Color.Primary" Label="Log, full and system database backups through the agent in the VMs" />
                                    <MudText Typo="Typo.caption" Class="help-text">
                                        The agent backs up the transaction logs of every database in FULL or BULK_LOGGED recovery, sends the files to
                                        the repository and deletes them in the VM afterwards; databases can then be restored to any second.
                                        backdafuckup owns the log chain: switch off log backups of other tools (maintenance plans, Ola Hallengren,
                                        other backup products), the session warns about them. If the backup server is unreachable, the log backups
                                        pause; files whose upload failed wait in the VM.
                                    </MudText>
                                    @if (_sqlBackup)
                                    {
                                        @if (!(_guest && _guestMode == GuestProcessingModes.SqlSnapshot))
                                        {
                                            <MudSelect T="Guid?" @bind-Value="_sqlCredentialId" Label="SQL Server account" Variant="Variant.Outlined" Clearable="true" Class="form-narrow mb-2"
                                                       HelperText="A Windows account or SQL Server login that is sysadmin on the SQL Server instances (Credentials).">
                                                @foreach (var (id, label) in _sqlAccounts)
                                                {
                                                    <MudSelectItem T="Guid?" Value="id">@label</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }

                                        <div class="form-subhead">Log backups</div>
                                        <div class="field-grid cols-fixed">
                                            <MudSelect T="string" @bind-Value="_logPreset" Label="Every" Variant="Variant.Outlined">
                                                @foreach (var minutes in SqlBackupSettingsDto.PresetIntervals)
                                                {
                                                    <MudSelectItem T="string" Value="@minutes.ToString(System.Globalization.CultureInfo.InvariantCulture)">@minutes minutes</MudSelectItem>
                                                }
                                                <MudSelectItem T="string" Value="@("custom")">Longer (minutes)</MudSelectItem>
                                            </MudSelect>
                                            @if (_logPreset == "custom")
                                            {
                                                <MudNumericField T="int" @bind-Value="_logCustom" Label="Minutes (60–1440)" Min="60" Max="1440" Variant="Variant.Outlined" />
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Class="help-text">
                                            The interval is the most data a restore can lose (RPO). The runs start at fixed times from midnight in the
                                            job's time zone (e.g. :00, :15, :30, :45).
                                        </MudText>

                                        <div class="form-subhead">Full backups of the databases</div>
                                        <div class="field-grid cols-fixed">
                                            <MudSelect T="string" @bind-Value="_fullKind" Label="Schedule" Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@("None")">Never</MudSelectItem>
                                                <MudSelectItem T="string" Value="@("Daily")">Daily</MudSelectItem>
                                                <MudSelectItem T="string" Value="@("Weekly")">On selected weekdays</MudSelectItem>
                                            </MudSelect>
                                            @if (_fullKind != "None")
                                            {
                                                <MudTextField @bind-Value="_fullTime" Label="Time (HH:mm)" Variant="Variant.Outlined" />
                                            }
                                        </div>
                                        @if (_fullKind == "Weekly")
                                        {
                                            <WeekdayPicker Days="_fullDays" />
                                        }
                                        <div class="check-stack">
                                            <MudCheckBox T="bool" @bind-Value="_fullForAll" Color="Color.Primary" Label="Also for databases whose base is the SQL Server snapshot of the image backup" />
                                            <MudText Typo="Typo.caption" Class="help-text">
                                                A native full backup (BACKUP DATABASE, verified) is the base of the log chain where there is no SQL Server
                                                snapshot: SQL Server before 2022, or VSS as method. Restores need the newest full before the point in time
                                                and every log backup after it.
                                            </MudText>
                                            <MudCheckBox T="bool" @bind-Value="_fullOnBreak" Color="Color.Primary" Label="Start a missing or broken log chain with a full backup at once" />
                                            <MudText Typo="Typo.caption" Class="help-text">
                                                For new databases, after a switch to SIMPLE and back, or after another tool's log backup. Without it the chain
                                                restarts only with the next scheduled full or image backup.
                                            </MudText>
                                        </div>

                                        <div class="form-subhead">System databases (master, msdb, model)</div>
                                        <div class="field-grid cols-fixed">
                                            <MudSelect T="string" @bind-Value="_systemKind" Label="Full backups" Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@("None")">Never</MudSelectItem>
                                                <MudSelectItem T="string" Value="@("Daily")">Daily</MudSelectItem>
                                                <MudSelectItem T="string" Value="@("Weekly")">On selected weekdays</MudSelectItem>
                                            </MudSelect>
                                            @if (_systemKind != "None")
                                            {
                                                <MudTextField @bind-Value="_systemTime" Label="Time (HH:mm)" Variant="Variant.Outlined" />
                                            }
                                        </div>
                                        @if (_systemKind == "Weekly")
                                        {
                                            <WeekdayPicker Days="_systemDays" />
                                        }

                                        <div class="form-subhead">Databases and files</div>
                                        <div class="field-grid cols-2">
                                            <MudTextField @bind-Value="_sqlExcluded" Label="Leave out databases (comma-separated)" Variant="Variant.Outlined" />
                                            <MudTextField @bind-Value="_sqlStaging" Label="Folder in the VM for the backup files until they are sent" Variant="Variant.Outlined"
                                                          HelperText="Empty: the instance's backup folder (a subfolder backdafuckup). SQL Server's service must be able to write there." />
                                        </div>
                                    }
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                    break;

                case 3:
                    <div class="form-narrow">
                        <MudToggleGroup T="string" @bind-Value="_scheduleKind" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Outlined="true" CheckMark="false" Class="mb-4">
                            <MudToggleItem T="string" Value="@("None")" Text="Run manually" />
                            <MudToggleItem T="string" Value="@("Daily")" Text="Daily" />
                            <MudToggleItem T="string" Value="@("Weekly")" Text="On selected weekdays" />
                        </MudToggleGroup>
                        @if (_scheduleKind == "None")
                        {
                            <div class="form-note">
                                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" />
                                <span>The job runs only when it is started under Backup Jobs or through the API.</span>
                            </div>
                        }
                        else
                        {
                            @if (_scheduleKind == "Weekly")
                            {
                                <div class="field-label">Weekdays</div>
                                <WeekdayPicker Days="_days" />
                            }
                            <div class="field-grid schedule-row mt-2">
                                <MudTextField @bind-Value="_time" Label="Time (HH:mm)" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="_timeZone" Label="Time zone (IANA, e.g. Europe/Berlin)" Variant="Variant.Outlined" />
                            </div>
                        }
                    </div>
                    break;

                default:
                    <div class="summary-grid">
                        <section class="summary-card">
                            <div class="summary-card-head"><MudIcon Icon="@AppIcons.Job" Size="Size.Small" /> Job</div>
                            <dl class="summary-list">
                                <dt>Name</dt><dd>@_name</dd>
                                @if (!string.IsNullOrWhiteSpace(_description))
                                {
                                    <dt>Description</dt><dd>@_description</dd>
                                }
                                <dt>Schedule</dt><dd>@Jobs.Describe(Schedule())@(_scheduleKind == "None" ? null : $" ({_timeZone})")</dd>
                            </dl>
                        </section>
                        <section class="summary-card">
                            <div class="summary-card-head"><MudIcon Icon="@(IsCluster ? AppIcons.Kubernetes : AppIcons.Vm)" Size="Size.Small" /> @(IsCluster ? "Namespaces" : "Virtual machines")</div>
                            <dl class="summary-list">
                                <dt>@(IsCluster ? "Cluster" : "Pool")</dt><dd>@_pools.FirstOrDefault(p => p.Id == _connectionId)?.DisplayName</dd>
                                <dt>@(IsCluster ? "Namespaces" : "VMs") (@_selected.Count)</dt>
                                <dd>
                                    @foreach (var (nativeId, vmName) in _selected.OrderBy(kv => kv.Value, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <span class="mini-chip">@vmName@(_withMemory.Contains(nativeId) ? " · RAM" : null)</span>
                                    }
                                </dd>
                                @if (IsCluster && !string.IsNullOrWhiteSpace(_labelSelector))
                                {
                                    <dt>By labels</dt>
                                    <dd><span class="mini-chip info mono">@_labelSelector.Trim()</span> <span class="cell-sub">now @(SelectorMatches?.Count ?? 0) namespace(s)</span></dd>
                                }
                            </dl>
                        </section>
                        <section class="summary-card">
                            <div class="summary-card-head"><MudIcon Icon="@AppIcons.Repository" Size="Size.Small" /> Storage</div>
                            <dl class="summary-list">
                                <dt>Repository</dt><dd>@_repositories.FirstOrDefault(r => r.Id == _repositoryId)?.Name</dd>
                                <dt>Retention</dt><dd>@_retention restore points</dd>
                                @if (IsCluster)
                                {
                                    <dt>In parallel</dt><dd>@_parallelVms namespace(s), @_parallelDisks volume(s) per namespace</dd>
                                }
                                else
                                {
                                    <dt>Disk transport</dt><dd>@TransportText(_transport)</dd>
                                    <dt>In parallel</dt><dd>@_parallelVms VM(s), @_parallelDisks disk(s) per VM, @_nbdConnections NBD connection(s) per disk</dd>
                                }
                                <dt>Retries</dt><dd>@_retries</dd>
                            </dl>
                        </section>
                        @if (IsCluster)
                        {
                            <section class="summary-card">
                                <div class="summary-card-head"><MudIcon Icon="@AppIcons.ApplicationConsistent" Size="Size.Small" /> Consistency</div>
                                <dl class="summary-list">
                                    <dt>Volumes</dt><dd>crash-consistent snapshots; application-consistent where pods have backup hooks</dd>
                                </dl>
                            </section>
                        }
                        else
                        {
                        <section class="summary-card">
                            <div class="summary-card-head"><MudIcon Icon="@AppIcons.ApplicationConsistent" Size="Size.Small" /> Consistency and SQL Server</div>
                            <dl class="summary-list">
                                <dt>Guest processing</dt>
                                <dd>@(_guest ? $"application-consistent ({(_guestMode == GuestProcessingModes.SqlSnapshot ? $"SQL Server snapshot ({(_sqlCopyOnly ? "copy-only" : "full backups")}), otherwise VSS" : "VSS")}); on failure: {(_guestPolicy == GuestFailurePolicies.FailVm ? "fail the VM" : "crash-consistent with warning")}" + (_guestCredentialId is null ? "" : "; installs missing agents") : "off (crash-consistent)")</dd>
                                <dt>SQL Server backups</dt>
                                <dd>@(_sqlBackup ? $"log backups every {LogInterval()} min; full backups: {Jobs.Describe(SqlSchedule(_fullKind, _fullTime, _fullDays))}; system databases: {Jobs.Describe(SqlSchedule(_systemKind, _systemTime, _systemDays))}" : "off")</dd>
                            </dl>
                        </section>
                        }
                    </div>
                    <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Job enabled" Class="mt-4" />
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text" Class="mt-2">
                        @(IsCluster
                            ? "Each run reads the volumes in full (Kubernetes has no change tracking); the repository stores only the chunks that changed. The mover image must be in a registry the cluster can pull from (Kubernetes Clusters → Mover image)."
                            : "Changed block tracking is enabled on the VMs' disks with the first backup. While it is enabled, storage live migration of those disks is not possible.")
                    </MudAlert>
                    break;
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_error</MudAlert>
            }
        </div>

        <div class="wizard-actions">
            <MudButton Href="/jobs">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Disabled="@(_step == 0)" StartIcon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => GoTo(_step - 1))">Back</MudButton>
            @if (_step < Steps.Length - 1)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => GoTo(_step + 1))">Next</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveAsync">@(Id is null ? "Create job" : "Save job")</MudButton>
            }
        </div>
    </MudPaper>
}

@code {
    private string[] Steps => ["Name", IsCluster ? "Namespaces" : "Virtual machines", "Storage", "Schedule", "Summary"];

    private string[] StepTitles => ["Name", IsCluster ? "Namespaces" : "Virtual machines", "Storage and processing", "Schedule", "Summary"];

    private string[] StepIntros =>
    [
        "How the job appears in lists, sessions and notifications.",
        IsCluster
            ? "The namespaces this job backs up, all from one cluster: their objects, and the data of their PVCs whose storage takes CSI snapshots."
            : "The VMs this job backs up, all from one pool. With memory takes a snapshot with RAM of a VM.",
        IsCluster
            ? "Where the restore points go and how many are kept; how many namespaces and volumes are read at a time."
            : "Where the restore points go and how many are kept; how the disks are read, and how the guests and their SQL Server databases are handled.",
        IsCluster ? "When the job runs." : "When the job runs. SQL Server log backups have their own interval (Storage and processing).",
        "Check the settings, then save the job.",
    ];

    private const string KindVms = "XenServer";
    private const string KindNamespaces = "Kubernetes";

    /// <summary>What the job backs up: VMs of a pool (<see cref="KindVms"/>) or namespaces of a Kubernetes cluster.</summary>
    private string _kind = KindVms;

    private bool IsCluster => _kind == KindNamespaces;

    /// <summary>The pools, or the clusters, the job can use.</summary>
    private IEnumerable<ConnectionDto> Connections => (_pools ?? []).Where(c => c.Kind == _kind);

    private async Task OnKindChangedAsync(string kind)
    {
        _kind = kind;
        _selected.Clear();
        _withMemory.Clear();
        _connectionId = Connections.FirstOrDefault()?.Id ?? Guid.Empty;
        await LoadVmsAsync();
    }

    /// <summary>What was chosen in each step, under its label in the step bar.</summary>
    private IReadOnlyList<string?> Hints() =>
    [
        string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
        _selected.Count == 0 && string.IsNullOrWhiteSpace(_labelSelector) ? null
            : IsCluster ? $"{_selected.Count} namespace(s){(string.IsNullOrWhiteSpace(_labelSelector) ? string.Empty : " + by labels")}" : _withMemory.Count > 0 ? $"{_selected.Count} VM(s), {_withMemory.Count} with memory" : $"{_selected.Count} VM(s)",
        _repositories?.FirstOrDefault(r => r.Id == _repositoryId) is { } repository ? $"{repository.Name} · {_retention} points" : null,
        Jobs.Describe(Schedule()),
        null,
    ];

    private string TransportSummary() => IsCluster
        ? $"{_parallelVms} namespace(s) and {_parallelDisks} volume(s) per namespace in parallel · {_retries} retries"
        : $"{_transport switch { TransportModes.NbdOnly => "NBD only", TransportModes.HttpExportOnly => "HTTP export only", _ => "Automatic transport" }} · " +
        $"{_parallelVms} VM(s) and {_parallelDisks} disk(s) per VM in parallel · {_retries} retries";

    private string GuestSummary() => !_guest
        ? "Off: backups are crash-consistent, like after a power failure"
        : $"{(_guestMode == GuestProcessingModes.SqlSnapshot ? "SQL Server snapshot, VSS for the other VMs" : "VSS for every VM")} · " +
          $"if the guest cannot be frozen: {(_guestPolicy == GuestFailurePolicies.FailVm ? "fail the VM" : "crash-consistent with a warning")}";

    private string SqlSummary() => !_sqlBackup
        ? "Off: SQL Server databases restore only to the times of the image backups"
        : $"Log backups every {LogInterval()} min · full: {Jobs.Describe(SqlSchedule(_fullKind, _fullTime, _fullDays))} · " +
          $"system databases: {Jobs.Describe(SqlSchedule(_systemKind, _systemTime, _systemDays))}";

    private static string TransportText(string mode) => mode switch
    {
        TransportModes.NbdOnly => "NBD only",
        TransportModes.HttpExportOnly => "HTTP export only",
        _ => "Automatic (NBD, otherwise HTTP export)",
    };

    [Parameter] public Guid? Id { get; set; }

    private List<ConnectionDto>? _pools;
    private List<RepositoryDto>? _repositories;
    private List<InventoryItemDto> _vms = [];
    private readonly Dictionary<string, string> _selected = [];

    /// <summary>Kubernetes: the namespaces with these labels too, checked at every run (empty: none).</summary>
    private string _labelSelector = string.Empty;

    private string? SelectorError => string.IsNullOrWhiteSpace(_labelSelector) ? null : KubernetesLabelSelector.Parse(_labelSelector).Error;

    /// <summary>The namespaces of the inventory whose labels match the selector now; null without a valid selector.</summary>
    private List<string>? SelectorMatches
    {
        get
        {
            if (!IsCluster || string.IsNullOrWhiteSpace(_labelSelector) || KubernetesLabelSelector.Parse(_labelSelector).Requirements is not { } requirements)
            {
                return null;
            }

            return [.. _vms.Where(ns => ns.Name != "backdafuckup-system" && KubernetesLabelSelector.Matches(requirements, KubernetesLabelSelector.ParseLabels(ns.Properties.GetValueOrDefault("labels"))))
                .Select(ns => ns.Name)];
        }
    }
    private readonly HashSet<string> _withMemory = [];
    private readonly HashSet<DayOfWeek> _days = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
    private int _step;
    private string _name = string.Empty;
    private string? _description;
    private Guid _connectionId;
    private Guid _repositoryId;
    private int _retention = 14;
    private int _parallelVms = 2;
    private int _nbdConnections = 4;
    private int _parallelDisks = 2;
    private bool _guest;
    private string _guestPolicy = GuestFailurePolicies.CrashConsistentWithWarning;
    private Guid? _guestCredentialId;
    private List<WindowsCredentialDto> _credentials = [];
    private string _guestMode = GuestProcessingModes.Vss;
    private Guid? _sqlCredentialId;
    private bool _sqlCopyOnly;
    private bool _sqlBackup;
    private string _logPreset = "60";
    private int _logCustom = 120;
    private string _fullKind = "Weekly";
    private string _fullTime = "20:00";
    private readonly HashSet<DayOfWeek> _fullDays = [DayOfWeek.Sunday];
    private bool _fullForAll;
    private bool _fullOnBreak = true;
    private string _systemKind = "Daily";
    private string _systemTime = "20:00";
    private readonly HashSet<DayOfWeek> _systemDays = [DayOfWeek.Sunday];
    private string? _sqlExcluded;
    private string? _sqlStaging;
    private List<(Guid Id, string Label)> _sqlAccounts = [];
    private string _transport = TransportModes.Automatic;
    private int _retries = 2;
    private string _scheduleKind = "Daily";
    private string _time = "22:00";
    private string _timeZone = TimeZoneInfo.Local.Id == "UTC" ? "Europe/Berlin" : TimeZoneInfo.Local.Id;
    private string _vmFilter = string.Empty;
    private bool _enabled = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _pools = [.. (await Api.GetAsync<List<ConnectionDto>>("api/connections")).OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)];
        _repositories = await Api.GetAsync<List<RepositoryDto>>("api/repositories");
        _credentials = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
        var logins = await Api.GetAsync<List<SqlCredentialDto>>("api/credentials/sql");
        _sqlAccounts = [.. _credentials.Select(c => (c.Id, $"{c.UserName} (Windows)")), .. logins.Select(c => (c.Id, $"{c.UserName} (SQL login)"))];
        if (Id is { } id)
        {
            var job = await Api.GetAsync<JobDto>($"api/jobs/{id}");
            _name = job.Name;
            _description = job.Description;
            _connectionId = job.ConnectionId;
            _kind = _pools.FirstOrDefault(p => p.Id == job.ConnectionId)?.Kind ?? KindVms;
            _repositoryId = job.RepositoryId;
            _retention = job.RetentionPoints;
            _parallelVms = job.MaxParallelVms;
            _nbdConnections = job.NbdConnectionsPerDisk;
            _parallelDisks = job.MaxParallelDisks;
            _guest = job.GuestProcessing;
            _guestPolicy = job.GuestFailurePolicy;
            _guestCredentialId = job.GuestCredentialId;
            _guestMode = job.GuestProcessingMode;
            _sqlCredentialId = job.SqlCredentialId;
            _sqlCopyOnly = job.SqlSnapshotCopyOnly;
            if (job.SqlBackup is { } sqlBackup)
            {
                _sqlBackup = sqlBackup.Enabled;
                _logPreset = SqlBackupSettingsDto.PresetIntervals.Contains(sqlBackup.LogIntervalMinutes)
                    ? sqlBackup.LogIntervalMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture) : "custom";
                _logCustom = sqlBackup.LogIntervalMinutes;
                (_fullKind, _fullTime) = (sqlBackup.FullSchedule?.Kind ?? "Weekly", sqlBackup.FullSchedule?.TimeOfDay ?? "20:00");
                _fullDays.Clear();
                _fullDays.UnionWith(sqlBackup.FullSchedule?.Days ?? [DayOfWeek.Sunday]);
                (_systemKind, _systemTime) = (sqlBackup.SystemSchedule?.Kind ?? "Daily", sqlBackup.SystemSchedule?.TimeOfDay ?? "20:00");
                _systemDays.Clear();
                _systemDays.UnionWith(sqlBackup.SystemSchedule?.Days ?? [DayOfWeek.Sunday]);
                _fullForAll = sqlBackup.FullForAllDatabases;
                _fullOnBreak = sqlBackup.FullOnChainBreak;
                _sqlExcluded = sqlBackup.ExcludedDatabases is { Count: > 0 } excluded ? string.Join(", ", excluded) : null;
                _sqlStaging = sqlBackup.StagingFolder;
            }

            _transport = job.TransportMode;
            _retries = job.RetryCount;
            _enabled = job.Enabled;
            _scheduleKind = job.Schedule.Kind;
            _time = job.Schedule.TimeOfDay;
            _timeZone = job.Schedule.TimeZoneId;
            _days.Clear();
            _days.UnionWith(job.Schedule.Days);
            foreach (var o in job.Objects)
            {
                if (KubernetesLabelSelector.IsJobObject(o.NativeId))
                {
                    _labelSelector = KubernetesLabelSelector.Of(o.NativeId);
                    continue;
                }

                _selected[o.NativeId] = o.Name;
                if (o.WithMemory)
                {
                    _withMemory.Add(o.NativeId);
                }
            }
        }
        else
        {
            // VMs unless there are only clusters.
            _kind = _pools.Any(p => p.Kind == KindVms) || !_pools.Any(p => p.Kind == KindNamespaces) ? KindVms : KindNamespaces;
            _connectionId = Connections.FirstOrDefault()?.Id ?? Guid.Empty;
            _repositoryId = _repositories.FirstOrDefault()?.Id ?? Guid.Empty;
        }

        await LoadVmsAsync();
    }

    private async Task OnPoolChangedAsync(Guid id)
    {
        _connectionId = id;
        _selected.Clear();
        _withMemory.Clear();
        _labelSelector = string.Empty;
        await LoadVmsAsync();
    }

    private async Task LoadVmsAsync() =>
        _vms = _connectionId == Guid.Empty ? [] : (await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{_connectionId}/inventory"))
            .Where(i => i.Kind == (IsCluster ? "Namespace" : "Vm")).OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).ToList();

    private void Toggle(InventoryItemDto vm, bool on)
    {
        if (on)
        {
            _selected[vm.NativeId] = vm.Name;
        }
        else
        {
            _selected.Remove(vm.NativeId);
            _withMemory.Remove(vm.NativeId);
        }
    }

    private void ToggleMemory(string nativeId, bool on)
    {
        if (on)
        {
            _withMemory.Add(nativeId);
        }
        else
        {
            _withMemory.Remove(nativeId);
        }
    }

    private void GoTo(int step)
    {
        if (step < 0 || step >= Steps.Length)
        {
            return;
        }

        // Moving forward validates every step in between; moving back is always allowed.
        for (var current = _step; current < step; current++)
        {
            _error = Validate(current);
            if (_error is not null)
            {
                _step = current;
                return;
            }
        }

        _error = null;
        _step = step;
    }

    private string? Validate(int step) => step switch
    {
        0 when string.IsNullOrWhiteSpace(_name) => "Enter a name.",
        1 when IsCluster && SelectorError is { } selectorError => selectorError,
        1 when _selected.Count == 0 && !(IsCluster && !string.IsNullOrWhiteSpace(_labelSelector)) => IsCluster ? "Select at least one namespace, or give labels." : "Select at least one VM.",
        2 when _repositoryId == Guid.Empty => "Select a repository.",
        3 when _scheduleKind == "Weekly" && _days.Count == 0 => "Select at least one weekday.",
        3 when _scheduleKind != "None" && !TimeOnly.TryParse(_time, out _) => "Enter the time as HH:mm.",
        _ => null,
    };

    private ScheduleDto Schedule() => new(_scheduleKind, _time, _scheduleKind == "Weekly" ? _days.ToList() : [], _timeZone);

    private ScheduleDto SqlSchedule(string kind, string time, HashSet<DayOfWeek> days) => new(kind, time, kind == "Weekly" ? days.ToList() : [], _timeZone);

    private int LogInterval() => _logPreset == "custom" ? _logCustom : int.Parse(_logPreset, System.Globalization.CultureInfo.InvariantCulture);

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        var request = new SaveJobDto
        {
            Name = _name.Trim(),
            Description = _description,
            Enabled = _enabled,
            ConnectionId = _connectionId,
            RepositoryId = _repositoryId,
            RetentionPoints = _retention,
            Schedule = Schedule(),
            Objects = [.. _selected.Select(kv => new JobObjectDto(kv.Key, kv.Value, !IsCluster && _withMemory.Contains(kv.Key))),
                .. IsCluster && !string.IsNullOrWhiteSpace(_labelSelector)
                    ? [new JobObjectDto(KubernetesLabelSelector.JobObject(_labelSelector), KubernetesLabelSelector.Describe(_labelSelector.Trim()))]
                    : Array.Empty<JobObjectDto>()],
            MaxParallelVms = _parallelVms,
            NbdConnectionsPerDisk = _nbdConnections,
            MaxParallelDisks = _parallelDisks,
            GuestProcessing = _guest && !IsCluster,
            GuestFailurePolicy = _guestPolicy,
            GuestCredentialId = _guest ? _guestCredentialId : null,
            GuestProcessingMode = _guestMode,
            SqlCredentialId = (_guest && _guestMode == GuestProcessingModes.SqlSnapshot) || _sqlBackup ? _sqlCredentialId : null,
            SqlSnapshotCopyOnly = _sqlCopyOnly,
            SqlBackup = new SqlBackupSettingsDto(
                _sqlBackup && !IsCluster,
                LogInterval(),
                SqlSchedule(_fullKind, _fullTime, _fullDays),
                SqlSchedule(_systemKind, _systemTime, _systemDays),
                _fullForAll,
                _fullOnBreak,
                (_sqlExcluded ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                string.IsNullOrWhiteSpace(_sqlStaging) ? null : _sqlStaging.Trim()),
            RetryCount = _retries,
            TransportMode = _transport,
        };
        try
        {
            if (Id is { } id)
            {
                await Api.PutAsync($"api/jobs/{id}", request);
            }
            else
            {
                await Api.PostAsync("api/jobs", request);
            }

            Snackbar.Add($"Job {request.Name} saved.", Severity.Success);
            Navigation.NavigateTo("/jobs");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
