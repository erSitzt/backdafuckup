@page "/infrastructure/kubernetes"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>Kubernetes clusters – backdafuckup</PageTitle>
<PageHeader Title="Kubernetes Clusters"
            Description="Clusters whose namespaces are backed up: their objects, and the data of volumes whose storage takes snapshots. backdafuckup reaches each cluster's API with a ServiceAccount token from the setup manifest, directly or through an agent in the cluster that dials out.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Description" OnClick="ToggleSetupAsync">Setup manifest</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="@(() => _showMover = !_showMover)">Mover image</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _adding = true)" Disabled="_adding">Add cluster</MudButton>
    </Actions>
</PageHeader>

@if (_setup is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.subtitle1" Class="section-title">Setup manifest@(_setupFor is { } forCluster ? $" of {forCluster.DisplayName}, with its agent" : string.Empty)</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopySetupAsync">Copy</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="@SetupUrl(download: true)">Download</MudButton>
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" aria-label="Close" OnClick="@(() => { _setup = null; _setupFor = null; })" />
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Apply it in the cluster yourself (kubectl apply -f @KubernetesSetupFile, or through a GitOps tool such as Fleet or Argo CD). It creates the work namespace backdafuckup-system, a ServiceAccount
            with a token, and the roles. Backup reads every object, Secrets included, takes and removes volume snapshots and runs hooks in pods.
            @if (_setupFor is null)
            {
                <span>Then <b>Add cluster</b> with the token and the cluster CA from its token secret, or add it through an agent.</span>
            }
            else
            {
                <span>With the agent: a Deployment that dials out to this server, and its connect token. Keep the manifest like a password.</span>
            }
        </MudText>
        <MudSwitch T="bool" Value="_withRestore" ValueChanged="OnRestoreChangedAsync" Color="Color.Primary" Class="mb-2"
                   Label="With the restore role: create and change objects in any namespace (leave it off for an account that only backs up)" />
        <pre class="mono" style="max-height: 360px; overflow: auto; background: var(--mud-palette-background-gray); padding: 12px; border-radius: 8px; margin: 0">@_setup</pre>
    </MudPaper>
}

@if (_showMover)
{
    <MoverImagePanel OnClose="@(() => _showMover = false)" OnChanged="@(image => _mover = image)" />
}
else if (_mover is { UpToDate: false } && _clusters is { Count: > 0 })
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
        @(_mover.Registry.Length == 0
            ? "No registry is set for the mover image yet: backups of volume data need it in a registry the cluster can pull from."
            : $"The mover image {_mover.Shipped?.Version} is not in {_mover.Registry} yet; the next backup with volume data pushes it.")
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => _showMover = true)">Mover image</MudButton>
    </MudAlert>
}

@if (_adding)
{
    <AddClusterWizard OnDone="OnClusterAddedAsync" OnCancel="OnClusterAddedAsync" />
}

@if (_clusters is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_clusters.Count == 0 && !_adding)
{
    <MudAlert Severity="Severity.Info">No Kubernetes cluster has been added yet. Apply the setup manifest in the cluster, then add it with its token.</MudAlert>
}
else if (_clusters.Count > 0)
{
    <MudPaper Elevation="0" Outlined="true" Class="mb-4 cq">
        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
            <thead>
                <tr><th>Cluster</th><th>Connection</th><th class="c-560">Platform</th><th class="c-760">Storage for volumes</th><th class="c-950">Namespaces</th><th>Volumes</th></tr>
            </thead>
            <tbody>
                @foreach (var cluster in _clusters)
                {
                    var summary = Summary(cluster.Id);
                    <tr class="cursor-pointer @(cluster.Id == _selected ? "row-selected" : null)" @onclick="@(() => _selected = cluster.Id)">
                        <td><b>@cluster.DisplayName</b><span class="cell-sub">@(cluster.Agent is null ? $"{cluster.Address}:{cluster.Port}" : cluster.Agent.ApiServer is { } api ? $"through its agent, API {api}" : "through its agent")</span></td>
                        <td>
                            <StateChip State="@cluster.Status" />
                            @if (cluster.Agent is { } agent)
                            {
                                <span class="@(agent.Online ? "mini-chip success" : "mini-chip warning")" title="@AgentTitle(agent)">agent @(agent.Online ? "online" : "offline")</span>
                                <span class="cell-sub">@(agent.Online ? $"{agent.Pod} on {agent.Node}" : agent.LastContactUtc is { } last ? $"last contact {Fmt.Time(last)}" : "not connected yet")</span>
                            }
                            else
                            {
                                <span class="cell-sub">direct API</span>
                            }
                        </td>
                        <td class="c-560">@cluster.ProductName<span class="cell-sub">@cluster.ProductVersion@(cluster.Platforms?.Override is not null ? " · set by hand" : string.Empty)</span></td>
                        <td class="c-760">
                            @foreach (var (driver, snapshot) in summary.Drivers)
                            {
                                <span class="@(snapshot ? "mini-chip success" : "mini-chip")" title="@(snapshot ? "Volumes of this driver are backed up through a CSI snapshot." : "Volumes of this driver: objects only.")">@driver · @(snapshot ? "snapshots" : "objects only")</span>
                            }
                        </td>
                        <td class="c-950 num">@summary.Namespaces</td>
                        <td>@summary.Snapshot snapshot<span class="cell-sub">@summary.ObjectsOnly objects only</span></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (_clusters.FirstOrDefault(c => c.Id == _selected) is { } selected && _inventory.TryGetValue(selected.Id, out var items))
    {
        <MudPaper Elevation="0" Outlined="true">
            <div class="d-flex align-center flex-wrap gap-2 pa-4 pb-0">
                <MudIcon Icon="@AppIcons.Kubernetes" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@selected.DisplayName</MudText>
                <MudSpacer />
                @if (selected.Agent is not null)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Description" OnClick="@(() => ShowAgentSetupAsync(selected))">Setup manifest with the agent</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SettingsEthernet" OnClick="@(() => SwitchToAgentAsync(selected))">Reach it through an agent</MudButton>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@(() => RescanAsync(selected))">Rescan</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => RemoveAsync(selected))">Remove</MudButton>
            </div>
            @if (selected.LastError is not null && selected.Status == "Error")
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mx-4 mt-2">@selected.LastError</MudAlert>
            }
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pa-0">
                <MudTabPanel Text="Volumes">
                    <div class="cq" style="overflow-x: auto">
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                            <thead><tr><th>Namespace</th><th>PVC</th><th class="c-560 num">Size</th><th class="c-760">Storage class</th><th class="c-950">Used by</th><th>Backup of its data</th></tr></thead>
                            <tbody>
                                @foreach (var volume in items.Where(i => i.Kind == "VolumeClaim").OrderBy(i => i.ParentNativeId).ThenBy(i => i.Name))
                                {
                                    var p = volume.Properties;
                                    <tr>
                                        <td>@volume.ParentNativeId</td>
                                        <td>@volume.Name</td>
                                        <td class="c-560 num">@Fmt.Bytes(long.TryParse(p.GetValueOrDefault("sizeBytes"), out var size) ? size : null)</td>
                                        <td class="c-760">@(string.IsNullOrEmpty(p.GetValueOrDefault("storageClass")) ? "–" : p["storageClass"])<span class="cell-sub">@p.GetValueOrDefault("driver")</span></td>
                                        <td class="c-950">@p.GetValueOrDefault("usedBy")</td>
                                        <td>
                                            @if (p.GetValueOrDefault("dataPath") == "snapshot")
                                            {
                                                <span class="mini-chip success" title="@($"VolumeSnapshotClass {p.GetValueOrDefault("snapshotClass")}")">snapshot</span>
                                            }
                                            else
                                            {
                                                <span class="mini-chip" title="@p.GetValueOrDefault("dataPathReason")">objects only</span>
                                                <span class="cell-sub">@p.GetValueOrDefault("dataPathReason")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Namespaces">
                    <div class="cq" style="overflow-x: auto">
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                            <thead><tr><th>Namespace</th><th class="num">Volumes</th><th class="num">Through a snapshot</th><th class="c-560">Phase</th></tr></thead>
                            <tbody>
                                @foreach (var ns in items.Where(i => i.Kind == "Namespace").OrderBy(i => i.Name))
                                {
                                    <tr>
                                        <td>@ns.Name</td>
                                        <td class="num">@ns.Properties.GetValueOrDefault("volumeClaims")</td>
                                        <td class="num">@ns.Properties.GetValueOrDefault("snapshotVolumes")</td>
                                        <td class="c-560">@ns.Properties.GetValueOrDefault("phase")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Platform">
                    <div class="pa-4">
                        @if (selected.Platforms is { } platforms)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">
                                <b>@platforms.Display</b> · @(platforms.Override is null ? "detected" : "set by hand")
                            </MudText>
                            <div class="mb-3">
                                @foreach (var p in platforms.Effective)
                                {
                                    <span class="mini-chip" title="@(p.Notes ?? p.Category)">@p.Name@(p.Tested ? string.Empty : " · untested")</span>
                                }
                            </div>
                            <MudText Typo="Typo.subtitle2">Detected</MudText>
                            @if (platforms.Detected.Count == 0)
                            {
                                <div class="cell-sub mb-3">Nothing particular: only what every Kubernetes cluster has.</div>
                            }
                            else
                            {
                                <ul class="mb-3">
                                    @foreach (var d in platforms.Detected)
                                    {
                                        <li>@d.Name <span class="cell-sub">by @d.Evidence@(d.Tested ? string.Empty : " · untested: its rules come from the platform's documentation")</span></li>
                                    }
                                </ul>
                            }

                            <MudText Typo="Typo.subtitle2">Left out by whole-cluster jobs with the platform's list</MudText>
                            <div class="cell-sub mb-3">@string.Join("; ", platforms.Namespaces.Select(n => $"{n.Profile}: {string.Join(", ", n.Patterns)}"))</div>

                            @foreach (var note in platforms.Effective.Where(p => p.Notes is not null))
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@note.Name: @note.Notes</MudAlert>
                            }

                            @if (_editingPlatforms == selected.Id && _catalog is not null)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-2">
                                    <MudSwitch T="bool" @bind-Value="_platformsByHand" Color="Color.Primary" Label="Set by hand instead of detecting them" />
                                    @if (_platformsByHand)
                                    {
                                        @foreach (var category in _catalog.GroupBy(p => p.Category))
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-2 d-block">@category.Key</MudText>
                                            @foreach (var p in category)
                                            {
                                                <MudCheckBox T="bool" Value="@_chosenPlatforms.Contains(p.Id)" ValueChanged="@(on => TogglePlatform(p.Id, on))" Dense="true" Color="Color.Primary"
                                                             Label="@($"{p.Name}{(p.Tested ? string.Empty : " (untested)")}")" />
                                            }
                                        }
                                    }
                                    <div class="d-flex gap-2 mt-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SavePlatformsAsync(selected))">Save</MudButton>
                                        <MudButton OnClick="@(() => _editingPlatforms = Guid.Empty)">Cancel</MudButton>
                                    </div>
                                </MudPaper>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => EditPlatformsAsync(selected))">Set platforms…</MudButton>
                            }
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
}

@code {
    private List<ConnectionDto>? _clusters;
    private readonly Dictionary<Guid, List<InventoryItemDto>> _inventory = [];
    private Guid _selected;
    private bool _adding;
    private string? _setup;
    private ConnectionDto? _setupFor;
    private bool _withRestore = true;
    private bool _showMover;
    private MoverImageDto? _mover;
    private const string KubernetesSetupFile = "backdafuckup-setup.yaml";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try
        {
            _mover = await Api.GetAsync<MoverImageDto>("api/kubernetes/mover");
        }
        catch (ApiException)
        {
            // Only for the notice; the panel shows the error.
        }
    }

    private async Task LoadAsync()
    {
        _clusters = await Api.GetAsync<List<ConnectionDto>>("api/connections?kind=Kubernetes");
        _inventory.Clear();
        foreach (var cluster in _clusters)
        {
            _inventory[cluster.Id] = await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{cluster.Id}/inventory");
        }

        if (_clusters.All(c => c.Id != _selected))
        {
            _selected = _clusters.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    /// <summary>Per cluster: the CSI drivers (and NFS) of its volumes and whether they go through a snapshot, and the counts.</summary>
    private (IReadOnlyList<(string Driver, bool Snapshot)> Drivers, int Namespaces, int Snapshot, int ObjectsOnly) Summary(Guid clusterId)
    {
        var items = _inventory.GetValueOrDefault(clusterId) ?? [];
        var volumes = items.Where(i => i.Kind == "VolumeClaim").ToList();
        var drivers = volumes
            .GroupBy(v => string.IsNullOrEmpty(v.Properties.GetValueOrDefault("driver")) ? "unbound" : v.Properties["driver"])
            .Select(g => (g.Key, g.Any(v => v.Properties.GetValueOrDefault("dataPath") == "snapshot")))
            .OrderByDescending(d => d.Item2).ThenBy(d => d.Key)
            .ToList();
        var snapshot = volumes.Count(v => v.Properties.GetValueOrDefault("dataPath") == "snapshot");
        return (drivers, items.Count(i => i.Kind == "Namespace"), snapshot, volumes.Count - snapshot);
    }

    private async Task ToggleSetupAsync()
    {
        try
        {
            _setupFor = null;
            _setup = _setup is null ? await Api.GetStringAsync(SetupUrl(download: false)) : null;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string SetupUrl(bool download) =>
        $"api/kubernetes/setup.yaml?restore={(_withRestore ? "true" : "false")}{(_setupFor is { } cluster ? $"&connectionId={cluster.Id}" : string.Empty)}{(download ? "&download=true" : string.Empty)}";

    /// <summary>The manifest of a cluster behind its agent, with the agent and its connect token (to apply it again).</summary>
    private async Task ShowAgentSetupAsync(ConnectionDto cluster)
    {
        try
        {
            _setupFor = cluster;
            _setup = await Api.GetStringAsync(SetupUrl(download: false));
        }
        catch (ApiException ex)
        {
            _setupFor = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Changes a direct cluster to its agent (jobs and restore points stay) and shows the manifest with the agent.</summary>
    private async Task SwitchToAgentAsync(ConnectionDto cluster)
    {
        if (await Dialogs.ShowMessageBoxAsync(
                "Reach it through an agent",
                $"From now on the server reaches {cluster.DisplayName} only through an agent in the cluster, which dials out to this server. The stored ServiceAccount token is removed; " +
                "apply the setup manifest with the agent next. Jobs and restore points stay.",
                yesText: "Change", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            var changed = await Api.PostAsync<ConnectionDto>($"api/connections/{cluster.Id}/agent");
            await LoadAsync();
            await ShowAgentSetupAsync(changed);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string AgentTitle(ConnectionAgentDto agent) =>
        $"Version {agent.Version ?? "?"}{(agent.ConnectedUtc is { } at ? $", connected since {Fmt.Time(at)}" : string.Empty)}{(agent.ApiServer is { } api ? $", API server {api} in the cluster" : string.Empty)}";

    private async Task OnRestoreChangedAsync(bool value)
    {
        _withRestore = value;
        try
        {
            _setup = await Api.GetStringAsync(SetupUrl(download: false));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CopySetupAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _setup);
        Snackbar.Add("Setup manifest copied.", Severity.Success);
    }

    private async Task OnClusterAddedAsync()
    {
        _adding = false;
        await LoadAsync();
    }

    private Guid _editingPlatforms;
    private bool _platformsByHand;
    private readonly HashSet<string> _chosenPlatforms = new(StringComparer.Ordinal);
    private List<KubernetesPlatformDto>? _catalog;

    private async Task EditPlatformsAsync(ConnectionDto cluster)
    {
        try
        {
            _catalog ??= await Api.GetAsync<List<KubernetesPlatformDto>>("api/kubernetes/platforms");
            _chosenPlatforms.Clear();
            _chosenPlatforms.UnionWith(cluster.Platforms?.Effective.Select(p => p.Id).Where(id => id != "kubernetes") ?? []);
            _platformsByHand = cluster.Platforms?.Override is not null;
            _editingPlatforms = cluster.Id;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void TogglePlatform(string id, bool on)
    {
        if (on)
        {
            _chosenPlatforms.Add(id);
        }
        else
        {
            _chosenPlatforms.Remove(id);
        }
    }

    private async Task SavePlatformsAsync(ConnectionDto cluster)
    {
        try
        {
            await Api.PutAsync($"api/connections/{cluster.Id}/platforms", new SetConnectionPlatformsDto(_platformsByHand ? [.. _chosenPlatforms] : null));
            _editingPlatforms = Guid.Empty;
            Snackbar.Add(_platformsByHand ? $"Platforms of {cluster.DisplayName} set." : $"Platforms of {cluster.DisplayName} are detected again.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RescanAsync(ConnectionDto cluster)
    {
        try
        {
            await Api.PostAsync($"api/connections/{cluster.Id}/rescan");
            Snackbar.Add($"{cluster.DisplayName} rescanned.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(ConnectionDto cluster)
    {
        if (await Dialogs.ShowMessageBoxAsync("Remove cluster", $"Remove {cluster.DisplayName}? Restore points are kept; nothing in the cluster is changed.", yesText: "Remove", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/connections/{cluster.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
