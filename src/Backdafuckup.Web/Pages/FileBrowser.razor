@page "/files/{RestorePointId:guid}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Restore files – backdafuckup</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAsync" StartIcon="@AppIcons.Files">Open again</MudButton>
    <MudButton Variant="Variant.Text" Href="/backups" Class="ml-2">Back to backups</MudButton>
}
else if (_mount is null)
{
    <MudText Typo="Typo.h5" Class="mb-2">Restore files</MudText>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    <MudText Typo="Typo.body2">Opening the restore point: reading partitions and file systems…</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">Restore files: @_mount.VmName</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@_mount.RestorePointCreatedUtc.ToLocalTime().ToString("g")</MudChip>
        <ConsistencyChip Consistency="@_mount.Consistency" Reason="@_mount.ConsistencyReason" Warning="@_mount.ConsistencyWarning" />
        <MudSpacer />
        <MudText Typo="Typo.caption">Closes after @_mount.IdleTimeoutMinutes minutes without use.</MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CloseAsync" StartIcon="@Icons.Material.Filled.Close">Close</MudButton>
    </MudStack>

    @foreach (var warning in _mount.Warnings)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@warning</MudAlert>
    }

    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-2" Elevation="1" Style="min-height:60vh;overflow:auto">
                @* MudBlazor 9 renders Items only through an ItemTemplate. *@
                <MudTreeView T="string" Items="_tree" ServerData="LoadFoldersAsync" SelectedValue="_selectedNode" SelectedValueChanged="OnNodeSelectedAsync" Dense="true" Hover="true">
                    <ItemTemplate>
                        <MudTreeViewItem T="string" Value="@context.Value" Text="@context.Text" Icon="@context.Icon" @bind-Items="context.Children"
                                         CanExpand="@context.Expandable" @bind-Expanded="@context.Expanded" />
                    </ItemTemplate>
                </MudTreeView>
                @foreach (var volume in _mount.Volumes.Where(v => !v.Readable))
                {
                    <MudTooltip Text="@volume.Reason">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="pa-2">
                            <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Default" />
                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-disabled)">@volume.Title (@Fmt.Bytes(volume.Length))</MudText>
                        </MudStack>
                    </MudTooltip>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="9">
            <MudPaper Class="pa-2" Elevation="1" Style="min-height:60vh">
                @if (_volume is null)
                {
                    <MudText Typo="Typo.body2" Class="pa-4">Choose a volume on the left.</MudText>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap" Class="mb-1">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(_path.Count == 0)" OnClick="UpAsync" />
                        <MudBreadcrumbs Items="Breadcrumbs" Class="pa-0" />
                        <MudSpacer />
                        <MudTooltip Text="One file downloads as it is; several files or folders as a ZIP file.">
                            @if (SingleDownload is { } single)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                           Href="@single" Target="_blank">Download</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderZip"
                                           Disabled="@(_selected.Count == 0 || _preparing)" OnClick="DownloadZipAsync">@(_selected.Count > 0 ? $"Download ZIP ({_selected.Count})" : "Download")</MudButton>
                            }
                        </MudTooltip>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@AppIcons.Restore"
                                   Disabled="@(_selected.Count == 0)" OnClick="OpenRestoreAsync">Restore…</MudButton>
                    </MudStack>
                    @if (_loading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    <MudTable T="GuestEntryDto" Items="_entries" Dense="true" Hover="true" Elevation="0" MultiSelection="true" @bind-SelectedItems="_selected"
                              OnRowClick="@(args => args.Item is null ? Task.CompletedTask : OnRowClickAsync(args.Item))" RowClass="cursor-pointer">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh Style="text-align:right">Size</MudTh>
                            <MudTh>Modified</MudTh>
                            <MudTh>@(_volume.Family == "unix" ? "Mode / owner" : "Attributes")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@IconFor(context)" Size="Size.Small" Color="@(context.Kind == "directory" ? Color.Warning : Color.Default)" />
                                    <span>@context.Name</span>
                                    @if (context.LinkTarget is not null)
                                    {
                                        <MudText Typo="Typo.caption" Class="mono">→ @context.LinkTarget</MudText>
                                    }
                                    @if (context.Unsupported is not null)
                                    {
                                        <MudTooltip Text="@($"Cannot be restored: {context.Unsupported}")">
                                            <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd Style="text-align:right">@(context.Kind == "file" ? Fmt.Bytes(context.Size) : "")</MudTd>
                            <MudTd>@context.ModifiedUtc?.ToLocalTime().ToString("g")</MudTd>
                            <MudTd><span class="mono">@(_volume.Family == "unix" ? $"{context.Mode} {context.UserId}:{context.GroupId}" : ShortAttributes(context.Attributes))</span></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2">@(_loading ? "Loading…" : "This folder is empty.")</MudText>
                        </NoRecordsContent>
                    </MudTable>
                    @if (_entries.Count < _total)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadMoreAsync" Class="mt-1">Show more (@_entries.Count of @_total)</MudButton>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudDialog @bind-Visible="_restoreOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Restore @_selected.Count item(s)</MudText>
        <MudText Typo="Typo.body2" Class="mono">@SelectionText</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudRadioGroup T="string" Value="_restoreTarget" ValueChanged="OnTargetChanged">
                <MudRadio T="string" Value="@("share")" Color="Color.Primary">Copy to a network share (SMB)</MudRadio>
                <MudRadio T="string" Value="@("vm")" Color="Color.Primary">Back into the VM @_mount?.VmName @(_volume?.Family == "unix" ? "(SSH)" : "(guest agent)")</MudRadio>
            </MudRadioGroup>
            @if (_restoreTarget == "share")
            {
                <MudTextField T="string" @bind-Value="_sharePath" Label="Folder on the share" Placeholder="\\server\share\folder" Variant="Variant.Outlined"
                              HelperText="The selected items go directly into this folder. Missing folders are created." />
                @if (_credentials is { Count: 0 })
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No Windows credential yet. Add one with write access to the share under <MudLink Href="/infrastructure/credentials">Credentials</MudLink>.</MudAlert>
                }
                else
                {
                    <MudSelect T="Guid?" @bind-Value="_credentialId" Label="Account for the share" Variant="Variant.Outlined" HelperText="DOMAIN\user with write access to the folder.">
                        @foreach (var credential in _credentials ?? [])
                        {
                            <MudSelectItem T="Guid?" Value="@credential.Id">@credential.UserName@(string.IsNullOrEmpty(credential.Description) ? "" : $" – {credential.Description}")</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            else
            {
                @if (_volume?.Family == "unix")
                {
                    <MudStack Row="true" Spacing="2">
                        <MudTextField T="string" @bind-Value="_sshAddress" Label="Address of the VM" Variant="Variant.Outlined" Placeholder="from the guest tools"
                                      HelperText="Empty: the addresses the guest tools report" />
                        <MudNumericField T="int" @bind-Value="_sshPort" Label="SSH port" Variant="Variant.Outlined" Min="1" Max="65535" Style="max-width:120px" />
                    </MudStack>
                    @if (_linuxCredentials is { Count: 0 })
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">No Linux credential yet. Add root or an account with sudo under <MudLink Href="/infrastructure/credentials">Credentials</MudLink>.</MudAlert>
                    }
                    else
                    {
                        <MudSelect T="Guid?" @bind-Value="_linuxCredentialId" Label="Linux account" Variant="Variant.Outlined" HelperText="root, or an account with sudo">
                            @foreach (var credential in _linuxCredentials ?? [])
                            {
                                <MudSelectItem T="Guid?" Value="@credential.Id">@credential.UserName@(string.IsNullOrEmpty(credential.Description) ? "" : $" – {credential.Description}")</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
                else if (AgentProblem is { } problem)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@problem</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body2">Agent in @_agent!.HostName (@(_agent.IpAddresses ?? _agent.RemoteAddress)) is online.</MudText>
                }
                <MudRadioGroup T="bool" Value="_toOriginal" ValueChanged="OnLocationChanged">
                    <MudRadio T="bool" Value="true" Color="Color.Primary" Disabled="@(OriginalLocation is null)">
                        Original location@(OriginalLocation is { } original ? $": {original}" : " (the volume had no drive letter)")
                    </MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Primary">Another folder in the VM</MudRadio>
                </MudRadioGroup>
                @if (!_toOriginal)
                {
                    <MudTextField T="string" @bind-Value="_guestFolder" Label="Folder in the VM" Placeholder="@(_volume?.Family == "unix" ? "/srv/restore" : "D:\\Restore")" Variant="Variant.Outlined"
                                  HelperText="The selected items go directly into this folder. Missing folders are created." />
                }
                <MudCheckBox T="bool" @bind-Value="_restorePermissions" Color="Color.Primary"
                             Label="@(_volume?.Family == "unix" ? "Restore owner and group from the backup (otherwise those of the restore folder)" : "Restore owner and permissions from the backup (otherwise they are inherited from the target folder)")" />
            }
            <MudRadioGroup T="FileRestoreModeDto" @bind-Value="_restoreMode">
                <MudRadio T="FileRestoreModeDto" Value="FileRestoreModeDto.Overwrite" Color="Color.Primary">Replace existing files</MudRadio>
                <MudRadio T="FileRestoreModeDto" Value="FileRestoreModeDto.Keep" Color="Color.Primary">Keep existing files and restore as RESTORED-&lt;name&gt;</MudRadio>
            </MudRadioGroup>
            <MudText Typo="Typo.caption">
                @if (_restoreTarget == "share")
                {
                    <span>Shares get the content, times and attributes, not the permissions. Links and special files are not restored.</span>
                    @if (_volume?.Family == "unix")
                    {
                        <span> Names that Windows does not allow (with \ : * ? " &lt; &gt; | or a trailing dot) are reported and left out.</span>
                    }
                }
                else if (_volume?.Family == "unix")
                {
                    <span>The files go to /var/tmp in the VM first and are then put in place as root (sudo): each replaces the old one only when complete, with mode, times and symbolic links; nothing is written through links.</span>
                }
                else
                {
                    <span>Every file is written under a temporary name and replaces the old one only when complete. Files in use in the VM are reported. Links and junctions are not restored yet.</span>
                }
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _restoreOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartRestoreAsync" Disabled="@(_starting || !CanStart)">Restore</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const char Separator = '\u0001';
    private const int PageSize = 500;

    [Parameter]
    public Guid RestorePointId { get; set; }

    private FileMountDto? _mount;
    private string? _error;
    private List<TreeItemData<string>> _tree = [];
    private string? _selectedNode;
    private GuestVolumeDto? _volume;
    private List<string> _path = [];
    private List<GuestEntryDto> _entries = [];
    private HashSet<GuestEntryDto> _selected = [];
    private int _total;
    private bool _loading;
    private bool _closed;
    private bool _preparing;
    private bool _restoreOpen;
    private bool _starting;
    private string _restoreTarget = "share";
    private string? _sharePath;
    private Guid? _credentialId;
    private FileRestoreModeDto _restoreMode = FileRestoreModeDto.Overwrite;
    private List<WindowsCredentialDto>? _credentials;
    private AgentDto? _agent;
    private bool _toOriginal = true;
    private string? _guestFolder;
    private bool _restorePermissions = true;
    private List<LinuxCredentialDto>? _linuxCredentials;
    private Guid? _linuxCredentialId;
    private string? _sshAddress;
    private int _sshPort = 22;

    protected override Task OnInitializedAsync() => OpenAsync();

    private async Task OpenAsync()
    {
        _error = null;
        _mount = null;
        try
        {
            _mount = await Api.PostAsync<FileMountDto>("api/file-restore/mounts", new OpenFileMountRequestDto(RestorePointId));
            _closed = false;
            _tree = [.. _mount.Volumes.Where(v => v.Readable).Select(v => new TreeItemData<string>
            {
                Value = Node(v.Id, []),
                Text = $"{v.Title}  ·  {v.FileSystem}, {Fmt.Bytes(v.Length)}",
                Icon = AppIcons.Disk,
                Expandable = true,
            })];
            var first = _mount.Volumes.FirstOrDefault(v => v.Readable && v.MountPoint is "C:" or "/") ?? _mount.Volumes.FirstOrDefault(v => v.Readable);
            if (first is not null)
            {
                await NavigateAsync(first, []);
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task<IReadOnlyCollection<TreeItemData<string>>> LoadFoldersAsync(string? parent)
    {
        if (_mount is null || parent is null)
        {
            return _tree;
        }

        var (volumeId, path) = Parse(parent);
        try
        {
            var page = await Api.GetAsync<GuestEntryPageDto>(EntriesUrl(volumeId, path, 0, 1000));
            var folders = page.Entries.Where(e => e.Kind == "directory").Select(e => new TreeItemData<string>
            {
                Value = Node(volumeId, [.. path, e.Name]),
                Text = e.Name,
                Icon = Icons.Material.Filled.Folder,
                Expandable = true,
            }).ToList();
            if (page.Total > page.Entries.Count)
            {
                folders.Add(new TreeItemData<string> { Value = parent + Separator + "…", Text = $"… ({page.Total:N0} entries, see the list)", Expandable = false });
            }

            return folders;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return [];
        }
    }

    private async Task OnNodeSelectedAsync(string? node)
    {
        _selectedNode = node;
        if (_mount is null || node is null || node.EndsWith(Separator + "…", StringComparison.Ordinal))
        {
            return;
        }

        var (volumeId, path) = Parse(node);
        var volume = _mount.Volumes.FirstOrDefault(v => v.Id == volumeId);
        if (volume is not null)
        {
            await NavigateAsync(volume, path);
        }
    }

    private async Task NavigateAsync(GuestVolumeDto volume, List<string> path)
    {
        _volume = volume;
        _path = path;
        _entries = [];
        _selected = [];
        _total = 0;
        await LoadMoreAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (_volume is null)
        {
            return;
        }

        _loading = true;
        try
        {
            var page = await Api.GetAsync<GuestEntryPageDto>(EntriesUrl(_volume.Id, _path, _entries.Count, PageSize));
            _entries.AddRange(page.Entries);
            _total = page.Total;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowClickAsync(GuestEntryDto entry)
    {
        if (entry.Kind == "directory" && _volume is not null)
        {
            await NavigateAsync(_volume, [.. _path, entry.Name]);
        }
    }

    private async Task UpAsync()
    {
        if (_volume is not null && _path.Count > 0)
        {
            await NavigateAsync(_volume, _path[..^1]);
        }
    }

    private List<BreadcrumbItem> Breadcrumbs
    {
        get
        {
            var items = new List<BreadcrumbItem> { new(_volume?.Title ?? string.Empty, href: null) };
            items.AddRange(_path.Select(p => new BreadcrumbItem(p, href: null)));
            return items;
        }
    }

    private string? SingleDownload
    {
        get
        {
            if (_mount is null || _volume is null || _selected.Count != 1)
            {
                return null;
            }

            var entry = _selected.First();
            if (entry.Kind != "file" || entry.Unsupported is not null)
            {
                return null;
            }

            var path = string.Join('/', _path.Append(entry.Name));
            return $"api/file-restore/mounts/{_mount.Id}/file?volume={Uri.EscapeDataString(_volume.Id)}&path={Uri.EscapeDataString(path)}";
        }
    }

    /// <summary>Posts the selection, then lets the browser fetch the ZIP from the one-time link it gets back.</summary>
    private async Task DownloadZipAsync()
    {
        if (_mount is null || _volume is null || _selected.Count == 0)
        {
            return;
        }

        _preparing = true;
        try
        {
            var paths = _selected.Select(e => string.Join('/', _path.Append(e.Name))).ToList();
            var ticket = await Api.PostAsync<FileDownloadTicketDto>(
                $"api/file-restore/mounts/{_mount.Id}/downloads", new FileDownloadRequestDto(_volume.Id, paths, TimeZoneInfo.Local.Id));
            await JS.InvokeVoidAsync("bdfuDownload", ticket.Url);
            var maySkip = _selected.Any(e => e.Kind != "file" || e.Unsupported is not null);
            Snackbar.Add(
                maySkip
                    ? $"Downloading {ticket.FileName}. What a ZIP cannot hold (links, special or unreadable files) is listed in _backdafuckup-skipped.txt inside it."
                    : $"Downloading {ticket.FileName}.",
                Severity.Info);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _preparing = false;
        }
    }

    private string SelectionText
    {
        get
        {
            var names = string.Join(", ", _selected.Take(3).Select(e => e.Name)) + (_selected.Count > 3 ? $" and {_selected.Count - 3} more" : string.Empty);
            var separator = _volume?.Family == "unix" ? "/" : "\\";
            var folder = _path.Count == 0 ? string.Empty : separator + string.Join(separator, _path);
            return $"{names} from {_volume?.Title}{folder}";
        }
    }

    /// <summary>Drive letter or mount point plus folder, e.g. C:\Users\x, if the volume had one in the backup.</summary>
    private string? OriginalLocation => _volume?.MountPoint switch
    {
        { Length: >= 2 } mount when mount[1] == ':' => mount.TrimEnd('\\') + "\\" + string.Join('\\', _path),
        { } mount when mount.StartsWith('/') => mount.TrimEnd('/') + "/" + string.Join('/', _path),
        _ => null,
    };

    private string? AgentProblem => _agent switch
    {
        null => $"No backdafuckup agent is installed in {_mount?.VmName}. Install it under Guest Agents, or restore to a share.",
        { Online: false } a => $"The agent in {a.HostName} is offline since {a.LastContactUtc.ToLocalTime():g}. Start the VM, or restore to a share.",
        { CanRestoreFiles: false } a => $"The agent in {a.HostName} (version {a.Version}) cannot restore files yet; it updates itself within a few minutes.",
        _ => null,
    };

    private bool CanStart => _restoreTarget == "share"
        ? !string.IsNullOrWhiteSpace(_sharePath) && _credentialId is not null
        : (_volume?.Family == "unix" ? _linuxCredentialId is not null : AgentProblem is null)
            && (_toOriginal ? OriginalLocation is not null : !string.IsNullOrWhiteSpace(_guestFolder));

    private void OnTargetChanged(string target)
    {
        _restoreTarget = target;
        if (target == "vm")
        {
            _toOriginal = OriginalLocation is not null;
            _restorePermissions = _toOriginal;
        }
    }

    /// <summary>Permissions fit the original location; in another folder (or another VM) local accounts and inheritance may not.</summary>
    private void OnLocationChanged(bool original)
    {
        _toOriginal = original;
        _restorePermissions = original;
    }

    private async Task OpenRestoreAsync()
    {
        try
        {
            _credentials = await Api.GetAsync<List<WindowsCredentialDto>>("api/credentials");
            _credentialId ??= _credentials.Count == 1 ? _credentials[0].Id : null;
            _linuxCredentials = await Api.GetAsync<List<LinuxCredentialDto>>("api/credentials/linux");
            _linuxCredentialId ??= _linuxCredentials.Count == 1 ? _linuxCredentials[0].Id : null;
            var agents = await Api.GetAsync<List<AgentDto>>("api/agents");
            _agent = agents.Where(a => a.VmNativeId == _mount?.VmNativeId).OrderByDescending(a => a.LastContactUtc).FirstOrDefault();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        _restoreOpen = true;
    }

    private async Task StartRestoreAsync()
    {
        if (_mount is null || _volume is null || _selected.Count == 0)
        {
            return;
        }

        _starting = true;
        try
        {
            var request = new FileRestoreRequestDto
            {
                RestorePointId = _mount.RestorePointId,
                Volume = _volume.Id,
                Paths = [.. _selected.Select(e => string.Join('/', _path.Append(e.Name)))],
                Mode = _restoreMode,
                Target = _restoreTarget == "share"
                    ? new FileRestoreTargetDto { Kind = FileRestoreTargetKindDto.Share, SharePath = _sharePath?.Trim(), CredentialId = _credentialId }
                    : _volume.Family == "unix"
                        ? new FileRestoreTargetDto
                        {
                            Kind = FileRestoreTargetKindDto.Ssh,
                            Address = string.IsNullOrWhiteSpace(_sshAddress) ? null : _sshAddress.Trim(),
                            Port = _sshPort,
                            CredentialId = _linuxCredentialId,
                            Folder = _toOriginal ? null : _guestFolder?.Trim(),
                            RestorePermissions = _restorePermissions,
                        }
                        : new FileRestoreTargetDto { Kind = FileRestoreTargetKindDto.Agent, Folder = _toOriginal ? null : _guestFolder?.Trim(), RestorePermissions = _restorePermissions },
                MountId = _mount.Id,
            };
            var started = await Api.PostAsync<StartedDto>("api/file-restore/restores", request);
            _restoreOpen = false;
            var where = _restoreTarget == "share" ? request.Target.SharePath : _toOriginal ? $"the original location in {_mount.VmName}" : $"{request.Target.Folder} in {_mount.VmName}";
            Snackbar.Add($"File restore started to {where}.", Severity.Success, options =>
            {
                options.Action = "Show session";
                options.ActionColor = Color.Primary;
                options.OnClick = _ =>
                {
                    Navigation.NavigateTo($"sessions/{started.SessionId}");
                    return Task.CompletedTask;
                };
            });
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task CloseAsync()
    {
        await UnmountAsync();
        _mount = null;
        _error = "The file browser is closed.";
    }

    private async Task UnmountAsync()
    {
        if (_mount is null || _closed)
        {
            return;
        }

        _closed = true;
        try
        {
            await Api.DeleteAsync($"api/file-restore/mounts/{_mount.Id}");
        }
        catch (ApiException)
        {
            // Already closed (idle timeout or restart).
        }
    }

    public async ValueTask DisposeAsync() => await UnmountAsync();

    private string EntriesUrl(string volumeId, IEnumerable<string> path, int offset, int limit) =>
        $"api/file-restore/mounts/{_mount!.Id}/entries?volume={Uri.EscapeDataString(volumeId)}&path={Uri.EscapeDataString(string.Join('/', path))}&offset={offset}&limit={limit}";

    private static string Node(string volumeId, IEnumerable<string> path) => string.Join(Separator, path.Prepend(volumeId));

    private static (string Volume, List<string> Path) Parse(string node)
    {
        var parts = node.Split(Separator);
        return (parts[0], [.. parts.Skip(1)]);
    }

    private static string IconFor(GuestEntryDto entry) => entry.Kind switch
    {
        "directory" => Icons.Material.Filled.Folder,
        "symlink" or "junction" => Icons.Material.Filled.Link,
        "file" => Icons.Material.Outlined.InsertDriveFile,
        _ => Icons.Material.Outlined.HelpOutline,
    };

    private static string ShortAttributes(string? attributes)
    {
        if (string.IsNullOrEmpty(attributes))
        {
            return string.Empty;
        }

        var flags = attributes.Split(", ");
        var letters = new List<string>();
        if (flags.Contains("ReadOnly")) letters.Add("R");
        if (flags.Contains("Hidden")) letters.Add("H");
        if (flags.Contains("System")) letters.Add("S");
        if (flags.Contains("Archive")) letters.Add("A");
        if (flags.Contains("Compressed")) letters.Add("C");
        if (flags.Contains("Encrypted")) letters.Add("E");
        if (flags.Contains("SparseFile")) letters.Add("P");
        if (flags.Contains("ReparsePoint")) letters.Add("L");
        return string.Concat(letters);
    }
}
