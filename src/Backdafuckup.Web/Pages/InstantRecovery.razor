@page "/instant-recovery"
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Instant recovery – backdafuckup</PageTitle>
<PageHeader Title="Instant Recovery"
            Description="A vSphere VM runs straight from its restore point within minutes, from an NFS datastore this backup server serves. Move it to production storage while it runs (Migrate), or stop it." />

@if (_server is { Enabled: false })
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Instant recovery is off on this backup server. Set <span class="mono">InstantRecovery:Enabled</span> to true in its configuration and restart the service, and let
        the ESXi hosts' VMkernel addresses reach this server on TCP/UDP 111, TCP 2049 and TCP/UDP 20048 (admin guide, "The NFS server for instant recovery").
    </MudAlert>
}
else if (_server is { Listening: false })
{
    <MudAlert Severity="Severity.Error" Class="mb-4">The NFS server for instant recovery does not listen: @_server.Error</MudAlert>
}

@if (Point is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        @if (_point is null || _connections is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.h6">Run @_point.VmName now</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                From its restore point of @Fmt.Time(_point.CreatedUtc) (@_point.Kind, job @_point.JobName) · @_point.VCpus vCPU · @Fmt.Bytes(_point.MemoryBytes) RAM ·
                @_point.Disks.Count disk(s), @Fmt.Bytes(_point.Disks.Sum(d => d.CapacityBytes)). Nothing is copied first: the VM reads its disks from the backup and
                writes into this server's overlay until it is migrated.
            </MudText>

            <MudSelect T="Guid" Value="_connection" ValueChanged="OnConnectionChangedAsync" Label="vCenter" Variant="Variant.Outlined" Class="mb-3"
                       ToStringFunc="@(id => _connections.FirstOrDefault(c => c.Id == id)?.DisplayName ?? string.Empty)">
                @foreach (var connection in _connections)
                {
                    <MudSelectItem T="Guid" Value="@connection.Id">@connection.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Value="_host" ValueChanged="OnHostChangedAsync" Label="ESXi host" Variant="Variant.Outlined" Class="mb-3" ToStringFunc="InventoryName"
                       HelperText="Mounts the instant recovery's datastore and runs the VM; Migrate can move it to another host later.">
                @foreach (var host in _inventory.Where(i => i.Kind == "Host").OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <MudSelectItem T="string" Value="@host.NativeId">@host.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_hostCheck is { } check)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @check.Name mounts the datastore from @(check.MountFrom ?? "–") with its VMkernel address(es) @string.Join(", ", check.Addresses)
                    (@check.NfsMounts of @(check.NfsMountLimit?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "?") NFS datastores mounted now).
                    This server's firewall must let them in on TCP/UDP @check.PortmapperPort (portmapper), TCP @check.NfsPort (NFS) and TCP/UDP @check.MountPort (MOUNT).
                    @(check.SwapDatastore is { } swap
                        ? $"Swap files go to its own datastore {swap}."
                        : $"It has no swap datastore of its own, so the VM's swap file ({Fmt.Bytes(_point.MemoryBytes)}, its memory) goes into the instant recovery's datastore.")
                </MudAlert>
            }
            <MudTextField @bind-Value="_name" Label="VM name" Variant="Variant.Outlined" Class="mb-3" Immediate="true"
                          HelperText="A new VM next to the original, which is not touched." />
            <div class="d-flex gap-3">
                <MudSelect T="string" @bind-Value="_folder" Label="VM folder" Variant="Variant.Outlined" Class="mb-3" Clearable="true" ToStringFunc="InventoryName"
                           HelperText="Empty: the datacenter's VM folder.">
                    @foreach (var folder in _inventory.Where(i => i.Kind == "Folder").OrderBy(i => PathOf(i), StringComparer.OrdinalIgnoreCase))
                    {
                        <MudSelectItem T="string" Value="@folder.NativeId">@PathOf(folder)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_pool" Label="Resource pool" Variant="Variant.Outlined" Class="mb-3" Clearable="true" ToStringFunc="InventoryName"
                           HelperText="Empty: the host's cluster.">
                    @foreach (var pool in _inventory.Where(i => i.Kind == "ResourcePool").OrderBy(i => PathOf(i), StringComparer.OrdinalIgnoreCase))
                    {
                        <MudSelectItem T="string" Value="@pool.NativeId">@PathOf(pool)</MudSelectItem>
                    }
                </MudSelect>
            </div>

            @foreach (var nic in _point.Nics)
            {
                <MudSelect T="string" Value="@_networks.GetValueOrDefault(nic.Device)" ValueChanged="@(value => _networks[nic.Device] = value)"
                           Label="@($"NIC {nic.Device} (was {nic.NetworkName}, {nic.Mac})")" Variant="Variant.Outlined" Class="mb-3" ToStringFunc="InventoryName">
                    @foreach (var net in _inventory.Where(i => i.Kind == "Network").OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <MudSelectItem T="string" Value="@net.NativeId">@net.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudCheckBox @bind-Value="_connectNics" Label="Connect the NICs at power-on" />
            <MudText Typo="Typo.caption" Class="d-block mb-3">
                @(_connectNics
                    ? "The VM comes up on its networks with its own settings (IP addresses, host name). Only if the original is off or gone, or the network is isolated."
                    : "The NICs start disconnected (new MAC addresses): the original may still run with the same addresses. Connect them in vCenter once that is sorted out.")
            </MudText>
            <MudNumericField T="int?" @bind-Value="_overlayLimitGiB" Label="Limit for what the VM writes (GiB)" Variant="Variant.Outlined" Min="1" Clearable="true" Class="mb-3"
                             HelperText="Empty: the free space of this server's overlay volume. Beyond the limit the VM's writes fail with &quot;no space&quot;." />

            @foreach (var problem in Problems)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@problem</MudAlert>
            }

            <MudText Typo="Typo.body2" Class="mb-3">
                @if (_host is not null)
                {
                    <span>
                        <b>@Name</b> starts on @InventoryName(_host) from datastore <span class="mono">bdfu-ir-…</span>, which the host mounts from this server over NFS 3,
                        in @(_folder is null ? "the datacenter's VM folder" : InventoryName(_folder)), @(_pool is null ? "in the host's cluster" : InventoryName(_pool)).
                        Then migrate it to production storage, or stop it (powered off and removed; the datastore goes, nothing on vCenter is deleted).
                    </span>
                }
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/instant-recovery"))">Cancel</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt" Disabled="@(_busy || Problems.Any())" OnClick="StartAsync">Start instant recovery</MudButton>
            </div>
        }
    </MudPaper>
}

@if (_recoveries is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_recoveries.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No instant recovery runs. Start one from a vSphere VM's restore point: Backups &amp; Restore → the VM → Restore → "Instant recovery".
    </MudAlert>
}
else
{
    <MudTable Items="_recoveries" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>VM</MudTh><MudTh>Runs on</MudTh><MudTh>Datastore</MudTh><MudTh>Age</MudTh><MudTh>Written</MudTh><MudTh>State</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @foreach (var vm in context.Vms)
                {
                    <div>@vm.Name</div>
                    <span class="caption">@vm.SourceVmName, restore point of @Fmt.Time(vm.RestorePointCreatedUtc)</span>
                }
            </MudTd>
            <MudTd>@context.ConnectionName<br /><span class="caption">@(context.HostName ?? context.HostId)</span></MudTd>
            <MudTd>@context.DatastoreName<br /><span class="caption mono">@context.RemoteHost:@context.ExportPath</span></MudTd>
            <MudTd>@(Ended(context) ? "–" : Fmt.Span(DateTimeOffset.UtcNow - context.CreatedUtc))</MudTd>
            <MudTd>@(context.OverlayBytes is { } written ? Fmt.Bytes(written) : "–")@(context.OverlayLimitBytes is { } limit ? $" of {Fmt.Bytes(limit)}" : null)</MudTd>
            <MudTd>
                <StateChip State="@context.State" />
                @if (context.Message is { } message)
                {
                    <br /><span class="caption">@message</span>
                }
            </MudTd>
            <MudTd Style="white-space:nowrap">
                @if (context.State == "Running")
                {
                    <MudTooltip Text="Move the VM to production storage while it runs (Storage vMotion)">
                        <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove" aria-label="Migrate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenMigrateAsync(context))" Disabled="_busy" />
                    </MudTooltip>
                    <MudTooltip Text="Stop: power off and remove the VM, unmount the datastore">
                        <MudIconButton Icon="@Icons.Material.Filled.Stop" aria-label="Stop" Size="Size.Small" Color="Color.Error" OnClick="@(() => OpenStop(context))" Disabled="_busy" />
                    </MudTooltip>
                }
                <MudTooltip Text="Session log">
                    <MudIconButton Icon="@Icons.Material.Filled.Article" aria-label="Session log" Size="Size.Small" Href="@($"/sessions/{context.SessionId}")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@if (_migrate is { } migrating)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Migrate @string.Join(", ", migrating.Vms.Select(v => v.Name)) to production storage</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Storage vMotion copies the VM's disks and files to the datastore while it runs; then datastore @migrating.DatastoreName is unmounted and what the VM wrote here is deleted.
        </MudText>
        <MudSelect T="string" @bind-Value="_targetDatastore" Label="Datastore" Variant="Variant.Outlined" Class="mb-3" ToStringFunc="MigrateName">
            @foreach (var datastore in _migrateInventory.Where(i => i.Kind == "Storage" && !i.Name.StartsWith("bdfu-ir-", StringComparison.Ordinal)).OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase))
            {
                <MudSelectItem T="string" Value="@datastore.NativeId">@MigrateName(datastore.NativeId)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_targetHost" Label="Host" Variant="Variant.Outlined" Class="mb-3" Clearable="true" ToStringFunc="MigrateName"
                   HelperText="@($"Empty: stays on {migrating.HostName ?? migrating.HostId}.")">
            @foreach (var host in _migrateInventory.Where(i => i.Kind == "Host").OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase))
            {
                <MudSelectItem T="string" Value="@host.NativeId">@host.Name</MudSelectItem>
            }
        </MudSelect>
        <MudRadioGroup T="bool" @bind-Value="_thin">
            <MudRadio T="bool" Value="true">Thin disks</MudRadio>
            <MudRadio T="bool" Value="false">Thick disks (lazy zeroed)</MudRadio>
        </MudRadioGroup>
        <div class="d-flex gap-2 mt-3">
            <MudButton Variant="Variant.Text" OnClick="@(() => _migrate = null)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _targetDatastore is null)" OnClick="MigrateAsync">Migrate</MudButton>
        </div>
    </MudPaper>
}

@if (_stop is { } stopping)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Stop the instant recovery of @StopName</MudText>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            @StopName is powered off and removed from vCenter, and datastore @stopping.DatastoreName is unmounted. <b>What the VM wrote since it started is lost</b>
            (@(stopping.OverlayBytes is { } written ? Fmt.Bytes(written) : "unknown")); migrate it instead to keep it. No file on vCenter is deleted; a VM that has a disk
            on another datastore is not stopped.
        </MudAlert>
        <MudTextField @bind-Value="_stopConfirm" Label="@($"Type {StopName} to confirm")" Variant="Variant.Outlined" Immediate="true" />
        <div class="d-flex gap-2 mt-3">
            <MudButton Variant="Variant.Text" OnClick="@(() => _stop = null)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(_busy || _stopConfirm?.Trim() != StopName)" OnClick="StopAsync">Stop</MudButton>
        </div>
    </MudPaper>
}

@code {
    private readonly CancellationTokenSource _disposed = new();
    private InstantRecoveryServerDto? _server;
    private List<InstantRecoveryDto>? _recoveries;
    private RestorePointDto? _point;
    private List<ConnectionDto>? _connections;
    private List<InventoryItemDto> _inventory = [];
    private readonly Dictionary<string, string?> _networks = new(StringComparer.Ordinal);
    private Guid _connection;
    private string? _host;
    private InstantRecoveryHostDto? _hostCheck;
    private string? _folder;
    private string? _pool;
    private string? _name;
    private bool _connectNics;
    private int? _overlayLimitGiB;
    private bool _busy;
    private InstantRecoveryDto? _migrate;
    private List<InventoryItemDto> _migrateInventory = [];
    private string? _targetDatastore;
    private string? _targetHost;
    private bool _thin = true;
    private InstantRecoveryDto? _stop;
    private string? _stopConfirm;

    /// <summary>The restore point to start an instant recovery of.</summary>
    [SupplyParameterFromQuery(Name = "point")] public Guid? Point { get; set; }

    private string Name => string.IsNullOrWhiteSpace(_name) ? $"{_point?.VmName} (instant)" : _name.Trim();

    private string StopName => _stop?.Vms.FirstOrDefault()?.Name ?? string.Empty;

    /// <summary>What keeps the start from going (shown, and the button disabled).</summary>
    private IEnumerable<string> Problems
    {
        get
        {
            if (_server is { Enabled: false })
            {
                yield return "Instant recovery is off on this backup server (see above).";
            }

            if (_connections is { Count: 0 })
            {
                yield return "No vCenter is connected. Add one under Backup Infrastructure → Virtualization.";
            }

            if (_host is null)
            {
                yield return "Choose the ESXi host that runs the VM.";
            }

            foreach (var problem in _hostCheck?.Problems ?? [])
            {
                yield return problem;
            }

            // Without a swap datastore of the host, ESXi powers the VM on only if its swap file fits into the datastore.
            if (_hostCheck is { SwapDatastore: null } && _point is { MemoryBytes: > 0 } point)
            {
                var needed = point.MemoryBytes + (1L << 30);
                if (_overlayLimitGiB is > 0 and var gib && gib * (1L << 30) < needed)
                {
                    yield return $"Raise the write limit to at least {Math.Ceiling(needed / (double)(1L << 30))} GiB: the VM's swap file ({Fmt.Bytes(point.MemoryBytes)}) goes into the instant recovery's datastore, and ESXi powers the VM on only if it fits.";
                }
                else if (_hostCheck.OverlayFreeBytes is { } free && free < needed)
                {
                    yield return $"This server's overlay volume has only {Fmt.Bytes(free)} free: too little for the VM's swap file ({Fmt.Bytes(point.MemoryBytes)}), which goes into the instant recovery's datastore.";
                }
            }

            foreach (var nic in _point?.Nics ?? [])
            {
                if (_networks.GetValueOrDefault(nic.Device) is null)
                {
                    yield return $"Choose a network for NIC {nic.Device}: this vCenter has none named {nic.NetworkName}.";
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = RefreshLoopAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Point is not { } id || _point?.Id == id)
        {
            return;
        }

        try
        {
            _point = await Api.GetAsync<RestorePointDto>($"api/restore-points/{id}");
            _connections = (await Api.GetAsync<List<ConnectionDto>>("api/connections")).Where(c => c.Kind == "VSphere").ToList();
            _name = $"{_point.VmName} (instant)";
            _connection = _connections.FirstOrDefault(c => c.Id == _point.ConnectionId)?.Id ?? _connections.FirstOrDefault()?.Id ?? Guid.Empty;
            await LoadInventoryAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _server = await Api.GetAsync<InstantRecoveryServerDto>("api/instant-recoveries/server");
            _recoveries = await Api.GetAsync<List<InstantRecoveryDto>>("api/instant-recoveries");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _recoveries ??= [];
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_disposed.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OnConnectionChangedAsync(Guid connection)
    {
        _connection = connection;
        await LoadInventoryAsync();
    }

    /// <summary>The target vCenter's hosts, folders, pools and networks; the original folder and networks chosen where it has them.</summary>
    private async Task LoadInventoryAsync()
    {
        _inventory = _connection == Guid.Empty ? [] : await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{_connection}/inventory");
        var original = _inventory.FirstOrDefault(i => i.Kind == "Vm" && i.NativeId == _point?.VmNativeId);
        _folder = original?.Properties.GetValueOrDefault("folder") is { } folder && _inventory.Any(i => i.NativeId == folder) ? folder : null;
        _pool = null;
        // The original's host (the inventory names it by id or by name), else the only host there is.
        var originalHost = original?.Properties.GetValueOrDefault("host") is { } host
            ? _inventory.FirstOrDefault(i => i.Kind == "Host" && (i.NativeId == host || string.Equals(i.Name, host, StringComparison.OrdinalIgnoreCase)))?.NativeId
            : null;
        _host = originalHost ?? (_inventory.Count(i => i.Kind == "Host") == 1 ? _inventory.First(i => i.Kind == "Host").NativeId : null);
        _networks.Clear();
        foreach (var nic in _point?.Nics ?? [])
        {
            _networks[nic.Device] = _inventory.Any(i => i.Kind == "Network" && i.NativeId == nic.NetworkId) ? nic.NetworkId : null;
        }

        await CheckHostAsync();
    }

    private async Task OnHostChangedAsync(string? host)
    {
        _host = host;
        await CheckHostAsync();
    }

    /// <summary>The chosen host's VMkernel addresses, mount limit and problems (before anything is started).</summary>
    private async Task CheckHostAsync()
    {
        _hostCheck = null;
        if (_host is null)
        {
            return;
        }

        try
        {
            _hostCheck = await Api.GetAsync<InstantRecoveryHostDto>($"api/instant-recoveries/host?connectionId={_connection}&hostId={Uri.EscapeDataString(_host)}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task StartAsync()
    {
        if (_point is null || _host is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var changed = _point.Nics.Where(n => _networks.GetValueOrDefault(n.Device) is { } network && network != n.NetworkId)
                .ToDictionary(n => n.Device, n => _networks[n.Device]!, StringComparer.Ordinal);
            var started = await Api.PostAsync<StartedDto>("api/instant-recoveries", new StartInstantRecoveryDto
            {
                ConnectionId = _connection,
                HostId = _host,
                Vms = [new InstantRecoveryVmRequestDto(_point.Id, Name, changed.Count == 0 ? null : changed)],
                FolderId = _folder,
                ResourcePoolId = _pool,
                ConnectNics = _connectNics,
                OverlayLimitBytes = _overlayLimitGiB is > 0 and var gib ? gib * (1L << 30) : null,
            });
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenMigrateAsync(InstantRecoveryDto recovery)
    {
        _stop = null;
        _migrate = recovery;
        _targetDatastore = null;
        _targetHost = null;
        _thin = true;
        try
        {
            _migrateInventory = await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{recovery.ConnectionId}/inventory");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _migrateInventory = [];
        }
    }

    private async Task MigrateAsync()
    {
        if (_migrate is not { } recovery || _targetDatastore is null)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Api.PostAsync($"api/instant-recoveries/{recovery.SessionId}/migrate", new MigrateInstantRecoveryDto(_targetDatastore, _targetHost, null, _thin));
            Snackbar.Add($"Migrating {string.Join(", ", recovery.Vms.Select(v => v.Name))} to {MigrateName(_targetDatastore)}; the session log shows its progress.", Severity.Info);
            _migrate = null;
        });
    }

    private void OpenStop(InstantRecoveryDto recovery)
    {
        _migrate = null;
        _stop = recovery;
        _stopConfirm = null;
    }

    private async Task StopAsync()
    {
        if (_stop is not { } recovery)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Api.PostAsync($"api/instant-recoveries/{recovery.SessionId}/stop");
            _stop = null;
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool Ended(InstantRecoveryDto recovery) => recovery.State is "Stopped" or "Migrated" or "Failed";

    private string InventoryName(string? id) => Named(_inventory, id);

    private string MigrateName(string? id) => Named(_migrateInventory, id);

    private static string Named(List<InventoryItemDto> inventory, string? id) =>
        string.IsNullOrEmpty(id) ? string.Empty
        : inventory.FirstOrDefault(i => i.NativeId == id) is { } item
            ? item.Kind is "Folder" or "ResourcePool" ? PathOf(item)
              : item.Kind == "Storage" && item.Properties.GetValueOrDefault("type") is { Length: > 0 } type ? $"{item.Name} ({type})" : item.Name
            : id;

    private static string PathOf(InventoryItemDto item) => item.Properties.GetValueOrDefault("path") ?? item.Name;

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
