    {
      "type": "timeseries",
      "title": "Snapshots by consistency (per day)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
