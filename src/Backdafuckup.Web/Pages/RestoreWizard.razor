@page "/restore/{Id:guid}"
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Restore VM – backdafuckup</PageTitle>
<PageHeader Title="@(FromTape ? "Restore Entire VM from Tape" : "Restore Entire VM")" Back="@(FromTape ? "/infrastructure/tape" : "/backups")" />

@if (_point is null || _pools is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="wizard" Elevation="0" Outlined="true">
        <WizardSteps Steps="Steps" Current="_step" CanSelect="@(index => index <= _step)" OnSelect="@(index => _step = index)" />

        <div class="wizard-body">
        @switch (_step)
        {
            case 0:
                <MudText Typo="Typo.h6">@_point.VmName</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">Restore point from @Fmt.Time(_point.CreatedUtc) (@_point.Kind, job @_point.JobName) · @_point.VCpus vCPU · @Fmt.Bytes(_point.MemoryBytes) RAM · @_point.Firmware</MudText>
                @if (_point.DomainController && !_point.HasVmGenerationId)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        This VM was a domain controller@(string.IsNullOrEmpty(_point.AdDomain) ? string.Empty : $" of {_point.AdDomain}"), and the backup has no VM generation id of it
                        (its VM has none, or the restore point is older than this record). The restored VM gets none either, so Windows cannot tell that it was restored: if other
                        domain controllers of the domain still run, a USN rollback can follow. Start it without network and follow "Restoring a whole domain controller" in the admin guide.
                        Single objects come back safely under Restore → Active Directory objects.
                    </MudAlert>
                }
                else if (_point.DomainController)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        This VM was a domain controller@(string.IsNullOrEmpty(_point.AdDomain) ? string.Empty : $" of {_point.AdDomain}"). The restored VM gets a new VM generation id,
                        so at its first start Windows restores Active Directory non-authoritatively and takes the newer changes from the other domain controllers.
                        Objects deleted since the backup do not come back this way.
                    </MudAlert>
                }
                @if (FromTape)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        The restore point is on tape. The server reads it into a cache on its own disk (up to @Fmt.Bytes(_point.NewStoredBytes)), frees the drive, restores the VM
                        from there, and deletes the cache. A tape that is not in the library is asked for.
                    </MudAlert>
                }
                <MudRadioGroup T="RestoreModeDto" Value="_mode" ValueChanged="OnModeChangedAsync">
                    <MudRadio T="RestoreModeDto" Value="RestoreModeDto.OriginalLocation" Disabled="@(SourceKind is null)">Restore to the original location</MudRadio>
                    <MudRadio T="RestoreModeDto" Value="RestoreModeDto.AlternateLocation">Restore to a new location or with different settings</MudRadio>
                </MudRadioGroup>
                <MudText Typo="Typo.body2" Class="mt-2 mb-1">
                    @if (SourceKind is null)
                    {
                        <span>The pool or vCenter this VM was backed up from is no longer connected, so it is restored as a new VM: you choose the name and where it goes next.</span>
                    }
                    else if (_mode == RestoreModeDto.OriginalLocation)
                    {
                        <span>
                            The VM comes back as <b>@_point.VmName</b> in @SourceName, where it was backed up:
                            @(SourceIsVsphere ? "in its original folder and resource pool, " : string.Empty)its disks on their original @(SourceIsVsphere ? "datastores" : "storage repositories")
                            (@string.Join(", ", _point.Disks.Select(d => d.StorageName ?? d.StorageId ?? "unknown").Distinct())).
                        </span>
                        @if (QuickRollback)
                        {
                            <span> The existing VM keeps its name and identity; only its disks are written back.</span>
                        }
                        else if (OriginalExists)
                        {
                            <span> <b>The VM still exists there.</b> Tick "Replace the existing VM" (it is shut down and renamed "@_point.VmName (replaced …)", or deleted afterwards if chosen),
                                @(SourceIsVsphere ? "use quick rollback, " : string.Empty)or restore to a new location.</span>
                        }
                        else
                        {
                            <span> The VM no longer exists there; it is created again with its name, BIOS UUID and MAC addresses.</span>
                        }
                    }
                    else
                    {
                        <span>
                            A new VM, by default named <b>@($"{_point.VmName}_restored")</b>, on the @(SourceIsVsphere ? "vCenter, host, folder and datastores" : "pool, host and storage") you choose next,
                            with new MAC addresses unless you keep them. The original VM is not touched.
                        </span>
                    }
                </MudText>
                @if (SourceIsVsphere && !FromTape)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-2 mb-2" Icon="@Icons.Material.Filled.Bolt">
                        Needed right now? <MudLink Href="@($"/instant-recovery?point={Id}")">Instant recovery</MudLink> runs @_point.VmName from this restore point within minutes,
                        from a datastore this backup server serves, and moves it to production storage later while it runs.
                    </MudAlert>
                }
                @if (_mode == RestoreModeDto.OriginalLocation && SourceIsVsphere)
                {
                    <MudCheckBox @bind-Value="_quickRollback" Label="Quick rollback: write back into the existing VM only what changed since the restore point" Class="mt-2"
                                 Disabled="@_point.DomainController" />
                    @if (_point.DomainController)
                    {
                        <MudText Typo="Typo.caption">
                            Not for a domain controller: it would keep its VM generation id, and Active Directory would not notice that it went back in time (USN rollback).
                        </MudText>
                    }
                    else if (_quickRollback)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                            The VM is shut down and a safety snapshot taken; changed block tracking tells which blocks changed since the restore point, and only those are
                            written back, which takes minutes instead of hours for large disks. If anything fails, the VM goes back to the safety snapshot. Afterwards change
                            tracking is reset, so the next backup reads the disks fully. It needs the VM with the same disks and change tracking on since the restore point;
                            for damage of the disks themselves (storage errors) restore the VM fully.
                        </MudAlert>
                        <MudCheckBox @bind-Value="_keepSafetySnapshot" Label="Keep the safety snapshot (the VM as it was before the rollback) instead of removing it" />
                    }
                }
                @if (_mode == RestoreModeDto.OriginalLocation && !QuickRollback)
                {
                    <MudCheckBox @bind-Value="_replace" Label="Replace the existing VM if it still exists (it is shut down and renamed; its jobs then back up the restored VM)" Class="mt-2" />
                    @if (_replace)
                    {
                        <MudCheckBox @bind-Value="_deleteReplaced" Label="Delete the replaced VM and its disks after a successful restore" Color="Color.Error" />
                    }
                }
                @if (_point.MemoryImageBytes is > 0)
                {
                    <MudText Typo="Typo.subtitle1" Class="mt-4">Memory</MudText>
                    <MudRadioGroup T="bool" Value="_resume" ValueChanged="OnResumeChangedAsync">
                        <MudRadio T="bool" Value="false">Boot from the disks (cold start)</MudRadio>
                        <MudRadio T="bool" Value="true" Disabled="@IsDomainController">Resume with memory: the VM continues where it was at the backup</MudRadio>
                    </MudRadioGroup>
                    @if (IsDomainController)
                    {
                        <MudText Typo="Typo.caption">
                            A domain controller does not resume: it would continue its directory from the backup without Windows noticing a restore (USN rollback).
                            @(_point.DomainControllerEvidence is { } evidence ? $"This VM is one: {evidence}." : null)
                        </MudText>
                    }
                    else if (_resume)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                            The memory image (@Fmt.Bytes(_point.MemoryImageBytes.Value) stored) is restored as well, and the VM is created suspended. It resumes only in the pool it was
                            backed up in. A copy at another location gets no network connections, since its memory holds the original's addresses and connections.
                        </MudAlert>
                    }
                }
                break;

            case 1:
                @if (_mode == RestoreModeDto.AlternateLocation)
                {
                    @if (_pools.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            No @(SourceIsVsphere ? "vCenter" : SourceKind is null ? "pool or vCenter" : "XCP-ng pool") is connected to restore this VM to. Add one under Backup Infrastructure → Virtualization.
                        </MudAlert>
                    }
                    <MudSelect T="Guid" Value="_targetPool" ValueChanged="OnPoolChangedAsync" Label="@(SourceIsVsphere ? "Target vCenter" : "Target pool")" Variant="Variant.Outlined" Class="mb-3" Disabled="_resume"
                               ToStringFunc="@(id => _pools.FirstOrDefault(p => p.Id == id)?.DisplayName ?? string.Empty)"
                               HelperText="@(_resume ? "A VM with memory resumes only in the pool it was backed up in." : SourceKind is null ? null : $"Only {(SourceIsVsphere ? "vCenters" : "XCP-ng pools")}: a VM goes back to the kind of platform it was backed up from.")">
                        @foreach (var pool in _pools)
                        {
                            <MudSelectItem T="Guid" Value="pool.Id">@pool.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_vmName" Label="VM name" Variant="Variant.Outlined" Class="mb-3" HelperText="The name of the new VM in the target." />
                    <MudSelect T="string" @bind-Value="_host" Label="Host (optional)" Variant="Variant.Outlined" Clearable="true" Class="mb-3" ToStringFunc="InventoryName">
                        @foreach (var host in _inventory.Where(i => i.Kind == "Host"))
                        {
                            <MudSelectItem T="string" Value="host.NativeId">@host.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @if (TargetIsVsphere)
                    {
                        <MudSelect T="string" @bind-Value="_folder" Label="VM folder" Variant="Variant.Outlined" Class="mb-3" ToStringFunc="InventoryName"
                                   HelperText="Where the VM appears in the vCenter; the vCenter account needs the right to create VMs there.">
                            @foreach (var folder in _inventory.Where(i => i.Kind == "Folder").OrderBy(i => Path(i), StringComparer.OrdinalIgnoreCase))
                            {
                                <MudSelectItem T="string" Value="folder.NativeId">@Path(folder)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_resourcePool" Label="Resource pool" Variant="Variant.Outlined" Class="mb-3" ToStringFunc="InventoryName">
                            @foreach (var pool in _inventory.Where(i => i.Kind == "ResourcePool").OrderBy(i => Path(i), StringComparer.OrdinalIgnoreCase))
                            {
                                <MudSelectItem T="string" Value="pool.NativeId">@Path(pool)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                }
                else if (QuickRollback)
                {
                    <MudText Class="mb-3">The rollback writes into the VM's own disks, where they are.</MudText>
                }
                <MudText Typo="Typo.subtitle1" Class="mb-2">@(TargetIsVsphere ? "Datastore per disk (new disks are thin)" : "Storage per disk")</MudText>
                @foreach (var disk in _point.Disks)
                {
                    <MudSelect T="string" Value="@_storage.GetValueOrDefault(disk.Key)" ValueChanged="@(v => _storage[disk.Key] = v)" Label="@($"{disk.Name} ({Fmt.Bytes(disk.CapacityBytes)})")" Variant="Variant.Outlined" Class="mb-3" Disabled="@(_mode == RestoreModeDto.OriginalLocation)"
                               ToStringFunc="InventoryName" HelperText="@($"Was on {disk.StorageName ?? disk.StorageId ?? "unknown"}")">
                        @foreach (var sr in _inventory.Where(i => i.Kind == "Storage"))
                        {
                            <MudSelectItem T="string" Value="sr.NativeId">@sr.Name (@sr.Properties.GetValueOrDefault("type"))</MudSelectItem>
                        }
                    </MudSelect>
                }
                break;

            case 2:
                @if (_resume && _mode == RestoreModeDto.AlternateLocation)
                {
                    <MudText>The copy resumes without network connections: its NICs are removed, since its memory holds the original's addresses. Add a NIC (e.g. on an isolated network) once it may be connected.</MudText>
                }
                else if (_mode == RestoreModeDto.AlternateLocation)
                {
                    @foreach (var nic in _point.Nics)
                    {
                        <MudSelect T="string" Value="@_networks.GetValueOrDefault(nic.Device)" ValueChanged="@(v => _networks[nic.Device] = v)" Label="@($"NIC {nic.Device} (was {nic.NetworkName}, {nic.Mac})")" Variant="Variant.Outlined" Class="mb-3"
                                   ToStringFunc="InventoryName">
                            @foreach (var net in _inventory.Where(i => i.Kind == "Network"))
                            {
                                <MudSelectItem T="string" Value="net.NativeId">@net.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudCheckBox @bind-Value="_regenerateMacs" Label="Generate new MAC addresses (recommended when the original VM still exists)" />
                    @if (TargetIsVsphere)
                    {
                        <MudSelect T="string" @bind-Value="_connectNics" Label="Network connection at the first start" Variant="Variant.Outlined" Class="mt-3">
                            <MudSelectItem T="string" Value="@("auto")">Automatic: disconnected while the original VM exists, else connected</MudSelectItem>
                            <MudSelectItem T="string" Value="@("on")">Connected</MudSelectItem>
                            <MudSelectItem T="string" Value="@("off")">Disconnected (connect the NICs in vCenter later)</MudSelectItem>
                        </MudSelect>
                        <MudText Typo="Typo.caption">A copy comes up with the original's network settings inside the guest (addresses, host name): keep it off the network while the original runs.</MudText>
                    }
                }
                else
                {
                    <MudText>The VM keeps its original networks and MAC addresses.</MudText>
                }
                <MudCheckBox @bind-Value="_powerOn" Label="@(_resume ? "Resume the VM after the restore (otherwise it stays suspended)" : "Power on the VM after the restore")" Class="mt-2" />
                @if (_point.DomainController && _mode == RestoreModeDto.AlternateLocation && _powerOn)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        A copy of a domain controller has the same computer name, addresses and computer account as the original. If the original still runs, connect the copy only to an isolated network.
                    </MudAlert>
                }
                break;

            default:
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td style="width:220px">VM</td><td>@_point.VmName → @(_mode == RestoreModeDto.OriginalLocation ? _point.VmName : _vmName)@(_mode == RestoreModeDto.OriginalLocation && _replace && !QuickRollback ? $" (the existing VM is {(_deleteReplaced ? "deleted after the restore" : $"renamed '{_point.VmName} (replaced …)'")})" : null)</td></tr>
                        <tr><td>Restore point</td><td>@Fmt.Time(_point.CreatedUtc)</td></tr>
                        <tr><td>Location</td><td>@(_mode == RestoreModeDto.OriginalLocation ? $"where it was backed up: {SourceName}" : _pools.FirstOrDefault(p => p.Id == _targetPool)?.DisplayName)@(_mode == RestoreModeDto.AlternateLocation && _host is not null ? $", host {InventoryName(_host)}" : null)</td></tr>
                        @if (QuickRollback)
                        {
                            <tr><td>Quick rollback</td><td>only the blocks changed since the restore point, under a safety snapshot@(_keepSafetySnapshot ? " that is kept" : null)</td></tr>
                        }
                        else
                        {
                            <tr><td>Disks</td><td>@string.Join(", ", _point.Disks.Select(d => $"{d.Name} → {StorageName(_storage.GetValueOrDefault(d.Key))}"))</td></tr>
                        }
                        @if (TargetIsVsphere && _mode == RestoreModeDto.AlternateLocation)
                        {
                            <tr><td>Folder, resource pool</td><td>@(Path(_inventory.FirstOrDefault(i => i.NativeId == _folder)) ?? "as the original") · @(Path(_inventory.FirstOrDefault(i => i.NativeId == _resourcePool)) ?? "as the original")</td></tr>
                            <tr><td>Network at the first start</td><td>@(_connectNics switch { "on" => "connected", "off" => "disconnected", _ => "disconnected while the original exists" })</td></tr>
                        }
                        @if (_point.MemoryImageBytes is > 0)
                        {
                            <tr><td>Memory</td><td>@(_resume ? "resume where it was at the backup" + (_mode == RestoreModeDto.AlternateLocation ? ", without network connections" : string.Empty) : "cold start from the disks")</td></tr>
                        }
                        <tr><td>@(_resume ? "Resume" : "Power on")</td><td>@(_powerOn ? "yes" : "no")</td></tr>
                    </tbody>
                </MudSimpleTable>
                @if (QuickRollback)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">The VM is shut down for the rollback and started again afterwards if it was running.</MudAlert>
                }
                else if (_mode == RestoreModeDto.OriginalLocation && _replace)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">The existing VM will be shut down@(_deleteReplaced ? " and deleted after the restore" : " and renamed").</MudAlert>
                }
                break;
        }

        @if (StepProblem is { } problem)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@problem</MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
        </div>

        <div class="wizard-actions">
            <MudButton Href="/backups">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Disabled="@(_step == 0)" StartIcon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => _step--)">Back</MudButton>
            @if (_step < Steps.Length - 1)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" Disabled="@(StepProblem is not null)" OnClick="@(() => _step++)">Next</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || Problems.Any())" StartIcon="@AppIcons.Restore" OnClick="StartAsync">Restore</MudButton>
            }
        </div>
    </MudPaper>
}

@code {
    private static readonly string[] Steps = ["Mode", "Target", "Network", "Summary"];

    [Parameter] public Guid Id { get; set; }

    /// <summary>Id is a tape copy: restored directly from tape, through a cache.</summary>
    [SupplyParameterFromQuery(Name = "tape")] public bool FromTape { get; set; }

    private RestorePointDto? _point;
    private List<ConnectionDto>? _allPools;
    private List<ConnectionDto>? _pools;
    private List<InventoryItemDto> _inventory = [];
    private readonly Dictionary<string, string> _storage = [];
    private readonly Dictionary<string, string> _networks = [];
    private RestoreModeDto _mode = RestoreModeDto.AlternateLocation;
    private Guid _targetPool;
    private string _vmName = string.Empty;
    private string? _host;
    private bool _replace;
    private bool _deleteReplaced;
    private bool _regenerateMacs = true;
    private bool _powerOn;
    private bool _resume;
    private bool _quickRollback;
    private bool _keepSafetySnapshot;
    private string? _folder;
    private string? _resourcePool;
    private string _connectNics = "auto";

    /// <summary>The kind of the pool or vCenter the VM was backed up from; null when that connection is gone.</summary>
    private string? SourceKind => _allPools?.FirstOrDefault(p => p.Id == _point?.ConnectionId)?.Kind;

    private string SourceName => _allPools?.FirstOrDefault(p => p.Id == _point?.ConnectionId)?.DisplayName ?? "its pool or vCenter";

    private bool SourceIsVsphere => SourceKind == "VSphere";

    private bool TargetIsVsphere => _allPools?.FirstOrDefault(p => p.Id == (_mode == RestoreModeDto.AlternateLocation ? _targetPool : _point?.ConnectionId))?.Kind == "VSphere";

    /// <summary>The backed-up VM still exists where it was (the inventory shown is the source's while restoring to the original location).</summary>
    private bool OriginalExists => _point is not null && _targetPool == _point.ConnectionId && _inventory.Any(i => i.Kind == "Vm" && i.NativeId == _point.VmNativeId);

    /// <summary>What keeps the current step from going on, said plainly; null when it may.</summary>
    private string? StepProblem => Problems.Where(p => p.Step <= _step).Select(p => p.Text).FirstOrDefault();

    private IEnumerable<(int Step, string Text)> Problems
    {
        get
        {
            if (_point is null)
            {
                yield break;
            }

            var alternate = _mode == RestoreModeDto.AlternateLocation;
            if (!alternate && QuickRollback && !OriginalExists)
            {
                yield return (0, $"Quick rollback needs the existing VM, but {_point.VmName} no longer exists in {SourceName}. Restore it fully instead.");
            }
            else if (!alternate && !QuickRollback && OriginalExists && !_replace)
            {
                yield return (0, $"{_point.VmName} still exists in {SourceName}: tick 'Replace the existing VM'{(SourceIsVsphere ? ", use quick rollback" : string.Empty)}, or restore to a new location.");
            }

            if (alternate && _targetPool == Guid.Empty)
            {
                yield return (1, "Choose where the VM is restored to.");
            }

            if (alternate && string.IsNullOrWhiteSpace(_vmName))
            {
                yield return (1, "Enter a name for the new VM.");
            }

            var noStorage = _point.Disks.Where(d => !_storage.ContainsKey(d.Key)).Select(d => d.Name).ToList();
            if (alternate && noStorage.Count > 0)
            {
                yield return (1, $"Choose {(TargetIsVsphere ? "a datastore" : "a storage repository")} for {string.Join(", ", noStorage)}.");
            }

            var noNetwork = _point.Nics.Where(n => !_networks.ContainsKey(n.Device)).Select(n => $"NIC {n.Device} (was {n.NetworkName})").ToList();
            if (alternate && !_resume && noNetwork.Count > 0)
            {
                yield return (2, $"Choose a network for {string.Join(", ", noNetwork)}: the target has none of the same name.");
            }
        }
    }

    /// <summary>A host, folder, pool, storage or network of the target by its name (with its path for folders and resource pools).</summary>
    private string InventoryName(string? id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return string.Empty;
        }

        return _inventory.FirstOrDefault(i => i.NativeId == id) is { } item
            ? item.Kind is "Folder" or "ResourcePool" ? Path(item) ?? item.Name
              : item.Kind == "Storage" && item.Properties.GetValueOrDefault("type") is { Length: > 0 } type ? $"{item.Name} ({type})" : item.Name
            : id;
    }

    private bool QuickRollback => _quickRollback && _mode == RestoreModeDto.OriginalLocation && SourceIsVsphere && _point is { DomainController: false };

    private static string? Path(InventoryItemDto? item) => item is null ? null : item.Properties.GetValueOrDefault("path") ?? item.Name;

    /// <summary>The restore point shows a DC, or (with memory, so without guest details) the VM's agent or another restore point does.</summary>
    private bool IsDomainController => _point is { DomainController: true } or { DomainControllerEvidence: not null };
    private int _step;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _point = await Api.GetAsync<RestorePointDto>(FromTape ? $"api/tape/copies/{Id}/restore-point" : $"api/restore-points/{Id}");
        _allPools = await Api.GetAsync<List<ConnectionDto>>("api/connections?kind=XenServer,VSphere");

        // A VM goes back to the kind of platform it came from (a vSphere VM into a vCenter, an XCP-ng VM into a pool).
        _pools = SourceKind is { } kind ? [.. _allPools.Where(p => p.Kind == kind)] : _allPools;
        if (SourceKind is null)
        {
            _mode = RestoreModeDto.AlternateLocation;
        }

        _vmName = $"{_point.VmName}_restored";
        _targetPool = _point.ConnectionId is { } source && _pools.Any(p => p.Id == source) ? source : _pools.FirstOrDefault()?.Id ?? Guid.Empty;
        foreach (var disk in _point.Disks)
        {
            if (disk.StorageId is not null)
            {
                _storage[disk.Key] = disk.StorageId;
            }
        }

        foreach (var nic in _point.Nics)
        {
            _networks[nic.Device] = nic.NetworkId;
        }

        await LoadInventoryAsync();
    }

    private async Task OnPoolChangedAsync(Guid pool)
    {
        _targetPool = pool;
        await LoadInventoryAsync();
    }

    /// <summary>The original location is the source's: its inventory is shown again (and tells whether the VM still exists).</summary>
    private async Task OnModeChangedAsync(RestoreModeDto mode)
    {
        _mode = mode;
        if (mode == RestoreModeDto.OriginalLocation && _point!.ConnectionId is { } source && source != _targetPool)
        {
            await OnPoolChangedAsync(source);
        }
    }

    /// <summary>A VM resumes only in the pool it was backed up in.</summary>
    private async Task OnResumeChangedAsync(bool resume)
    {
        _resume = resume;
        if (resume && _point!.ConnectionId is { } pool && pool != _targetPool)
        {
            await OnPoolChangedAsync(pool);
        }
    }

    private async Task LoadInventoryAsync()
    {
        _inventory = _targetPool == Guid.Empty ? [] : await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{_targetPool}/inventory");

        // vSphere: by default where the original VM is (if it is in this vCenter), else the first place offered.
        var original = _inventory.FirstOrDefault(i => i.Kind == "Vm" && i.NativeId == _point?.VmNativeId);
        _folder = original?.Properties.GetValueOrDefault("folder") is { } folder && _inventory.Any(i => i.NativeId == folder) ? folder
            : _inventory.Where(i => i.Kind == "Folder").OrderBy(i => Path(i), StringComparer.OrdinalIgnoreCase).FirstOrDefault()?.NativeId;
        _resourcePool = original?.Properties.GetValueOrDefault("resourcePool") is { } pool && _inventory.Any(i => i.NativeId == pool) ? pool
            : _inventory.Where(i => i.Kind == "ResourcePool").OrderBy(i => Path(i), StringComparer.OrdinalIgnoreCase).FirstOrDefault()?.NativeId;
        if (_host is not null && !_inventory.Any(i => i.Kind == "Host" && i.NativeId == _host))
        {
            _host = null;
        }

        // Each disk and NIC keeps its storage and network where the target has it (by id, else by name); otherwise it is chosen.
        foreach (var disk in _point!.Disks)
        {
            var match = _inventory.FirstOrDefault(i => i.Kind == "Storage" && i.NativeId == _storage.GetValueOrDefault(disk.Key))
                ?? _inventory.FirstOrDefault(i => i.Kind == "Storage" && i.NativeId == disk.StorageId)
                ?? _inventory.FirstOrDefault(i => i.Kind == "Storage" && disk.StorageName is not null && string.Equals(i.Name, disk.StorageName, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                _storage.Remove(disk.Key);
            }
            else
            {
                _storage[disk.Key] = match.NativeId;
            }
        }

        foreach (var nic in _point.Nics)
        {
            var match = _inventory.FirstOrDefault(i => i.Kind == "Network" && i.NativeId == _networks.GetValueOrDefault(nic.Device))
                ?? _inventory.FirstOrDefault(i => i.Kind == "Network" && i.NativeId == nic.NetworkId)
                ?? _inventory.FirstOrDefault(i => i.Kind == "Network" && string.Equals(i.Name, nic.NetworkName, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                _networks.Remove(nic.Device);
            }
            else
            {
                _networks[nic.Device] = match.NativeId;
            }
        }
    }

    private string StorageName(string? id) => _inventory.FirstOrDefault(i => i.NativeId == id)?.Name ?? id ?? "original";

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var alternate = _mode == RestoreModeDto.AlternateLocation;
            var started = await Api.PostAsync<StartedDto>(FromTape ? $"api/tape/copies/{Id}/restore-vm" : "api/restores", new RestoreRequestDto
            {
                RestorePointId = Id,
                Mode = _mode,
                TargetConnectionId = alternate ? _targetPool : _point!.ConnectionId,
                VmName = alternate ? _vmName : null,
                TargetHostId = alternate ? _host : null,
                DiskStorage = alternate ? new Dictionary<string, string>(_storage) : [],
                NetworkMap = alternate ? new Dictionary<string, string>(_networks) : [],
                RegenerateMacs = alternate && _regenerateMacs,
                PowerOn = _powerOn,
                ReplaceExisting = !alternate && !QuickRollback && _replace,
                DeleteReplaced = !alternate && !QuickRollback && _replace && _deleteReplaced,
                ResumeWithMemory = _resume,
                QuickRollback = QuickRollback,
                KeepSafetySnapshot = QuickRollback && _keepSafetySnapshot,
                TargetFolderId = alternate && TargetIsVsphere ? _folder : null,
                TargetResourcePoolId = alternate && TargetIsVsphere ? _resourcePool : null,
                ConnectNics = !alternate || !TargetIsVsphere ? null : _connectNics switch { "on" => true, "off" => false, _ => null },
            });
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
