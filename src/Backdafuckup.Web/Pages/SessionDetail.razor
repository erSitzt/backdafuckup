@page "/sessions/{Id:guid}"
@implements IAsyncDisposable
@inject ApiClient Api
@inject LiveConnection Live
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Session – backdafuckup</PageTitle>

@if (_session is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <PageHeader Title="@_session.Name" Back="/sessions">
        <TitleContent><StateChip State="@_session.State" /></TitleContent>
        <DescriptionContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                @AppIcons.Svg(ObjectKindUi.Session(_session).Icon, $"kind-icon {ObjectKindUi.Session(_session).Css}")@Fmt.Kind(_session.Kind, _session.ObjectKind) · started by @_session.TriggeredBy · @Fmt.Time(_session.StartedUtc ?? _session.CreatedUtc)@(_session.Kind == "SqlBackup" ? "" : $" · duration {Fmt.Duration(_session.StartedUtc, _session.EndedUtc)}")
                @if (_session.Summary is not null) { <span> · @_session.Summary</span> }
            </MudText>
        </DescriptionContent>
        <Actions>
        @if (_session.State is "Running" or "Queued" && _session.Kind != "SqlBackup")
        {
            @if (_session.Kind == "SqlPublish")
            {
                <MudTooltip Text="Removes the database from the instance and the backup's volumes from the VM; changes made to the published database are discarded.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LinkOff" OnClick="StopAsync">Unpublish</MudButton>
                </MudTooltip>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopAsync">Stop</MudButton>
            }
        }
        </Actions>
    </PageHeader>
    var m = _session.Metrics ?? new TransferMetricsDto { ReadBytes = _session.ReadBytes, StoredBytes = _session.TransferredBytes };
    var running = _session.State is "Running" or "Stopping";
    @if (_session.Kind == "SqlExport")
    {
        @if (_session.State is "Running" or "Queued")
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                The database is published in the VM (nothing is copied), backed up copy-only with checksums, verified, and unpublished
                again. The backup itself cannot be stopped halfway.
            </MudAlert>
        }
        else if (_exportFile is { } file)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                <div class="d-flex align-center flex-wrap" style="gap: 12px">
                    <span><b>@file.FileName</b> (@Fmt.Bytes(file.SizeBytes)) is on the backup server until @Fmt.Time(file.ExpiresUtc).</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadExportAsync">Download .bak</MudButton>
                </div>
            </MudAlert>
        }
    }
    else if (_session.Kind == "SqlPublish")
    {
        @if (_session.State == "Running")
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                The database is attached from the backup: nothing was copied, and changes go to a temporary overlay in the VM.
                <b>Unpublish</b> removes the database and the volumes again and discards the changes; the agent in the VM does no other
                restore work until then.
            </MudAlert>
        }
    }
    else if (_session.Kind == "SqlBackup")
    {
        @if (running)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        }
    }
    else
    {
        <MudProgressLinear Color="Color.Primary" Value="@_session.Progress" Size="Size.Large" Class="mb-4">@($"{_session.Progress:0}%")</MudProgressLinear>
    }

    @if (_session.Kind is "SqlPublish" or "SqlRestore" or "SqlExport")
    {
    }
    else if (_session.Kind == "SqlBackup")
    {
        @if (_day is { } day)
        {
            var (rpoValue, rpoDetail, rpoColor) = Rpo(day);
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="6" md="3"><StatTile Title="Log backups" Value="@day.LogBackups.ToString()" Detail="@($"every {day.LogIntervalMinutes} min · last run {LastRun()}")" Icon="@AppIcons.LogBackup" Color="Color.Primary" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><StatTile Title="Full backups" Value="@((day.FullBackups + day.SystemFullBackups).ToString())" Detail="@($"databases {day.FullBackups} · system databases {day.SystemFullBackups}")" Icon="@AppIcons.Backups" Color="Color.Primary" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><StatTile Title="Backed up" Value="@Fmt.Bytes(day.Bytes)" Detail="@($"{Fmt.Bytes(day.NewStoredBytes)} new in the repository")" Icon="@Icons.Material.Filled.Save" Color="Color.Primary" /></MudItem>
                @if (day.Current)
                {
                    <MudItem xs="12" sm="6" md="3"><StatTile Title="RPO now" Value="@rpoValue" Detail="@rpoDetail" Icon="@Icons.Material.Filled.Timer" Color="@rpoColor" /></MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6" md="3"><StatTile Title="Databases" Value="@day.Databases.Count.ToString()" Detail="@($"{day.Databases.Count(d => d.ChainState == "Ok")} with an intact log chain now")" Icon="@AppIcons.Database" Color="Color.Primary" /></MudItem>
                }
            </MudGrid>

            @if (day.Databases.Count > 0)
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.h6" Class="section-title">Databases</MudText>
                        <MudSpacer />
                        <MudLink Href="/sql/databases" Typo="Typo.body2">All databases</MudLink>
                    </div>
                    <div class="cq">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead>
                            <tr><th>Database</th><th class="c-760">Recovery</th><th>Log chain</th><th class="c-560">Last log backup</th><th class="c-950">Last full backup</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in day.Databases)
                            {
                                <tr>
                                    <td><MudLink Href="@($"/sql/databases/{d.Id}")"><b>@d.Name</b></MudLink><span class="cell-sub">@d.Instance on @d.VmName</span></td>
                                    <td class="c-760">@(d.RecoveryModel ?? "–")</td>
                                    <td>
                                        <MudTooltip Text="@(d.ChainReason ?? SqlDatabases.ChainText(d.ChainState))">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@SqlDatabases.ChainColor(d.ChainState)" Icon="@SqlDatabases.ChainIcon(d.ChainState)">@SqlDatabases.ChainLabel(d.ChainState)</MudChip>
                                        </MudTooltip>
                                    </td>
                                    <td class="c-560 nowrap">@Fmt.Time(d.LastLogUtc)</td>
                                    <td class="c-950 nowrap">@Fmt.Time(d.LastFullUtc)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    </div>
                </MudPaper>
            }

            @if (day.Runs.Count > 0)
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.h6" Class="section-title">Runs</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@day.Runs.Count run(s) · open one for its lines</MudText>
                    </div>
                    <div class="cq">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="runs-table">
                        <thead>
                            <tr><th>Time</th><th>State</th><th class="c-560">VMs</th><th class="num">Log</th><th class="num">Full</th><th class="num c-560">Data</th><th class="num c-760">New</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in day.Runs.Take(_runsShown))
                            {
                                var open = _openRuns.Contains(r.StartedUtc);
                                <tr @key="r.StartedUtc" @onclick="() => ToggleRunAsync(r)" style="cursor:pointer">
                                    <td class="nowrap">@r.StartedUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td><StateChip State="@r.State" /></td>
                                    <td class="c-560">@r.Vms.Count</td>
                                    <td class="num">@r.LogBackups</td>
                                    <td class="num">@r.FullBackups</td>
                                    <td class="num c-560 nowrap">@Fmt.Bytes(r.Bytes)</td>
                                    <td class="num c-760 nowrap">@Fmt.Bytes(r.NewStoredBytes)</td>
                                    <td class="num"><MudIcon Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" /></td>
                                </tr>
                                @if (open)
                                {
                                    <tr @key="(r.StartedUtc, true)" class="run-detail">
                                        <td colspan="8">
                                            @foreach (var v in r.Vms)
                                            {
                                                <div class="d-flex align-center flex-wrap" style="gap:8px">
                                                    <b>@v.VmName</b>
                                                    <StateChip State="@v.State" />
                                                    <span class="cell-sub" style="margin:0">@v.LogBackups log · @v.FullBackups full · @Fmt.Bytes(v.Bytes) · @Fmt.Bytes(v.NewStoredBytes) new</span>
                                                </div>
                                                <div class="session-log run-lines mb-2">
                                                    @if (_runLines.TryGetValue(v.Id, out var lines))
                                                    {
                                                        @foreach (var line in lines)
                                                        {
                                                            <div class="@line.Severity">@line.Message</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <MudProgressLinear Indeterminate="true" Size="Size.Small" />
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                    </div>
                    @if (day.Runs.Count > _runsShown)
                    {
                        var rest = day.Runs.Count - _runsShown;
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1" OnClick="() => _runsShown += 24">@(rest <= 24 ? $"Show the other {rest} runs" : $"Show 24 more ({rest} older runs)")</MudButton>
                    }
                </MudPaper>
            }
        }
    }
    else if (_session.Kind == "TapeMaintenance")
    {
        // A library action has no data to count: its log says what happened.
    }
    else if (_session.Kind == "RepositoryMove")
    {
        // A move copies chunks the target lacks: no source disks, dedupe or compression to show.
        var seconds = _session.StartedUtc is { } from ? ((_session.EndedUtc ?? DateTimeOffset.UtcNow) - from).TotalSeconds : 0;
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="6" md="3"><StatTile Title="Duration" Value="@Fmt.Duration(_session.StartedUtc, _session.EndedUtc)" Detail="@($"{_tasks.Count} chain(s)")" Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Chains" Value="@($"{_tasks.Values.Count(t => t.State is "Succeeded")} of {_tasks.Count}")" Detail="@($"moved · {_tasks.Values.Count(t => t.State is "Warning")} left for later · {_tasks.Values.Count(t => t.State is "Failed")} failed")" Icon="@Icons.Material.Filled.DriveFileMove" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Copied" Value="@Fmt.Bytes(_session.ReadBytes)" Detail="chunks the target extent did not have" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Copy rate" Value="@Fmt.Rate(seconds > 0 ? _session.ReadBytes / seconds : null)" Detail="between the extents" Icon="@AppIcons.Performance" Color="Color.Primary" /></MudItem>
        </MudGrid>
    }
    else if (_session.Kind == "Restore")
    {
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="6" md="3"><StatTile Title="Duration" Value="@Fmt.Duration(_session.StartedUtc, _session.EndedUtc)" Detail="@($"{_tasks.Count} object(s)")" Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Restore rate" Value="@Fmt.Rate(m.ProcessingRate)" Detail="@(running ? $"current network rate {Fmt.Rate(m.CurrentBytesPerSecond)}" : $"network {Fmt.Rate(m.Seconds > 0 ? m.StoredBytes / m.Seconds : null)}")" Icon="@AppIcons.Performance" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Restored" Value="@Fmt.Bytes(m.ProcessedBytes)" Detail="@($"of {Fmt.Bytes(m.TotalBytes)} disk size")" Icon="@AppIcons.Disk" Color="Color.Primary" /></MudItem>
            <MudItem xs="6" md="3"><StatTile Title="Transferred" Value="@Fmt.Bytes(m.StoredBytes)" Detail="@($"sent to the host, {Fmt.Bytes(Math.Max(0, m.ProcessedBytes - m.StoredBytes))} empty blocks skipped")" Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" /></MudItem>
        </MudGrid>
    }
    else
    {
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="6" md="3"><StatTile Title="Duration" Value="@Fmt.Duration(_session.StartedUtc, _session.EndedUtc)" Detail="@($"{_tasks.Count} object(s)")" Icon="@Icons.Material.Filled.Timer" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Processing rate" Value="@Fmt.Rate(m.ProcessingRate)" Detail="@(running ? $"current read rate {Fmt.Rate(m.CurrentBytesPerSecond)}" : $"read rate {Fmt.Rate(m.ReadRate)}")" Icon="@AppIcons.Performance" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Processed" Value="@Fmt.Bytes(m.ProcessedBytes)" Detail="@($"of {Fmt.Bytes(m.TotalBytes)} provisioned")" Icon="@AppIcons.Disk" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Read" Value="@Fmt.Bytes(m.ReadBytes)" Detail="from the source" Icon="@Icons.Material.Filled.Download" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Transferred" Value="@Fmt.Bytes(m.StoredBytes)" Detail="@($"written to the repository, new data {Fmt.Bytes(m.NewDataBytes)}")" Icon="@Icons.Material.Filled.Save" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Dedupe" Value="@Fmt.Ratio(m.DedupeRatio)" Detail="@($"{Fmt.Bytes(m.DedupedBytes)} already stored")" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Compression" Value="@Fmt.Ratio(m.CompressionRatio)" Detail="@($"{Fmt.Bytes(m.NewDataBytes)} → {Fmt.Bytes(m.StoredBytes)}")" Icon="@Icons.Material.Filled.Compress" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><StatTile Title="Bottleneck" Value="@(m.Bottleneck ?? "–")" Detail="@($"source {Fmt.Percent(m.SourceLoad)} · processing {Fmt.Percent(m.ProcessingLoad)} · target {Fmt.Percent(m.TargetLoad)}")" Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" /></MudItem>
    </MudGrid>

    @if (m.ProcessedBytes > 0)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Processed data</MudText>
            <div class="data-bar">
                @foreach (var (label, bytes, css) in Breakdown(m))
                {
                    if (bytes > 0)
                    {
                        <div class="@css" style="@($"width:{bytes * 100.0 / m.ProcessedBytes:0.##}%".Replace(',', '.'))" title="@($"{label}: {Fmt.Bytes(bytes)}")"></div>
                    }
                }
            </div>
            <div class="d-flex flex-wrap gap-4 mt-1">
                @foreach (var (label, bytes, css) in Breakdown(m))
                {
                    <MudText Typo="Typo.caption"><span class="@($"legend {css}")"></span>@label @Fmt.Bytes(bytes)</MudText>
                }
            </div>
        </MudPaper>
    }
    }

    @if (_tasks.Values.Any(t => t.Metrics?.Disks is { Count: > 0 }))
    {
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.h6" Class="section-title mb-2">Disks</MudText>
        <div class="cq">
        <MudSimpleTable Dense="true" Elevation="0">
            <thead>
                <tr>
                    <th>Object</th><th>Disk</th><th class="c-560">State</th><th class="c-760">Mode</th><th class="c-950">Transport</th><th class="num">Processed</th><th class="c-760 num">Read</th>
                    <th class="c-560 num">New → stored</th><th class="c-1100 num">Dedupe</th><th class="c-1100 num">Compression</th><th class="c-950 num">Rate</th><th class="c-1100 num">Duration</th><th class="c-1100">Bottleneck</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tasks.Values.OrderBy(t => t.ObjectName))
                {
                    @foreach (var d in t.Metrics?.Disks ?? [])
                    {
                        var dm = d.Metrics;
                        <tr>
                            <td>@t.ObjectName</td>
                            <td>@d.Name <span class="cell-sub">@Fmt.Bytes(d.CapacityBytes)</span></td>
                            <td class="c-560">@d.State</td>
                            <td class="c-760" title="@d.FullReason">@(d.Mode ?? "–")@(d.Mode == "Full" && d.FullReason is not null ? " *" : "")</td>
                            <td class="c-950">@(d.Transport ?? "–")</td>
                            <td class="num">@Fmt.Bytes(dm.ProcessedBytes)</td>
                            <td class="c-760 num">@Fmt.Bytes(dm.ReadBytes)</td>
                            <td class="c-560 num">@Fmt.Bytes(dm.NewDataBytes) → @Fmt.Bytes(dm.StoredBytes)</td>
                            <td class="c-1100 num">@Fmt.Ratio(dm.DedupeRatio)</td>
                            <td class="c-1100 num">@Fmt.Ratio(dm.CompressionRatio)</td>
                            <td class="c-950 num">@Fmt.Rate(dm.ProcessingRate)</td>
                            <td class="c-1100 num">@(dm.Seconds > 0 ? Fmt.Seconds(dm.Seconds) : "–")</td>
                            <td class="c-1100 nowrap">@(dm.Bottleneck is { } b ? $"{b} ({Fmt.Percent(Math.Max(dm.SourceLoad, Math.Max(dm.ProcessingLoad, dm.TargetLoad)))})" : "–")</td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">* Full read; hover for the reason. Rates refer to the transfer time of the disk.</MudText>
    </MudPaper>
    }

    <MudGrid>
        @if (_session.Kind != "TapeMaintenance")
        {
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="section-title mb-2">@(_session.Kind == "SqlBackup" ? "VMs" : "Objects")</MudText>
                @if (_session.Kind == "SqlBackup")
                {
                    @foreach (var t in _tasks.Values.OrderBy(t => t.ObjectName))
                    {
                        var vm = _day?.Vms.FirstOrDefault(v => v.VmNativeId == t.ObjectNativeId);
                        <div class="d-flex align-center">
                            <MudText Typo="Typo.body1">@t.ObjectName</MudText>
                            <MudSpacer />
                            <StateChip State="@t.State" />
                        </div>
                        var message = t.Error ?? (_day?.Current == true && vm?.LastResult is "Warning" or "Failed" ? vm?.LastMessage : null);
                        @if (vm is not null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                @vm.LogBackups log · @vm.FullBackups full · @Fmt.Bytes(vm.Bytes)@(_day!.Current ? $" · last run {Fmt.Time(vm.LastRunUtc)} · next {Fmt.Time(vm.NextLogUtc)}" : "")
                            </MudText>
                        }
                        @if (message is not null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block" Color="@(t.State == "Failed" || vm?.LastResult == "Failed" ? Color.Error : Color.Warning)">@message</MudText>
                        }
                        <div class="mb-3"></div>
                    }
                }
                else
                {
                    @foreach (var t in _tasks.Values.OrderBy(t => t.ObjectName))
                    {
                        var tm = t.Metrics;
                        <div class="d-flex align-center">
                            <MudText Typo="Typo.body1">@t.ObjectName</MudText>
                            <MudSpacer />
                            <StateChip State="@t.State" />
                        </div>
                        <MudProgressLinear Value="@t.Progress" Color="@Fmt.StateColor(t.State)" />
                        @if (_session.Kind == "RepositoryMove")
                        {
                            <MudText Typo="Typo.caption" Class="d-block mb-3">
                                @Fmt.Bytes(t.ReadBytes) copied · @Fmt.Duration(t.StartedUtc, t.EndedUtc)
                                @if (t.Error is not null) { <span style="color:#c62828"> · @t.Error</span> }
                            </MudText>
                            continue;
                        }
                        <MudText Typo="Typo.caption" Class="d-block mb-3">
                            @Fmt.Bytes(t.ReadBytes) read · @Fmt.Bytes(t.TransferredBytes) transferred · @Fmt.Rate(tm?.ProcessingRate)
                            @if (t.State == "Running" && tm is not null) { <span> (now @Fmt.Rate(tm.CurrentBytesPerSecond))</span> }
                            · dedupe @Fmt.Ratio(tm?.DedupeRatio) · compression @Fmt.Ratio(tm?.CompressionRatio) · @Fmt.Duration(t.StartedUtc, t.EndedUtc)
                            @if (t.Error is not null) { <span style="color:#c62828"> · @t.Error</span> }
                        </MudText>
                    }
                }
            </MudPaper>
        </MudItem>
        }
        <MudItem xs="12" md="@(_session.Kind == "TapeMaintenance" ? 12 : 7)">
            <MudPaper Class="pa-3" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6">Log</MudText>
                    <MudSpacer />
                    @if (_session.Kind == "SqlBackup" && _log.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _allLines = !_allLines">
                            @(_allLines ? "Warnings and last run only" : $"Show all {_log.Count} lines")
                        </MudButton>
                    }
                </div>
                <div class="session-log">
                    @foreach (var entry in VisibleLog())
                    {
                        <div class="@entry.Severity">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss") @entry.Message</div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SessionSummaryDto? _session;
    private SqlExportFileDto? _exportFile;
    private SqlBackupDayDto? _day;
    private readonly HashSet<DateTimeOffset> _openRuns = [];
    private readonly Dictionary<Guid, List<SqlBackupRunLineDto>> _runLines = [];
    private int _runsShown = 12;
    private bool _allLines;

    /// <summary>A day session's log: its warnings and the last run, unless all lines are asked for.</summary>
    private IEnumerable<LogEntryDto> VisibleLog()
    {
        var all = _log.Values.OrderBy(e => e.Id);
        if (_session?.Kind != "SqlBackup" || _allLines || _day?.Runs is not { Count: > 0 } runs)
        {
            return all;
        }

        var last = runs[0].StartedUtc.AddSeconds(-1);
        return all.Where(e => e.Severity != "Info" || e.TimestampUtc >= last);
    }

    private async Task ToggleRunAsync(SqlBackupRunDto run)
    {
        if (!_openRuns.Remove(run.StartedUtc))
        {
            _openRuns.Add(run.StartedUtc);
            foreach (var vm in run.Vms.Where(v => !_runLines.ContainsKey(v.Id)))
            {
                try
                {
                    _runLines[vm.Id] = await Api.GetAsync<List<SqlBackupRunLineDto>>($"api/sql/backup-runs/{vm.Id}/lines");
                }
                catch (ApiException ex)
                {
                    _runLines[vm.Id] = [new SqlBackupRunLineDto("Error", ex.Message)];
                }
            }
        }
    }

    private static IEnumerable<(string Label, long Bytes, string Css)> Breakdown(TransferMetricsDto m) =>
    [
        ("Unchanged", m.UnchangedBytes, "seg-unchanged"),
        ("Empty", m.ZeroBytes, "seg-zero"),
        ("Already stored", m.DedupedBytes, "seg-dedupe"),
        ("New", m.NewDataBytes, "seg-new"),
    ];
    private readonly Dictionary<Guid, SessionTaskDto> _tasks = [];
    private readonly SortedDictionary<long, LogEntryDto> _log = [];

    protected override async Task OnInitializedAsync()
    {
        Live.SessionUpdated += OnSession;
        Live.TaskUpdated += OnTask;
        Live.LogEntryUpserted += OnLog;
        try
        {
            await Live.JoinSessionAsync(Id);
        }
        catch (Exception)
        {
            // Without live updates the page shows the state at load time.
        }

        var detail = await Api.GetAsync<SessionDetailDto>($"api/sessions/{Id}");
        _session = detail.Session;
        foreach (var t in detail.Tasks)
        {
            _tasks[t.Id] = t;
        }

        foreach (var e in await Api.GetAsync<List<LogEntryDto>>($"api/sessions/{Id}/log"))
        {
            _log[e.Id] = e;
        }

        await LoadExportFileAsync();
        await LoadDayAsync();
    }

    /// <summary>What the runs of a "SQL Server backups" day session backed up, per VM, and the databases of its VMs.</summary>
    private async Task LoadDayAsync()
    {
        if (_session?.Kind != "SqlBackup")
        {
            return;
        }

        try
        {
            _day = await Api.GetAsync<SqlBackupDayDto>($"api/sql/backup-days/{Id}");
        }
        catch (ApiException)
        {
            // The tiles stay away; the summary, the tasks and the log still say what happened.
        }
    }

    private string LastRun() =>
        _session is { State: "Running" } ? "running now" : _session?.EndedUtc?.ToLocalTime().ToString("t", System.Globalization.CultureInfo.CurrentCulture) ?? "–";

    /// <summary>How old the oldest last log backup of the databases with a log chain is, against twice the interval.</summary>
    private static (string Value, string Detail, Color Color) Rpo(SqlBackupDayDto day)
    {
        var oldest = day.Databases
            .Where(d => d.ChainState != "Simple" && d.RecoveryModel is not "SIMPLE" && d.LastLogUtc is not null)
            .MinBy(d => d.LastLogUtc);
        if (oldest is null)
        {
            return ("–", "no database with log backups yet", Color.Default);
        }

        var age = DateTimeOffset.UtcNow - oldest.LastLogUtc!.Value;
        var late = age > TimeSpan.FromMinutes(2 * day.LogIntervalMinutes);
        return (Fmt.Span(age), $"oldest last log backup: {oldest.Name} on {oldest.VmName}{(late ? $", over 2 × {day.LogIntervalMinutes} min" : string.Empty)}",
            late ? Color.Warning : Color.Success);
    }

    /// <summary>The .bak of a finished export, if it was sent to the backup server and is not older than 24 hours.</summary>
    private async Task LoadExportFileAsync()
    {
        if (_session is not { Kind: "SqlExport", State: "Succeeded" or "Warning" })
        {
            return;
        }

        try
        {
            _exportFile = await Api.GetAsync<SqlExportFileDto>($"api/sql/exports/{Id}");
        }
        catch (ApiException)
        {
            _exportFile = null;
        }
    }

    private async Task DownloadExportAsync()
    {
        try
        {
            var ticket = await Api.PostAsync<FileDownloadTicketDto>($"api/sql/exports/{Id}/link", new { });
            await JS.InvokeVoidAsync("bdfuDownload", ticket.Url);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private void OnSession(SessionSummaryDto s)
    {
        if (s.Id == Id)
        {
            _session = s;
            _ = InvokeAsync(async () =>
            {
                await LoadExportFileAsync();
                await LoadDayAsync();
                StateHasChanged();
            });
        }
    }

    private void OnTask(SessionTaskDto t)
    {
        if (t.SessionId == Id)
        {
            _tasks[t.Id] = t;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void OnLog(LogEntryDto e)
    {
        if (e.SessionId == Id)
        {
            _log[e.Id] = e;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await Api.PostAsync($"api/sessions/{Id}/stop");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.SessionUpdated -= OnSession;
        Live.TaskUpdated -= OnTask;
        Live.LogEntryUpserted -= OnLog;
        try
        {
            await Live.LeaveSessionAsync(Id);
        }
        catch (Exception)
        {
        }
    }
}
