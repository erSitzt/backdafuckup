@page "/inventory"
@inject ApiClient Api

<PageTitle>Inventory – backdafuckup</PageTitle>
<PageHeader Title="Inventory" Description="The VMs, hosts, storage and networks of the pools and vCenters, as they report them." />

@if (_pools is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @foreach (var (pool, items) in _pools)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@pool.DisplayName</MudText>
            <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-2">
                <MudTabPanel Text="@($"VMs ({items.Count(i => i.Kind == "Vm")})")">
                    <MudTable Items="@items.Where(i => i.Kind == "Vm")" Dense="true" Hover="true" Elevation="0" Filter="@(new Func<InventoryItemDto, bool>(Matches))">
                        <ToolBarContent>
                            <MudTextField @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
                        </ToolBarContent>
                        <HeaderContent><MudTh>Name</MudTh><MudTh>Power</MudTh><MudTh>vCPU</MudTh><MudTh>Memory</MudTh><MudTh>Disks</MudTh><MudTh>CBT</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.Properties.GetValueOrDefault("powerState")</MudTd>
                            <MudTd>@context.Properties.GetValueOrDefault("vcpus")</MudTd>
                            <MudTd>@Fmt.Bytes(Long(context, "memoryBytes"))</MudTd>
                            <MudTd>@context.Properties.GetValueOrDefault("diskCount") (@Fmt.Bytes(Long(context, "diskBytes")))</MudTd>
                            <MudTd>@(context.Properties.GetValueOrDefault("cbtEnabled") == "True" ? "on" : "off")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
                <MudTabPanel Text="Storage">
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Name</th><th>Type</th><th>Shared</th><th>Used</th><th>Size</th></tr></thead>
                        <tbody>
                            @foreach (var sr in items.Where(i => i.Kind == "Storage"))
                            {
                                <tr><td>@sr.Name</td><td>@sr.Properties.GetValueOrDefault("type")</td><td>@sr.Properties.GetValueOrDefault("shared")</td><td>@Fmt.Bytes(Long(sr, "physicalUtilisation"))</td><td>@Fmt.Bytes(Long(sr, "physicalSize"))</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
                <MudTabPanel Text="Networks">
                    @if (pool.Kind == "VSphere")
                    {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Name</th><th>Type</th><th>Id</th></tr></thead>
                        <tbody>
                            @foreach (var net in items.Where(i => i.Kind == "Network"))
                            {
                                <tr><td>@net.Name</td><td>@(net.Properties.GetValueOrDefault("type") switch { "DistributedVirtualPortgroup" => "distributed port group", "OpaqueNetwork" => "NSX network", _ => "standard network" })</td><td class="mono">@net.NativeId</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    }
                    else
                    {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Name</th><th>Bridge</th><th>MTU</th><th>NBD</th><th>UUID</th></tr></thead>
                        <tbody>
                            @foreach (var net in items.Where(i => i.Kind == "Network"))
                            {
                                var nbd = net.Properties.GetValueOrDefault("nbd");
                                <tr>
                                    <td>@net.Name</td><td>@net.Properties.GetValueOrDefault("bridge")</td><td>@net.Properties.GetValueOrDefault("mtu")</td>
                                    <td><MudChip T="string" Size="Size.Small" Color="@(nbd == "tls" ? Color.Success : nbd == "insecure" ? Color.Warning : Color.Default)">@nbd</MudChip></td>
                                    <td class="mono">@net.NativeId</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    }
                </MudTabPanel>
                <MudTabPanel Text="Hosts">
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Name</th><th>Address</th>@if (pool.Kind == "VSphere")
                            {
                                <th>Cluster</th><th>Version</th><th>State</th>
                            }</tr></thead>
                        <tbody>
                            @foreach (var host in items.Where(i => i.Kind == "Host"))
                            {
                                <tr>
                                    <td>@host.Name</td><td>@host.Properties.GetValueOrDefault("address")</td>
                                    @if (pool.Kind == "VSphere")
                                    {
                                        <td>@host.Properties.GetValueOrDefault("cluster")</td><td>@host.Properties.GetValueOrDefault("version")</td>
                                        <td>@(host.Properties.GetValueOrDefault("maintenance") == "true" ? "maintenance" : host.Properties.GetValueOrDefault("connectionState"))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
    @if (_pools.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Add a pool or vCenter under Backup Infrastructure → Virtualization first.</MudAlert>
    }
}

@code {
    private List<(ConnectionDto Pool, List<InventoryItemDto> Items)>? _pools;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var pools = await Api.GetAsync<List<ConnectionDto>>("api/connections?kind=XenServer,VSphere");
        var result = new List<(ConnectionDto, List<InventoryItemDto>)>();
        foreach (var pool in pools)
        {
            result.Add((pool, await Api.GetAsync<List<InventoryItemDto>>($"api/connections/{pool.Id}/inventory")));
        }

        _pools = result;
    }

    private bool Matches(InventoryItemDto item) => string.IsNullOrWhiteSpace(_search) || item.Name.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private static long? Long(InventoryItemDto item, string key) => long.TryParse(item.Properties.GetValueOrDefault(key), out var v) ? v : null;
}
