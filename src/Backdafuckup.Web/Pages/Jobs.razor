@page "/jobs"
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject LiveConnection Live

<PageTitle>Backup jobs – backdafuckup</PageTitle>
<PageHeader Title="Backup Jobs" Description="What is backed up, where to and when. Run a job now, or pause it.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/jobs/new">New job</MudButton></Actions>
</PageHeader>

@if (_jobs is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="cq">
    <MudTable Items="_jobs" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Name</MudTh><MudTh Class="c-760 num">VMs</MudTh><MudTh Class="c-950">Repository</MudTh><MudTh Class="c-560">Schedule</MudTh><MudTh>Last result</MudTh><MudTh Class="c-760">Last run</MudTh><MudTh Class="c-560">Next run</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink Href="@($"/jobs/{context.Id}")">@context.Name</MudLink>
                @if (!context.Enabled) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.PauseCircle">disabled</MudChip> }
                <span class="cell-sub n-560">@Describe(context.Schedule) · next @Fmt.Time(context.NextRunUtc)</span>
            </MudTd>
            <MudTd Class="c-760 num">@context.Objects.Count</MudTd>
            <MudTd Class="c-950">@context.RepositoryName</MudTd>
            <MudTd Class="c-560 nowrap">@Describe(context.Schedule)</MudTd>
            <MudTd>
                @if (context.IsRunning)
                {
                    <StateChip State="Running" />
                }
                else if (context.LastResult is not null)
                {
                    <StateChip State="@context.LastResult" />
                }
            </MudTd>
            <MudTd Class="c-760 nowrap">@Fmt.Time(context.LastRunUtc)</MudTd>
            <MudTd Class="c-560 nowrap">@Fmt.Time(context.NextRunUtc)</MudTd>
            <MudTd Style="white-space:nowrap">
                <div class="d-flex align-center justify-end">
                @if (context.IsRunning)
                {
                    <MudTooltip Text="Open running session"><MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenRunningAsync(context))" /></MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Run now (incremental)"><MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" OnClick="@(() => RunAsync(context, false))" aria-label="@($"Run {context.Name} now")" /></MudTooltip>
                }
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" aria-label="@($"Actions for {context.Name}")">
                    <MudMenuItem Icon="@Icons.Material.Filled.FastForward" Disabled="context.IsRunning" OnClick="@(() => RunAsync(context, true))">Run an active full</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"/jobs/{context.Id}")">Edit</MudMenuItem>
                    <MudMenuItem Icon="@(context.Enabled ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)" OnClick="@(() => ToggleAsync(context))">@(context.Enabled ? "Disable" : "Enable")</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="context.IsRunning" OnClick="@(() => DeleteAsync(context))">Delete</MudMenuItem>
                </MudMenu>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No backup job yet.</MudText></NoRecordsContent>
    </MudTable>
    </div>
}

@code {
    private List<JobDto>? _jobs;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Live.SessionUpdated += OnSessionUpdated;
        try
        {
            await Live.EnsureStartedAsync();
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadAsync() => _jobs = await Api.GetAsync<List<JobDto>>("api/jobs");

    private void OnSessionUpdated(SessionSummaryDto session)
    {
        if (session.JobId is not null && (session.State is not "Running" || _jobs?.Any(j => j.Id == session.JobId && !j.IsRunning) == true))
        {
            _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
    }

    public static string Describe(ScheduleDto schedule) => schedule.Kind switch
    {
        "Daily" => $"Daily at {schedule.TimeOfDay}",
        "Weekly" => $"{string.Join(", ", schedule.Days.Select(d => d.ToString()[..3]))} at {schedule.TimeOfDay}",
        _ => "Not scheduled",
    };

    private async Task RunAsync(JobDto job, bool activeFull)
    {
        try
        {
            var started = await Api.PostAsync<StartedDto>($"api/jobs/{job.Id}/run", new RunJobDto(activeFull));
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenRunningAsync(JobDto job)
    {
        var sessions = await Api.GetAsync<List<SessionSummaryDto>>($"api/sessions?jobId={job.Id}&limit=1");
        if (sessions.Count > 0)
        {
            Navigation.NavigateTo($"/sessions/{sessions[0].Id}");
        }
    }

    private async Task ToggleAsync(JobDto job)
    {
        await Api.PostAsync($"api/jobs/{job.Id}/enabled/{(!job.Enabled).ToString().ToLowerInvariant()}");
        await LoadAsync();
    }

    private async Task DeleteAsync(JobDto job)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete job", $"Delete {job.Name}? Its restore points stay available for restores.", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/jobs/{job.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public void Dispose() => Live.SessionUpdated -= OnSessionUpdated;
}
