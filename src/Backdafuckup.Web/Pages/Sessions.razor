@page "/sessions"
@implements IDisposable
@inject ApiClient Api
@inject LiveConnection Live

<PageTitle>History – backdafuckup</PageTitle>
<PageHeader Title="History" Description="Every backup, restore and maintenance session, newest first. Open one for its details and log.">
    <Actions>
    <MudTextField @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:220px" />
    <MudSelect T="string" @bind-Value="_state" Label="State" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:170px">
        <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
        <MudSelectItem T="string" Value="@("problems")">Failed or warning</MudSelectItem>
        <MudSelectItem T="string" Value="@("Failed")">Failed</MudSelectItem>
        <MudSelectItem T="string" Value="@("Running")">Running</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Value="_kind" ValueChanged="OnKindChangedAsync" Label="Type" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:220px">
        <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
        <MudSelectItem T="string" Value="@("Backup")">Backup</MudSelectItem>
        <MudSelectItem T="string" Value="@("Restore")">Restore</MudSelectItem>
        <MudSelectItem T="string" Value="@("FileRestore")">File restore</MudSelectItem>
        <MudSelectItem T="string" Value="@("SqlRestore")">SQL restore</MudSelectItem>
        <MudSelectItem T="string" Value="@("InstantRecovery")">Instant recovery</MudSelectItem>
        <MudSelectItem T="string" Value="@("SqlPublish")">SQL publish</MudSelectItem>
        <MudSelectItem T="string" Value="@("SqlExport")">SQL export</MudSelectItem>
        <MudSelectItem T="string" Value="@("SqlBackup")">SQL Server backups</MudSelectItem>
        <MudSelectItem T="string" Value="@("AdExplore")">AD explore</MudSelectItem>
        <MudSelectItem T="string" Value="@("AdRestore")">AD restore</MudSelectItem>
        <MudSelectItem T="string" Value="@("RepositoryMaintenance")">Maintenance</MudSelectItem>
        <MudSelectItem T="string" Value="@("RepositoryMove")">Move between extents</MudSelectItem>
        <MudSelectItem T="string" Value="@("TapeBackup")">Backup to tape</MudSelectItem>
        <MudSelectItem T="string" Value="@("TapeRestore")">Restore from tape</MudSelectItem>
        <MudSelectItem T="string" Value="@("TapeMaintenance")">Tape library</MudSelectItem>
    </MudSelect>
    </Actions>
</PageHeader>

@if (_sessions is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    var matching = _sessions.Where(Matches).ToList();
    <MudPaper Elevation="1" Class="pa-2"><SessionTable Sessions="@matching.Take(_shown).ToList()" /></MudPaper>
    <div class="d-flex align-center gap-3 mt-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @(matching.Count <= _shown ? $"{matching.Count} session(s)" : $"{_shown} of {matching.Count} sessions")@(_sessions.Count >= _limit ? $" (the newest {_limit})" : null)
        </MudText>
        @if (matching.Count > _shown)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _shown += PageSize)">Show @Math.Min(PageSize, matching.Count - _shown) more</MudButton>
        }
        else if (_sessions.Count >= _limit)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="LoadOlderAsync">Load older sessions</MudButton>
        }
    </div>
}

@code {
    private const int PageSize = 50;
    private List<SessionSummaryDto>? _sessions;
    private string _kind = string.Empty;
    private string _state = string.Empty;
    private string _search = string.Empty;
    private int _shown = PageSize;
    private int _limit = 200;

    private bool Matches(SessionSummaryDto session) =>
        (_state switch
        {
            "problems" => session.State is "Failed" or "Warning",
            "" => true,
            var state => session.State == state,
        })
        && (string.IsNullOrWhiteSpace(_search) || session.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private async Task LoadOlderAsync()
    {
        _limit += 200;
        _shown += PageSize;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Live.SessionUpdated += OnSessionUpdated;
        try
        {
            await Live.EnsureStartedAsync();
        }
        catch (Exception)
        {
        }
    }

    private async Task OnKindChangedAsync(string kind)
    {
        _kind = kind;
        _shown = PageSize;
        await LoadAsync();
    }

    private async Task LoadAsync() => _sessions = await Api.GetAsync<List<SessionSummaryDto>>($"api/sessions?limit={_limit}&kind={_kind}");

    private void OnSessionUpdated(SessionSummaryDto session) => _ = InvokeAsync(() =>
    {
        if (_sessions is null)
        {
            return;
        }

        var index = _sessions.FindIndex(s => s.Id == session.Id);
        if (index >= 0 && session.Kind == "SqlBackup" && session.State == "Running")
        {
            // A run of the day reopens its SQL Server backup session: it moves to the top.
            _sessions.RemoveAt(index);
            _sessions.Insert(0, session);
        }
        else if (index >= 0)
        {
            _sessions[index] = session;
        }
        else if (string.IsNullOrEmpty(_kind) || _kind == session.Kind)
        {
            _sessions.Insert(0, session);
        }

        StateHasChanged();
    });

    public void Dispose() => Live.SessionUpdated -= OnSessionUpdated;
}
