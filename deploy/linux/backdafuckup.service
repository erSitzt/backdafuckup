# systemd unit for the backdafuckup backup server.
# Install: copy the published files to /opt/backdafuckup, create the user (useradd --system --home /var/lib/backdafuckup backdafuckup),
# put the configuration into /etc/backdafuckup/appsettings.json, then: systemctl enable --now backdafuckup
[Unit]
Description=backdafuckup backup server
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=notify
User=backdafuckup
Group=backdafuckup
WorkingDirectory=/opt/backdafuckup
ExecStart=/opt/backdafuckup/backdafuckup
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=300
StateDirectory=backdafuckup
LogsDirectory=backdafuckup
ConfigurationDirectory=backdafuckup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Add every repository mount point here, e.g. /mnt/backup
ReadWritePaths=/var/lib/backdafuckup /var/log/backdafuckup /mnt/backup

[Install]
WantedBy=multi-user.target
