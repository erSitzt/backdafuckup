            Snackbar.Add($"Key {key.Name} created: fingerprint {key.Fingerprint}. Download its key file now and keep it apart from the tapes.", Severity.Success);
            _keyName = _passphrase = _passphrase2 = string.Empty;
        });
    }

    private async Task DownloadKeyAsync(TapeKeyDto key)
    {
        var response = await Api.PostRawAsync($"api/tape/keys/{key.Id}/file", null);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ApiClient.ReadProblemAsync(response), Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("bdfuSaveText", $"bdfu-tape-key-{key.Fingerprint}.json", await response.Content.ReadAsStringAsync(), "application/json");
        Snackbar.Add("Key file saved. It is not offered again.", Severity.Success);
        await RefreshAsync();
    }

