@page "/infrastructure/repositories"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>Repositories – backdafuckup</PageTitle>
<PageHeader Title="Backup Repositories" Description="Where the backups are stored: deduplicated and compressed, every restore point complete on its own.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _adding = true)" Disabled="_adding">Add repository</MudButton></Actions>
</PageHeader>

@if (_adding)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Add repository</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            A directory on a volume mounted on the backup server (e.g. an iSCSI LUN). If the directory already contains a
            backdafuckup repository, it is imported together with its restore points.
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="_path" Label="Path (e.g. /mnt/backup/repo1)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_chunkKiB" Label="Block size" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="1024">1 MiB (recommended)</MudSelectItem>
                    <MudSelectItem T="int" Value="4096">4 MiB (large, rarely changing disks)</MudSelectItem>
                    <MudSelectItem T="int" Value="512">512 KiB (more deduplication)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_compression" Label="Compression level (0 = off)" Min="0" Max="19" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_maxTasks" Label="Max concurrent tasks" Min="1" Max="32" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_packMiB" Label="Pack file size" Variant="Variant.Outlined" HelperText="Chunks are stored in files of this size.">
                    <MudSelectItem T="int" Value="64">64 MiB (recommended)</MudSelectItem>
                    <MudSelectItem T="int" Value="256">256 MiB (copied to tape or network storage)</MudSelectItem>
                    <MudSelectItem T="int" Value="16">16 MiB (small repositories)</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-4">
            <MudButton OnClick="@(() => _adding = false)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AddAsync">Add</MudButton>
        </div>
    </MudPaper>
}

@if (_extentFor is { } owner)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">@(owner.Kind == "ScaleOut" ? $"Add an extent to {owner.Name}" : $"Add an extent to {owner.Name}: make it a scale-out repository")</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            @if (owner.Kind == "ScaleOut")
            {
                <span>A directory on another volume. New chains go to the extent with the most room; existing chains stay where they are until they are moved.</span>
            }
            else
            {
                <span>@owner.Name becomes the first extent of a new scale-out repository; its jobs write to the scale-out from then on, and its restore points stay where they are.
                Each chain (a job's restore points of one VM) lives on one extent; new chains go where there is most room.</span>
            }
        </MudText>
        <MudGrid>
            @if (owner.Kind != "ScaleOut")
            {
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_scaleOutName" Label="Name of the scale-out repository" Variant="Variant.Outlined" /></MudItem>
            }
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_extentName" Label="Name of the new extent" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="@(owner.Kind == "ScaleOut" ? 8 : 4)"><MudTextField @bind-Value="_extentPath" Label="Path on another volume" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-4">
            <MudButton OnClick="@(() => _extentFor = null)">Cancel</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AddExtentAsync">Add extent</MudButton>
        </div>
    </MudPaper>
}

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="cq">
    <MudTable Items="@(_items.Where(r => r.ScaleOutId is null))" Hover="true" Dense="true" Elevation="1" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Name</MudTh><MudTh>State</MudTh><MudTh Class="c-560">Capacity</MudTh><MudTh Class="c-760">Restore points</MudTh><MudTh Class="c-950 num">Block size</MudTh><MudTh Class="c-950">Storage</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (context.Kind == "ScaleOut")
                {
                    <MudLink Href="@($"/infrastructure/repositories/{context.Id}")">@context.Name</MudLink><span class="cell-sub">scale-out, @context.Extents extent(s), @context.Chains chain(s)</span>
                }
                else
                {
                    @context.Name<span class="cell-sub mono">@context.Path</span>
                }
            </MudTd>
            <MudTd><StateChip State="@context.State" /></MudTd>
            <MudTd Class="c-560"><CapacityBar Repository="context" /></MudTd>
            <MudTd Class="c-760">@context.RestorePoints<span class="cell-sub">@Fmt.Bytes(context.LogicalBytes) of VM disks</span></MudTd>
            <MudTd Class="c-950 num">@Fmt.Bytes(context.ChunkSize)</MudTd>
            <MudTd Class="c-950">
                @if (context.Format == 2)
                {
                    <span>Pack files</span><span class="cell-sub">@Fmt.Bytes(context.PackSize) each@(context.PackingUnfinished ? ", packing old chunks" : "")</span>
                }
                else if (context.Format == 1)
                {
                    <span>One file per chunk</span><span class="cell-sub">convert to pack files</span>
                }
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" aria-label="@($"Actions for {context.Name}")">
                    @if (context.Kind == "ScaleOut")
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" Href="@($"/infrastructure/repositories/{context.Id}")">Open: chains, rebalance, settings</MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.AddBox" OnClick="@(() => StartExtent(context))">@(context.Kind == "ScaleOut" ? "Add extent…" : "Add extent (makes it a scale-out repository)…")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.CleaningServices" OnClick="@(() => CollectGarbageAsync(context))">Remove unreferenced data now</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Sync" OnClick="@(() => RescanAsync(context))">Import restore points missing in the catalog</MudMenuItem>
                    @if (context.Kind == "ScaleOut")
                    {
                    }
                    else if (context.Format == 1)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="@(() => ConvertAsync(context))">Convert to pack files…</MudMenuItem>
                    }
                    else if (context.PackingUnfinished)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="@(() => ConvertAsync(context))">Continue packing old chunks</MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => RemoveAsync(context))">Remove from the console (data is kept)</MudMenuItem>
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @foreach (var extent in _items.Where(e => e.ScaleOutId == context.Id))
            {
                <MudTr>
                    <MudTd><div class="pl-6">@extent.Name<span class="cell-sub mono">@extent.Path</span></div></MudTd>
                    <MudTd><ExtentStateChips Extent="extent" /></MudTd>
                    <MudTd Class="c-560"><CapacityBar Repository="extent" /></MudTd>
                    <MudTd Class="c-760">@extent.RestorePoints<span class="cell-sub">@extent.Chains chain(s)</span></MudTd>
                    <MudTd Class="c-950 num">@Fmt.Bytes(extent.ChunkSize)</MudTd>
                    <MudTd Class="c-950">@(extent.Format == 2 ? "Pack files" : extent.Format == 1 ? "One file per chunk" : "")</MudTd>
                    <MudTd Style="text-align:right; white-space:nowrap"><ExtentMenu Extent="extent" Changed="LoadAsync" /></MudTd>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent><MudText>No repository yet.</MudText></NoRecordsContent>
    </MudTable>
    </div>
}

@code {
    private List<RepositoryDto>? _items;
    private bool _adding;
    private bool _busy;
    private string _name = string.Empty;
    private string _path = string.Empty;
    private int _chunkKiB = 1024;
    private int _compression = 3;
    private int _maxTasks = 4;
    private int _packMiB = 64;
    private RepositoryDto? _extentFor;
    private string _scaleOutName = string.Empty;
    private string _extentName = string.Empty;
    private string _extentPath = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void StartExtent(RepositoryDto owner)
    {
        _extentFor = owner;
        _scaleOutName = owner.Kind == "ScaleOut" ? string.Empty : $"{owner.Name} (scale-out)";
        _extentName = string.Empty;
        _extentPath = string.Empty;
    }

    private async Task AddExtentAsync()
    {
        _busy = true;
        try
        {
            var owner = _extentFor!;
            await Api.PostAsync($"api/repositories/{owner.Id}/extents", new AddExtentDto
            {
                Name = _extentName.Trim(), Path = _extentPath.Trim(), ScaleOutName = owner.Kind == "ScaleOut" ? null : _scaleOutName.Trim(),
            });
            Snackbar.Add(owner.Kind == "ScaleOut" ? $"Extent {_extentName} added to {owner.Name}." : $"{owner.Name} is now an extent of {_scaleOutName}, with {_extentName}.", Severity.Success);
            _extentFor = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync() => _items = await Api.GetAsync<List<RepositoryDto>>("api/repositories");

    private async Task AddAsync()
    {
        _busy = true;
        try
        {
            await Api.PostAsync("api/repositories", new CreateRepositoryDto { Name = _name.Trim(), Path = _path.Trim(), ChunkSizeKiB = _chunkKiB, CompressionLevel = _compression, MaxConcurrentTasks = _maxTasks, PackSizeMiB = _packMiB });
            Snackbar.Add($"Repository {_name} added.", Severity.Success);
            _adding = false;
            _name = string.Empty;
            _path = string.Empty;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CollectGarbageAsync(RepositoryDto repository)
    {
        try
        {
            var started = await Api.PostAsync<StartedDto>($"api/repositories/{repository.Id}/gc");
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConvertAsync(RepositoryDto repository)
    {
        if (repository.Format == 1 && await Dialogs.ShowMessageBoxAsync(
                "Convert to pack files",
                $"Store the chunks of {repository.Name} in pack files of 64 MiB instead of one file each? New backups use pack files at once; " +
                "the existing chunks are packed in maintenance runs of up to 4 hours, newest restore points first, while backups go on. " +
                "Older versions of backdafuckup can no longer open the repository afterwards.",
                yesText: "Convert",
                cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            var started = await Api.PostAsync<StartedDto>($"api/repositories/{repository.Id}/packs", new ConvertRepositoryDto());
            Navigation.NavigateTo($"/sessions/{started.SessionId}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RescanAsync(RepositoryDto repository)
    {
        try
        {
            await Api.PostAsync($"api/repositories/{repository.Id}/rescan");
            Snackbar.Add("Rescan finished.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(RepositoryDto repository)
    {
        if (await Dialogs.ShowMessageBoxAsync("Remove repository", $"Remove {repository.Name} from the console? The backup data on disk is kept and can be imported again.", yesText: "Remove", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/repositories/{repository.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
