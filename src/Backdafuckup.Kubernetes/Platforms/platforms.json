// What Kubernetes platforms make themselves (spec 2026-11-12-1952-kubernetes-platform-profiles).
// Ids are recorded in restore points: never rename or reuse one. Order matters: it is the display order, and the first
// profile whose rule matches an object is named as its maker. "tested": checked in the lab; others come from the public
// documentation named in "sources". Globs: "*" for any characters, anchored to the whole text.
{
  "schema": 1,
  "profiles": [
    {
      "id": "kubernetes",
      "name": "Kubernetes",
      "category": "base",
      "tested": true,
      "always": true,
      "namespaces": [ "kube-system", "kube-public", "kube-node-lease" ],
      "made": [
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "names": [ "system:*", "admin", "edit", "view", "cluster-admin" ] },
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "labels": [ "kubernetes.io/bootstrapping=rbac-defaults" ] },
        { "kinds": [ "PriorityClass" ], "names": [ "system-*" ] },
        { "labels": [ "addonmanager.kubernetes.io/mode" ] }
      ],
      "kubeletRootDir": "/var/lib/kubelet",
      "containerRuntimeRoot": "/var/lib/containerd"
    },
    {
      "id": "rke2",
      "name": "RKE2",
      "category": "distribution",
      "tested": true,
      "detect": [ { "gitVersion": "\\+rke2r[0-9]+" }, { "nodeAnnotation": "rke2.io/node-args" } ],
      "crdGroups": [ "helm.cattle.io", "k3s.cattle.io" ],
      "made": [
        { "kinds": [ "ClusterRole", "ClusterRoleBinding", "ValidatingWebhookConfiguration", "MutatingWebhookConfiguration" ], "names": [ "rke2-*" ] }
      ],
      "kubeletRootDir": "/var/lib/kubelet",
      "containerRuntimeRoot": "/var/lib/rancher/rke2/agent/containerd"
    },
    {
      "id": "k3s",
      "name": "k3s",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://docs.k3s.io/" ],
      "detect": [ { "gitVersion": "\\+k3s[0-9]+" }, { "nodeAnnotation": "k3s.io/node-args" } ],
      "crdGroups": [ "helm.cattle.io", "k3s.cattle.io" ],
      "kubeletRootDir": "/var/lib/kubelet",
      "containerRuntimeRoot": "/var/lib/rancher/k3s/agent/containerd"
    },
    {
      "id": "kind",
      "name": "kind",
      "category": "distribution",
      "tested": true,
      "detect": [ { "nodeProviderId": "kind://" } ],
      "namespaces": [ "local-path-storage" ]
    },
    {
      "id": "openshift",
      "name": "OpenShift",
      "category": "distribution",
      "tested": false,
      "sources": [
        "https://docs.redhat.com/en/documentation/openshift_container_platform/4.21/html/images/using-pull-secret_using-image-pull-secrets",
        "https://docs.redhat.com/en/documentation/openshift_container_platform/4.2/html/authentication/using-service-accounts"
      ],
      "notes": "Mover pods run as root: the backdafuckup ServiceAccount needs an SCC that allows it (for example anyuid), which the setup manifest does not create. A namespace's UID range (openshift.io/sa.scc.*) is kept in another cluster, so restored volume data keeps owners its pods can read.",
      "detect": [ { "apiGroup": "config.openshift.io" }, { "namespace": "openshift-config" } ],
      "namespaces": [ "openshift", "openshift-*" ],
      "crdGroups": [ "*.openshift.io" ],
      "made": [
        { "annotations": [ "include.release.openshift.io/*" ] },
        { "kinds": [ "RoleBinding" ], "names": [ "system:image-pullers", "system:image-builders", "system:deployers" ], "always": true },
        { "kinds": [ "ServiceAccount" ], "names": [ "builder", "deployer" ], "always": true },
        { "kinds": [ "Secret" ], "names": [ "*-dockercfg-*" ], "always": true },
        { "kinds": [ "ConfigMap" ], "names": [ "openshift-service-ca.crt" ], "always": true }
      ],
      "kubeletRootDir": "/var/lib/kubelet",
      "containerRuntimeRoot": "/var/lib/containers/storage"
    },
    {
      "id": "gke",
      "name": "GKE",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://cloud.google.com/kubernetes-engine/docs", "https://cloud.google.com/anthos-config-management/docs/how-to/policy-controller-exclude-namespaces" ],
      "notes": "GKE Autopilot does not allow hostPath or privileged pods: the optional node agent cannot run there.",
      "detect": [ { "gitVersion": "-gke\\." }, { "nodeProviderId": "gce://" }, { "nodeLabel": "cloud.google.com/gke-nodepool" } ],
      "namespaces": [ "gke-managed-*", "gke-system", "gmp-system", "gmp-public" ],
      "crdGroups": [ "*.gke.io", "monitoring.googleapis.com" ]
    },
    {
      "id": "eks",
      "name": "EKS",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://docs.aws.amazon.com/eks/latest/userguide/" ],
      "notes": "Pods on Fargate have no node to run the optional node agent on.",
      "detect": [ { "gitVersion": "-eks-" }, { "nodeLabel": "eks.amazonaws.com/nodegroup" } ],
      "namespaces": [ "amazon-cloudwatch", "amazon-guardduty" ],
      "crdGroups": [ "crd.k8s.amazonaws.com", "vpcresources.k8s.aws" ]
    },
    {
      "id": "aks",
      "name": "AKS",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://learn.microsoft.com/azure/aks/" ],
      "detect": [ { "nodeLabel": "kubernetes.azure.com/cluster" }, { "nodeProviderId": "azure://" } ],
      "namespaces": [ "gatekeeper-system", "app-routing-system" ]
    },
    {
      "id": "microk8s",
      "name": "MicroK8s",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://microk8s.io/docs", "https://canonical.com/microk8s/docs/ref-launch-config" ],
      "detect": [ { "nodeLabel": "microk8s.io/cluster=true" } ],
      "kubeletRootDir": "/var/snap/microk8s/common/var/lib/kubelet",
      "containerRuntimeRoot": "/var/snap/microk8s/common/var/lib/containerd"
    },
    {
      "id": "k0s",
      "name": "k0s",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://docs.k0sproject.io/main/directories/" ],
      "detect": [ { "gitVersion": "\\+k0s" } ],
      "kubeletRootDir": "/var/lib/k0s/kubelet",
      "containerRuntimeRoot": "/var/lib/k0s/containerd"
    },
    {
      "id": "tanzu",
      "name": "Tanzu Kubernetes Grid",
      "category": "distribution",
      "tested": false,
      "sources": [ "https://techdocs.broadcom.com/us/en/vmware-tanzu/standalone-components/tanzu-kubernetes-grid/" ],
      "detect": [ { "gitVersion": "\\+vmware\\." }, { "namespace": "tkg-system" } ],
      "namespaces": [ "tkg-system", "vmware-system-*" ],
      "crdGroups": [ "*.tanzu.vmware.com" ]
    },
    {
      "id": "rancher",
      "name": "Rancher",
      "category": "manager",
      "tested": true,
      "detect": [ { "namespace": "cattle-system" }, { "apiGroup": "management.cattle.io" } ],
      "namespaces": [ "cattle-*", "local" ],
      "crdGroups": [ "cattle.io", "*.cattle.io" ],
      "made": [
        { "groups": [ "cattle.io", "catalog.cattle.io", "cluster.cattle.io", "management.cattle.io", "project.cattle.io", "provisioning.cattle.io", "rke.cattle.io" ] },
        { "kinds": [ "Role", "RoleBinding" ], "labels": [ "authz.cluster.cattle.io/*", "cattle.io/creator=norman" ] },
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "names": [ "cattle-*", "rancher-*", "cluster-owner*", "project-owner*" ] },
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "labels": [ "*cattle.io*" ] },
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "annotations": [ "*cattle.io*" ] },
        { "kinds": [ "ValidatingWebhookConfiguration", "MutatingWebhookConfiguration" ], "names": [ "rancher.cattle.io*" ] }
      ],
      "strip": [ "field.cattle.io/*", "lifecycle.cattle.io/*", "cattle.io/*", "authz.management.cattle.io/*", "management.cattle.io/*" ]
    },
    {
      "id": "fleet",
      "name": "Fleet",
      "category": "manager",
      "tested": true,
      "detect": [ { "namespace": "cattle-fleet-system" }, { "apiGroup": "fleet.cattle.io" } ],
      "namespaces": [ "fleet-*", "cluster-fleet-*", "cattle-fleet-*" ],
      "crdGroups": [ "fleet.cattle.io" ],
      "made": [
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "names": [ "fleet-*" ] }
      ]
    },
    {
      "id": "calico",
      "name": "Calico / Canal",
      "category": "addon",
      "tested": true,
      "detect": [ { "apiGroup": "crd.projectcalico.org" }, { "apiGroup": "operator.tigera.io" } ],
      "namespaces": [ "calico-system", "calico-apiserver", "tigera-operator" ],
      "crdGroups": [ "crd.projectcalico.org", "projectcalico.org", "operator.tigera.io" ],
      "made": [
        { "kinds": [ "ClusterRole", "ClusterRoleBinding" ], "names": [ "calico-*", "tigera-*" ] }
      ]
    },
    {
      "id": "cilium",
      "name": "Cilium",
      "category": "addon",
      "tested": false,
      "sources": [ "https://docs.cilium.io/" ],
      "detect": [ { "apiGroup": "cilium.io" } ],
      "namespaces": [ "cilium-secrets" ],
      "crdGroups": [ "cilium.io" ],
      "made": [
        { "kinds": [ "CiliumEndpoint", "CiliumEndpointSlice" ], "always": true }
      ]
    },
    {
      "id": "vsphere-csi",
      "name": "vSphere CSI",
      "category": "addon",
      "tested": true,
      "detect": [ { "csiDriver": "csi.vsphere.vmware.com" }, { "apiGroup": "cns.vmware.com" } ],
      "namespaces": [ "vmware-system-csi" ],
      "crdGroups": [ "cns.vmware.com" ]
    },
    {
      "id": "istio",
      "name": "Istio",
      "category": "addon",
      "tested": true,
      "detect": [ { "apiGroup": "networking.istio.io" } ],
      "made": [
        { "kinds": [ "ConfigMap" ], "names": [ "istio-ca-root-cert" ], "always": true }
      ],
      "podVolumes": [ "istio-envoy", "istio-data", "istio-podinfo", "istio-token", "istiod-ca-cert", "workload-socket", "credential-socket", "workload-certs" ]
    },
    {
      "id": "antrea",
      "name": "Antrea",
      "category": "addon",
      "tested": false,
      "sources": [ "https://antrea.io/docs/" ],
      "detect": [ { "apiGroup": "crd.antrea.io" } ],
      "crdGroups": [ "*.antrea.io" ]
    },
    {
      "id": "longhorn",
      "name": "Longhorn",
      "category": "addon",
      "tested": false,
      "sources": [ "https://longhorn.io/docs/" ],
      "notes": "Longhorn's own records (volumes, replicas, engines) stay out; its volumes are backed up through CSI snapshots when a VolumeSnapshotClass exists for driver.longhorn.io.",
      "detect": [ { "csiDriver": "driver.longhorn.io" }, { "apiGroup": "longhorn.io" } ],
      "namespaces": [ "longhorn-system" ],
      "crdGroups": [ "longhorn.io" ]
    }
  ]
}
