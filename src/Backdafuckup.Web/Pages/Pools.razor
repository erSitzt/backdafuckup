@page "/infrastructure/pools"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Virtualization – backdafuckup</PageTitle>
<PageHeader Title="Virtualization" Description="The XCP-ng / XenServer pools and VMware vCenters whose VMs are backed up.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _adding = true)" Disabled="_adding">Add pool or vCenter</MudButton></Actions>
</PageHeader>

@if (_adding)
{
    <AddPoolWizard OnDone="OnPoolAddedAsync" OnCancel="@(() => _adding = false)" />
}

@if (_pools is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_pools.Count == 0 && !_adding)
{
    <MudAlert Severity="Severity.Info">No XCP-ng / XenServer pool or VMware vCenter has been added yet.</MudAlert>
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var pool in _pools)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@AppIcons.Pool" />
                        <MudText Typo="Typo.h6">@pool.DisplayName</MudText>
                        <StateChip State="@pool.Status" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@pool.ProductName @pool.ProductVersion · @(IsVcenter(pool) ? "vCenter" : "master") @pool.MasterAddress</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (pool.LastError is not null && pool.Status == "Error")
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@pool.LastError</MudAlert>
                    }
                    <MudText Typo="Typo.subtitle2">@(IsVcenter(pool) ? "Trusted certificates: the vCenter and its ESXi hosts as vCenter reports them (public key SHA-256)" : "Trusted host certificates (public key SHA-256)")</MudText>
                    <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                        <tbody>
                            @foreach (var host in pool.Hosts)
                            {
                                <tr><td>@host.Address</td><td class="mono">@host.SpkiSha256</td><td>@Fmt.Time(host.TrustedUtc)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (IsVcenter(pool))
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Backups and restores read and write disks through a backup proxy VM in this vCenter (HotAdd; see <MudLink Href="/infrastructure/proxies">Backup Proxies</MudLink>),
                            with changed block tracking for incremental backups. ESXi host certificates are only used to copy the agent into guests through VMware Tools.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Backups read disks over NBD. A pool network needs the NBD purpose, e.g.
                            <span class="mono">xe network-param-add param-name=purpose param-key=nbd uuid=&lt;network-uuid&gt;</span>
                            (see Inventory for the NBD state of each network).
                        </MudText>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@(() => RescanAsync(pool))" Class="mr-2">Rescan</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => RemoveAsync(pool))">Remove</MudButton>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private List<ConnectionDto>? _pools;
    private bool _adding;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static bool IsVcenter(ConnectionDto connection) => connection.Kind == "VSphere";

    private async Task LoadAsync() => _pools = await Api.GetAsync<List<ConnectionDto>>("api/connections?kind=XenServer,VSphere");

    private async Task OnPoolAddedAsync()
    {
        _adding = false;
        await LoadAsync();
    }

    private async Task RescanAsync(ConnectionDto pool)
    {
        try
        {
            await Api.PostAsync($"api/connections/{pool.Id}/rescan");
            Snackbar.Add($"{pool.DisplayName} rescanned.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(ConnectionDto pool)
    {
        if (await Dialogs.ShowMessageBoxAsync(IsVcenter(pool) ? "Remove vCenter" : "Remove pool", $"Remove {pool.DisplayName}? Restore points are kept.", yesText: "Remove", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/connections/{pool.Id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
