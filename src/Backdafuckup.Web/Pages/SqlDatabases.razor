@page "/sql/databases"
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>SQL Server – backdafuckup</PageTitle>
<PageHeader Title="SQL Server databases"
            Description="The databases of the backed-up SQL Server instances: what their log chain covers and whether it is intact. Open one to restore it to any second of that time. Jobs back up the logs when their SQL Server backups are turned on (job settings).">
    <Actions>
        <MudTextField T="string" @bind-Value="_filter" Placeholder="Filter (VM, instance, database)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:300px" />
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}
else if (_databases is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_databases.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No SQL Server databases in the catalog yet. They appear with the first image backup with the SQL Server snapshot or the first
        SQL Server backup run of a job.
    </MudAlert>
}
else
{
    <div class="cq">
    <MudTable Items="Filtered()" Dense="true" Hover="true" Elevation="1" Breakpoint="Breakpoint.None" OnRowClick="@((TableRowClickEventArgs<SqlCatalogDatabaseDto> e) => Navigation.NavigateTo($"/sql/databases/{e.Item!.Id}"))"
              RowStyle="cursor:pointer">
        <HeaderContent>
            <MudTh Class="c-560">VM</MudTh>
            <MudTh Class="c-760">Instance</MudTh>
            <MudTh>Database</MudTh>
            <MudTh Class="c-950">Recovery</MudTh>
            <MudTh>Log chain</MudTh>
            <MudTh Class="c-560">Last log backup</MudTh>
            <MudTh Class="c-1100">Last full backup</MudTh>
            <MudTh Class="c-950">Restorable</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="VM" Class="c-560 nowrap">@context.VmName</MudTd>
            <MudTd DataLabel="Instance" Class="c-760">@context.Instance</MudTd>
            <MudTd DataLabel="Database"><b>@context.Name</b><span class="cell-sub n-560">@context.Instance on @context.VmName</span></MudTd>
            <MudTd DataLabel="Recovery" Class="c-950">@(context.RecoveryModel ?? "–")</MudTd>
            <MudTd DataLabel="Log chain">
                <MudTooltip Text="@(context.ChainReason ?? ChainText(context.ChainState))">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ChainColor(context.ChainState)" Icon="@ChainIcon(context.ChainState)">@ChainLabel(context.ChainState)</MudChip>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Last log backup" Class="c-560 nowrap">@Fmt.Time(context.LastLogUtc)</MudTd>
            <MudTd DataLabel="Last full backup" Class="c-1100 nowrap">@Fmt.Time(context.LastFullUtc)</MudTd>
            <MudTd DataLabel="Restorable" Class="c-950">@(context.CoveredFromUtc is { } from ? $"{Fmt.Time(from)} – {Fmt.Time(context.CoveredToUtc)}" : "–")</MudTd>
        </RowTemplate>
    </MudTable>
    </div>
}

@code {
    private List<SqlCatalogDatabaseDto>? _databases;
    private string? _error;
    private string _filter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _databases = await Api.GetAsync<List<SqlCatalogDatabaseDto>>("api/sql/databases");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private IEnumerable<SqlCatalogDatabaseDto> Filtered() =>
        (_databases ?? []).Where(d => _filter.Length == 0
            || $"{d.VmName} {d.Instance} {d.Name}".Contains(_filter, StringComparison.OrdinalIgnoreCase));

    internal static string ChainLabel(string state) => state switch
    {
        "Ok" => "intact",
        "NoBase" => "no full backup",
        "Broken" => "broken",
        "Simple" => "SIMPLE",
        _ => "not checked yet",
    };

    internal static string ChainText(string state) => state switch
    {
        "Ok" => "A full backup and an unbroken chain of log backups since then.",
        "Simple" => "SIMPLE recovery: no log backups; restorable to the times of its full backups only.",
        _ => "No SQL Server backup run has checked the chain yet (new database, or a repository just imported); the next run does.",
    };

    internal static string ChainIcon(string state) => state switch
    {
        "Ok" => Icons.Material.Filled.Link,
        "Broken" => Icons.Material.Filled.LinkOff,
        "NoBase" => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.HelpOutline,
    };

    internal static Color ChainColor(string state) => state switch
    {
        "Ok" => Color.Success,
        "Broken" or "NoBase" => Color.Warning,
        _ => Color.Default,
    };
}
